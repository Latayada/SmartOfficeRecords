@{
    ViewBag.Title = "Request Management";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Request Management - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        /* ========================================
                   GLOBAL
                ======================================== */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f5f5f5;
            overflow: hidden;
        }


        /* ========================================
                   MAIN CONTAINER
                ======================================== */

        .dashboard-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }


        /* =========================================================
                           SIDEBAR
                        ========================================================= */

        .sidebar {
            width: 158px;
            min-width: 158px;
            height: 100vh;
            background: #1F2933;
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            transition: all .3s ease;
            overflow-y: auto;
            overflow-x: hidden;
        }


        /* Scrollbar */

        .sidebar {
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.25) transparent;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.25);
                border-radius: 10px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: transparent;
            }


            /* =========================================================
                           COLLAPSED SIDEBAR
                        ========================================================= */

            .sidebar.collapsed {
                width: 78px;
                min-width: 78px;
            }

                .sidebar.collapsed .system-name {
                    display: block;
                    font-size: 10px;
                    font-weight: 600;
                    margin-top: 8px;
                }

                .sidebar.collapsed .logo-circle {
                    width: 42px;
                    height: 42px;
                }

                .sidebar.collapsed .logo-section {
                    padding: 18px 10px;
                }

                .sidebar.collapsed .menu a span,
                .sidebar.collapsed .logout a span {
                    display: none;
                }

                .sidebar.collapsed .menu {
                    padding: 15px 10px;
                }

                    .sidebar.collapsed .menu a {
                        width: 42px;
                        height: 42px;
                        margin: 0 auto 10px auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        border-radius: 6px;
                    }

                        .sidebar.collapsed .menu a.active {
                            background: #B91C1C;
                            box-shadow: 0 4px 10px rgba(0,0,0,.15);
                        }

                        .sidebar.collapsed .menu a i,
                        .sidebar.collapsed .logout a i {
                            margin: 0;
                        }

                .sidebar.collapsed .logout {
                    padding-bottom: 15px;
                }

                    .sidebar.collapsed .logout a {
                        width: 42px;
                        height: 42px;
                        margin: 0 auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }

                .sidebar.collapsed .small-arrow {
                    display: none;
                }


        /* =========================================================
                           LOGO SECTION
                        ========================================================= */

        .logo-section {
            text-align: center;
            padding: 16px 10px;
            border-bottom: 1px solid rgba(255,255,255,.18);
        }

        .logo-circle {
            width: 40px;
            height: 40px;
            background: #FFFFFF;
            border-radius: 50%;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .system-name {
            margin-top: 8px;
            font-size: 12px;
            font-weight: 600;
            color: #FFFFFF;
        }


        /* =========================================================
                           MENU
                        ========================================================= */

        .menu {
            padding: 14px 8px;
        }

            .menu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                margin-bottom: 3px;
                border-radius: 5px;
                font-size: 11px;
                font-weight: 500;
                transition: all .2s ease;
            }

                .menu a i {
                    font-size: 14px;
                    min-width: 14px;
                }

                .menu a:hover {
                    background: rgba(185, 28, 28, .18);
                    color: #FFFFFF;
                }

                .menu a.active {
                    background: #B91C1C;
                    color: #FFFFFF;
                    box-shadow: 0 3px 8px rgba(185,28,28,.22);
                }


        /* =========================================================
                           SETTINGS DROPDOWN
                        ========================================================= */

        .sidebar-dropdown {
            margin-bottom: 3px;
        }

        .dropdown-toggle-menu {
            color: #FFFFFF;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 500;
            transition: all .2s ease;
        }

            .dropdown-toggle-menu:hover {
                background: rgba(185,28,28,.18);
                color: #FFFFFF;
            }

        .small-arrow {
            font-size: 8px;
            transition: transform .3s ease;
        }

        .dropdown-submenu {
            display: none;
            flex-direction: column;
            padding-left: 14px;
            margin-top: 3px;
        }

            .dropdown-submenu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 7px 9px;
                font-size: 10px;
                border-radius: 5px;
            }

                .dropdown-submenu a:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }

        .sidebar-dropdown.open .dropdown-submenu {
            display: flex;
        }

        .sidebar-dropdown.open .small-arrow {
            transform: rotate(180deg);
        }


        /* =========================================================
                           LOGOUT
                        ========================================================= */

        .logout {
            margin-top: auto;
            padding: 10px 8px 12px 8px;
        }

            .logout a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                gap: 10px;
                align-items: center;
                padding: 8px 10px;
                font-size: 11px;
                font-weight: 500;
                border-radius: 5px;
                transition: all .2s ease;
            }

                .logout a:hover {
                    background: rgba(185,28,28,.18);
                }


        /* =========================================================
                           MAIN CONTENT
                        ========================================================= */

        .main-content {
            flex: 1;
            background: #F5F6F8;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }


        /* =========================================================
                           TOPBAR
                        ========================================================= */

        .topbar {
            height: 52px;
            min-height: 52px;
            flex-shrink: 0;
            border-bottom: 1px solid #E5E7EB;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 16px;
            background: #FFFFFF;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .menu-toggle {
            background: none;
            border: none;
            color: #B91C1C;
            font-size: 16px;
            cursor: pointer;
            padding: 4px;
        }


        /* =========================================================
                           TOPBAR RIGHT
                        ========================================================= */

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-left: auto;
        }

        .notification-icon {
            font-size: 17px;
            color: #374151;
            cursor: pointer;
            transition: color .2s ease;
        }

            .notification-icon:hover {
                color: #B91C1C;
            }


        /* =========================================================
                           PROFILE
                        ========================================================= */

        .profile {
            display: flex;
            align-items: center;
            gap: 7px;
            padding-left: 8px;
            border-left: 1px solid #E5E7EB;
        }

            .profile img {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                object-fit: cover;
            }

        .profile-info {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

            .profile-info h5 {
                margin: 0;
                font-size: 10px;
                font-weight: 600;
                color: #111827;
            }

            .profile-info span {
                font-size: 8px;
                color: #6B7280;
            }

        .profile-arrow {
            color: #6B7280;
            font-size: 9px;
            margin-left: 2px;
        }


        /* ========================================
                   CONTENT AREA
                ======================================== */

        .content-area {
            flex: 1;
            padding: 18px 28px;
            overflow-y: auto;
            overflow-x: hidden;
        }


        /* ========================================
                   PAGE TITLE
                ======================================== */

        .page-title {
            font-size: 19px;
            font-weight: 700;
            color: #E32626;
            margin-bottom: 2px;
        }

        .page-subtitle {
            font-size: 10px;
            font-weight: 500;
            color: #64748B;
            margin-bottom: 25px;
        }


        /* ========================================
                   ACTION BAR
                ======================================== */

        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            gap: 15px;
        }

        .search-filter {
            display: flex;
            gap: 12px;
            flex: 1;
        }

        .search-box {
            flex: 1;
            position: relative;
            max-width: 535px;
        }

            .search-box i {
                position: absolute;
                top: 50%;
                left: 13px;
                transform: translateY(-50%);
                color: #8B929A;
                font-size: 13px;
            }

            .search-box input {
                width: 100%;
                height: 38px;
                border: 1px solid #E2E5E8;
                border-radius: 18px;
                padding-left: 35px;
                padding-right: 15px;
                font-size: 11px;
                outline: none;
                background: #ffffff;
                box-shadow: 0 3px 12px rgba(0,0,0,.06);
                transition: .2s ease;
            }

                .search-box input:focus {
                    border-color: #C91C1C;
                    box-shadow: 0 0 0 3px rgba(201,28,28,.08);
                }

                .search-box input::placeholder {
                    color: #9CA3AF;
                }


        /* ========================================
                   STATUS FILTER
                ======================================== */

        .status-filter {
            width: 205px;
            height: 38px;
            border: 1px solid #D1D5DB;
            border-radius: 6px;
            padding: 0 12px;
            font-size: 11px;
            font-weight: 500;
            outline: none;
            background: white;
            color: #374151;
        }

            .status-filter:focus {
                border-color: #C91C1C;
            }


        /* ========================================
                   CREATE REQUEST BUTTON
                ======================================== */

        .create-btn {
            background: #E32626;
            border: none;
            color: white;
            height: 38px;
            padding: 0 16px;
            border-radius: 5px;
            font-weight: 600;
            font-size: 11px;
            transition: all .2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
            white-space: nowrap;
        }

            .create-btn i {
                font-size: 17px;
            }

            .create-btn:hover {
                background: #B91C1C;
                color: white;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(201,28,28,.25);
            }

            .create-btn:active {
                transform: translateY(0);
            }


        /* ========================================
                   TABLE CONTAINER
                ======================================== */

        .table-container {
            background: white;
            border-radius: 6px;
            overflow: hidden;
            border: 1px solid #E1E1E1;
            box-shadow: 0 1px 5px rgba(0,0,0,.02);
        }

        .table {
            margin-bottom: 0;
            width: 100%;
        }


            /* TABLE HEADER */

            .table thead {
                background: #D9D9D9;
            }

                .table thead th {
                    padding: 11px 12px;
                    font-size: 11px;
                    font-weight: 700;
                    color: #20242A;
                    border-bottom: 1px solid #CCCCCC;
                    white-space: nowrap;
                }


            /* TABLE BODY */

            .table tbody td {
                padding: 11px 12px;
                vertical-align: middle;
                font-size: 10px;
                color: #374151;
                border-bottom: 1px solid #E5E7EB;
                white-space: nowrap;
            }

            .table tbody tr:last-child td {
                border-bottom: none;
            }

            .table tbody tr:hover {
                background: #FAFAFA;
            }


        /* ========================================
                   ACTION ICONS
                ======================================== */

        .action-icons {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 15px;
        }

            .action-icons i {
                cursor: pointer;
                transition: .2s ease;
            }

            .action-icons .bi-eye {
                color: #8B5CF6;
            }

            .action-icons .bi-pencil {
                color: #E32626;
            }

            .action-icons .bi-eye:hover {
                color: #6D28D9;
                transform: scale(1.1);
            }

            .action-icons .bi-pencil:hover {
                color: #B91C1C;
                transform: scale(1.1);
            }


        /* ========================================
                   PAGINATION
                ======================================== */

        .pagination-section {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            margin-top: 22px;
        }

            .pagination-section > i {
                font-size: 12px;
                color: #555555;
                cursor: pointer;
            }

        .page-number {
            width: 28px;
            height: 28px;
            border-radius: 5px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            color: #555555;
        }

            .page-number:hover {
                background: #F3F4F6;
            }

        .active-page {
            background: #E32626;
            color: white;
        }

            .active-page:hover {
                background: #B91C1C;
                color: white;
            }


        /* ========================================
                   RESPONSIVE
                ======================================== */

        @@media (max-width: 900px) {

            .sidebar {
                width: 170px;
            }

            .content-area {
                padding: 18px;
            }

            .action-bar {
                flex-wrap: wrap;
            }

            .search-filter {
                width: 100%;
            }

            .create-btn {
                margin-left: auto;
            }

            .table-container {
                overflow-x: auto;
            }

            .table {
                min-width: 850px;
            }
        }

    </style>

</head>

