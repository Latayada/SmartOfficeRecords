@{
    ViewBag.Title = "Admin Settings";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Settings</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet" />

    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html,
        body {
            width: 100%;
            height: 100%;
        }

        body {
            background: #F7F7F8;
            color: #222222;
            overflow: hidden;
        }


        /* =========================================================
                   SETTINGS PAGE
                ========================================================= */

        .settings-container {
            width: 100%;
            height: 100vh;
            background: #F7F7F8;
        }

        .settings-page {
            width: 100%;
            height: 100vh;
            display: flex;
            overflow: hidden;
        }


        /* =========================================================
                   SIDEBAR
                ========================================================= */

        .settings-sidebar {
            width: 190px;
            min-width: 190px;
            height: 100vh;
            background: #FFFFFF;
            border-right: 1px solid #E5E7EB;
            padding: 16px 12px;
        }


        /* =========================================================
                   BACK BUTTON
                ========================================================= */

        .settings-back {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: #374151;
            font-size: 15px;
            font-weight: 600;
            padding: 0 5px;
            margin-bottom: 28px;
            width: fit-content;
        }

            .settings-back i {
                font-size: 18px;
            }

            .settings-back:hover {
                color: #D92D2D;
            }


        /* =========================================================
                   PROFILE
                ========================================================= */

        .settings-profile {
            padding: 0 6px 20px 6px;
            border-bottom: 1px solid #E5E7EB;
            margin-bottom: 16px;
        }

        .settings-profile-img {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            object-fit: cover;
            display: block;
            margin-bottom: 10px;
            border: 1px solid #E5E7EB;
        }

        .settings-profile-info {
            display: flex;
            flex-direction: column;
            min-width: 0;
        }

        .settings-profile-email {
            font-size: 11px;
            font-weight: 600;
            color: #374151;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .settings-profile-role {
            font-size: 10px;
            color: #9CA3AF;
            margin-top: 5px;
        }


        /* =========================================================
                   NAVIGATION
                ========================================================= */

        .settings-nav {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .settings-menu {
            width: 100%;
            min-height: 42px;
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 0 12px;
            border: none;
            background: transparent;
            color: #4B5563;
            font-size: 13px;
            font-weight: 500;
            border-radius: 6px;
            cursor: pointer;
            transition: all .2s ease;
            text-align: left;
        }

            .settings-menu i {
                width: 18px;
                text-align: center;
                font-size: 18px;
            }

            .settings-menu:hover {
                background: #FFF1F1;
                color: #D92D2D;
            }

            .settings-menu.active {
                background: #FFF1F1;
                color: #D92D2D;
                font-weight: 600;
            }


        /* =========================================================
                   MAIN
                ========================================================= */

        .settings-main {
            flex: 1;
            height: 100vh;
            background: #F7F7F8;
            padding: 0 30px 30px 30px;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .settings-content {
            width: 100%;
            max-width: 1120px;
        }


        /* =========================================================
                   SEARCH
                ========================================================= */

        .settings-top {
            height: 62px;
            display: flex;
            align-items: center;
            margin-bottom: 8px;
        }

        .settings-search {
            width: 570px;
            max-width: 100%;
            height: 40px;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 22px;
            box-shadow: 0 3px 12px rgba(0,0,0,.08);
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 15px;
        }

            .settings-search i {
                font-size: 15px;
                color: #9CA3AF;
            }

            .settings-search input {
                width: 100%;
                height: 100%;
                border: none;
                outline: none;
                background: transparent;
                font-size: 13px;
                color: #374151;
            }

                .settings-search input::placeholder {
                    color: #9CA3AF;
                }


        /* =========================================================
                   SECTIONS
                ========================================================= */

        .settings-section {
            display: none;
        }

            .settings-section.active-section {
                display: block;
            }


        /* =========================================================
                   HEADINGS
                ========================================================= */

        .settings-heading {
            margin-bottom: 22px;
        }

            .settings-heading h1 {
                font-size: 26px;
                font-weight: 700;
                color: #292D32;
                margin-bottom: 5px;
            }

            .settings-heading p {
                font-size: 12px;
                font-weight: 500;
                color: #6B7280;
                margin: 0;
            }


        /* =========================================================
                   GENERAL CARDS
                ========================================================= */

        .settings-card,
        .notification-card,
        .profile-card,
        .security-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #DDE1E6;
            border-radius: 9px;
            overflow: hidden;
            box-shadow: 0 1px 2px rgba(0,0,0,.02);
        }


        /* =========================================================
                   SYSTEM
                ========================================================= */

        .system-row {
            min-height: 72px;
            padding: 0 24px 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            border-bottom: 1px solid #E5E7EB;
        }

            .system-row:last-child {
                border-bottom: none;
            }

        .system-label-text {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .system-label-text strong {
                font-size: 13px;
                font-weight: 600;
                color: #3F454D;
            }

            .system-label-text span {
                font-size: 11px;
                color: #6B7280;
            }

        .settings-select {
            width: 210px;
            height: 38px;
            border: 1px solid #D1D5DB;
            border-radius: 7px;
            background: #FFFFFF;
            padding: 0 11px;
            font-size: 12px;
            color: #374151;
            outline: none;
        }

            .settings-select:focus {
                border-color: #D92D2D;
            }


        /* =========================================================
                   DANGER ZONE
                ========================================================= */

        .danger-section {
            margin-top: 26px;
        }

        .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #30343B;
            margin-bottom: 12px;
        }

        .danger-row {
            min-height: 90px;
            padding: 18px 26px 18px 22px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            border-bottom: 1px solid #E5E7EB;
        }

            .danger-row:last-child {
                border-bottom: none;
            }

        .danger-info {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .danger-info strong {
                font-size: 13px;
                font-weight: 600;
                color: #C62828;
            }

            .danger-info span {
                font-size: 11px;
                color: #6B7280;
                line-height: 1.5;
            }

        .danger-button {
            min-width: 145px;
            height: 38px;
            background: #FFFFFF;
            border: 1px solid #F08A8A;
            border-radius: 7px;
            color: #C62828;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
            transition: .2s ease;
            white-space: nowrap;
        }

            .danger-button:hover {
                background: #D92D2D;
                border-color: #D92D2D;
                color: #FFFFFF;
            }


        /* =========================================================
                   PROFILE SECTION
                ========================================================= */

        .profile-card {
            padding: 28px;
            margin-bottom: 16px;
        }

        .profile-image-area {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 24px;
        }

        .large-profile-wrapper {
            position: relative;
            width: 74px;
            height: 74px;
        }

        .large-profile-img {
            width: 74px;
            height: 74px;
            object-fit: cover;
            border-radius: 50%;
            border: 1px solid #DDE1E6;
        }

        .camera-icon {
            position: absolute;
            right: -3px;
            bottom: 0;
            width: 24px;
            height: 24px;
            background: #E62E2E;
            border-radius: 50%;
            color: #FFFFFF;
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .profile-buttons {
            display: flex;
            gap: 9px;
        }

        .upload-button {
            height: 32px;
            padding: 0 16px;
            border: none;
            border-radius: 6px;
            background: #E62E2E;
            color: #FFFFFF;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }

        .delete-image-button {
            height: 32px;
            padding: 0 16px;
            border: none;
            border-radius: 6px;
            background: #E5E7EB;
            color: #4B5563;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }

        .profile-form {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

            .form-group label {
                font-size: 11px;
                font-weight: 600;
                color: #4B5563;
            }

            .form-group input {
                width: 100%;
                height: 38px;
                border: 1px solid #DDE1E6;
                border-radius: 7px;
                padding: 0 11px;
                outline: none;
                font-size: 12px;
                color: #374151;
            }

                .form-group input:focus {
                    border-color: #D92D2D;
                }

        .profile-save-area {
            display: flex;
            justify-content: flex-end;
            margin-top: 24px;
        }


        /* =========================================================
                   SECURITY
                ========================================================= */

        .security-row {
            min-height: 68px;
            padding: 0 26px 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border-bottom: 1px solid #E5E7EB;
        }

            .security-row:last-child {
                border-bottom: none;
            }

        .security-info {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .security-info strong {
                font-size: 13px;
                font-weight: 600;
                color: #3F454D;
            }

            .security-info span {
                font-size: 11px;
                color: #6B7280;
            }

        .change-password-button {
            min-width: 145px;
            height: 38px;
            background: #FFFFFF;
            border: 1px solid #DDE1E6;
            border-radius: 7px;
            color: #3F454D;
            font-size: 12px;
            cursor: pointer;
        }

        .enabled-badge {
            min-width: 92px;
            height: 32px;
            background: #E4F5EC;
            border-radius: 7px;
            color: #3D8B63;
            font-size: 11px;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }


        /* =========================================================
                   NOTIFICATIONS
                ========================================================= */

        .notification-row {
            min-height: 66px;
            padding: 0 26px 0 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 25px;
            border-bottom: 1px solid #E5E7EB;
        }

            .notification-row:last-child {
                border-bottom: none;
            }

        .notification-info {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .notification-info strong {
                font-size: 13px;
                font-weight: 600;
                color: #3F454D;
            }

            .notification-info span {
                font-size: 11px;
                color: #6B7280;
                line-height: 1.4;
            }


        /* =========================================================
                   TOGGLE SWITCH
                ========================================================= */

        .switch {
            position: relative;
            display: inline-block;
            width: 36px;
            height: 20px;
            flex-shrink: 0;
        }

            .switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            cursor: pointer;
            inset: 0;
            background: #D1D5DB;
            border-radius: 20px;
            transition: .25s ease;
        }

            .slider:before {
                position: absolute;
                content: "";
                width: 16px;
                height: 16px;
                left: 2px;
                bottom: 2px;
                background: #FFFFFF;
                border-radius: 50%;
                box-shadow: 0 1px 3px rgba(0,0,0,.15);
                transition: .25s ease;
            }

        .switch input:checked + .slider {
            background: #D92D2D;
        }

            .switch input:checked + .slider:before {
                transform: translateX(16px);
            }


        /* =========================================================
                   NOTIFICATION ACTIONS
                ========================================================= */

        .notification-section {
            margin-top: 26px;
        }

        .notification-actions {
            display: flex;
            justify-content: flex-end;
            gap: 12px;
            margin-top: 22px;
            padding-bottom: 30px;
        }

        .reset-button {
            min-width: 150px;
            height: 42px;
            border: 1px solid #DDE1E6;
            border-radius: 7px;
            background: #FFFFFF;
            color: #3F454D;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        .save-button {
            min-width: 150px;
            height: 42px;
            border: none;
            border-radius: 7px;
            background: #E62E2E;
            color: #FFFFFF;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: .2s ease;
        }

            .save-button:hover,
            .upload-button:hover {
                background: #C62828;
            }


        /* =========================================================
                   SCROLLBAR
                ========================================================= */

        .settings-main {
            scrollbar-width: thin;
            scrollbar-color: #C9CDD3 transparent;
        }

            .settings-main::-webkit-scrollbar {
                width: 6px;
            }

            .settings-main::-webkit-scrollbar-thumb {
                background: #C9CDD3;
                border-radius: 10px;
            }

            .settings-main::-webkit-scrollbar-track {
                background: transparent;
            }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 800px) {

            .settings-sidebar {
                width: 170px;
                min-width: 170px;
            }

            .settings-main {
                padding-left: 20px;
                padding-right: 20px;
            }
        }


        @@media (max-width: 700px) {

            body {
                overflow-y: auto;
            }

            .settings-page {
                height: auto;
                min-height: 100vh;
                flex-direction: column;
            }

            .settings-sidebar {
                width: 100%;
                min-width: 100%;
                height: auto;
                border-right: none;
                border-bottom: 1px solid #E5E7EB;
            }

            .settings-nav {
                flex-direction: row;
            }

            .settings-menu {
                justify-content: center;
            }

            .settings-main {
                height: auto;
                min-height: 100vh;
                overflow: visible;
                padding: 20px;
            }

            .profile-form {
                grid-template-columns: 1fr;
            }

            .settings-search {
                width: 100%;
            }
        }


        @@media (max-width: 500px) {

            .settings-nav {
                flex-direction: column;
            }

            .system-row,
            .security-row,
            .notification-row,
            .danger-row {
                flex-direction: column;
                align-items: flex-start;
                justify-content: center;
                padding: 18px;
                gap: 12px;
            }

            .settings-select,
            .danger-button,
            .change-password-button {
                width: 100%;
            }

            .profile-image-area {
                flex-direction: column;
                align-items: flex-start;
            }

            .notification-actions {
                flex-direction: column;
            }

            .reset-button,
            .save-button {
                width: 100%;
            }
        }

    </style>

</head>

<body>

    <div class="settings-container">

        <div class="settings-page">

            <!-- =====================================================
                 SIDEBAR
            ====================================================== -->

            <aside class="settings-sidebar">

                <a href="@Url.Action("Dashboard", "Admin")"
                   class="settings-back">

                    <i class="bi bi-arrow-left"></i>

                    <span>Settings</span>

                </a>


                <!-- PROFILE -->

                <div class="settings-profile">

                    <img src="~/Images/adminpic.jpg"
                         class="settings-profile-img"
                         alt="Profile" />

                    <div class="settings-profile-info">

                        <span class="settings-profile-email">
                            smart.officerecords@gmail.com
                        </span>

                        <span class="settings-profile-role">
                            Administrator
                        </span>

                    </div>

                </div>


                <!-- NAVIGATION -->

                <nav class="settings-nav">

                    <button type="button"
                            class="settings-menu active"
                            data-section="systemSection">

                        <i class="bi bi-display"></i>

                        <span>System</span>

                    </button>


                    <button type="button"
                            class="settings-menu"
                            data-section="profileSection">

                        <i class="bi bi-person"></i>

                        <span>Profile</span>

                    </button>


                    <button type="button"
                            class="settings-menu"
                            data-section="notificationSection">

                        <i class="bi bi-bell"></i>

                        <span>Notifications</span>

                    </button>

                </nav>

            </aside>


            <!-- =====================================================
                 MAIN CONTENT
            ====================================================== -->

            <main class="settings-main">

                <!-- SEARCH -->

                <div class="settings-top">

                    <div class="settings-search">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Find Settings..." />

                    </div>

                </div>


                <div class="settings-content">


                    <!-- =================================================
                         SYSTEM SECTION
                    ================================================== -->

                    <section id="systemSection"
                             class="settings-section active-section">

                        <div class="settings-heading">

                            <h1>System</h1>

                            <p>
                                Manage your profile, security and system preferences.
                            </p>

                        </div>


                        <div class="settings-card">

                            <div class="system-row">

                                <div class="system-label-text">

                                    <strong>Time Zone</strong>

                                </div>

                                <select class="settings-select">

                                    <option selected>
                                        Asia/Manila (GMT+8)
                                    </option>

                                    <option>
                                        Asia/Tokyo (GMT+9)
                                    </option>

                                    <option>
                                        Asia/Singapore (GMT+8)
                                    </option>

                                    <option>
                                        UTC
                                    </option>

                                </select>

                            </div>


                            <div class="system-row">

                                <div class="system-label-text">

                                    <strong>Date Format</strong>

                                </div>

                                <select class="settings-select">

                                    <option selected>
                                        MM/DD/YYYY
                                    </option>

                                    <option>
                                        DD/MM/YYYY
                                    </option>

                                    <option>
                                        YYYY-MM-DD
                                    </option>

                                </select>

                            </div>


                            <div class="system-row">

                                <div class="system-label-text">

                                    <strong>Default Language</strong>

                                </div>

                                <select class="settings-select">

                                    <option selected>
                                        English
                                    </option>

                                    <option>
                                        Filipino
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- DANGER ZONE -->

                        <div class="danger-section">

                            <h2 class="section-title">
                                Danger Zone
                            </h2>


                            <div class="settings-card">

                                <div class="danger-row">

                                    <div class="danger-info">

                                        <strong>
                                            Sign out all devices
                                        </strong>

                                        <span>
                                            Ends every active session except this one. You'll need to sign back in on other devices.
                                        </span>

                                    </div>

                                    <button type="button"
                                            class="danger-button"
                                            id="signOutButton">

                                        Sign out everywhere

                                    </button>

                                </div>


                                <div class="danger-row">

                                    <div class="danger-info">

                                        <strong>
                                            Delete Account
                                        </strong>

                                        <span>
                                            Permanently removes your access and profile. This can't be undone.
                                        </span>

                                    </div>

                                    <button type="button"
                                            class="danger-button"
                                            id="deleteAccountButton">

                                        Delete Account

                                    </button>

                                </div>

                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         PROFILE SECTION
                    ================================================== -->

                    <section id="profileSection"
                             class="settings-section">

                        <div class="settings-heading">

                            <h1>Profile</h1>

                            <p>
                                Manage your profile, security and system preferences.
                            </p>

                        </div>


                        <div class="profile-card">

                            <div class="profile-image-area">

                                <div class="large-profile-wrapper">

                                    <img src="~/Images/adminpic.jpg"
                                         class="large-profile-img"
                                         id="profilePreview"
                                         alt="Profile" />

                                    <div class="camera-icon">

                                        <i class="bi bi-camera"></i>

                                    </div>

                                </div>


                                <div class="profile-buttons">

                                    <input type="file"
                                           id="profileUpload"
                                           accept="image/*"
                                           hidden />

                                    <button type="button"
                                            class="upload-button"
                                            id="uploadButton">

                                        Upload New

                                    </button>


                                    <button type="button"
                                            class="delete-image-button"
                                            id="deleteImageButton">

                                        Delete

                                    </button>

                                </div>

                            </div>


                            <!-- PROFILE FORM -->

                            <div class="profile-form">

                                <div class="form-group">

                                    <label>
                                        Firstname
                                    </label>

                                    <input type="text"
                                           value="Jane" />

                                </div>


                                <div class="form-group">

                                    <label>
                                        Lastname
                                    </label>

                                    <input type="text"
                                           value="Doe" />

                                </div>


                                <div class="form-group">

                                    <label>
                                        Email
                                    </label>

                                    <input type="email"
                                           value="smart.officeRecords@gmail.com" />

                                </div>


                                <div class="form-group">

                                    <label>
                                        Contact Number
                                    </label>

                                    <input type="text"
                                           value="+1 (555) 902-1234" />

                                </div>

                            </div>


                            <div class="profile-save-area">

                                <button type="button"
                                        class="save-button"
                                        id="profileSaveButton">

                                    Save Changes

                                </button>

                            </div>

                        </div>


                        <!-- SECURITY -->

                        <div class="security-card">

                            <div class="security-row">

                                <div class="security-info">

                                    <strong>
                                        Password
                                    </strong>

                                    <span>
                                        Last changed last 3 months ago.
                                    </span>

                                </div>


                                <button type="button"
                                        class="change-password-button"
                                        id="changePasswordButton">

                                    Change Password

                                </button>

                            </div>


                            <div class="security-row">

                                <div class="security-info">

                                    <strong>
                                        Two factor authentication
                                    </strong>

                                    <span>
                                        Add an extra step when signing in from a new device.
                                    </span>

                                </div>


                                <div class="enabled-badge">

                                    <i class="bi bi-check-lg"></i>

                                    Enabled

                                </div>

                            </div>

                        </div>

                    </section>


                    <!-- =================================================
                         NOTIFICATIONS SECTION
                    ================================================== -->

                    <section id="notificationSection"
                             class="settings-section">

                        <div class="settings-heading">

                            <h1>Notifications</h1>

                            <p>
                                Choose how and when you want to hear from the system.
                            </p>

                        </div>


                        <!-- NOTIFICATION TYPES -->

                        <div class="notification-card">

                            <div class="notification-row">

                                <div class="notification-info">

                                    <strong>
                                        Email Notifications
                                    </strong>

                                    <span>
                                        Receives updates from smart.officeRecords@gmail.com.
                                    </span>

                                </div>


                                <label class="switch">

                                    <input type="checkbox"
                                           id="emailNotification"
                                           checked />

                                    <span class="slider"></span>

                                </label>

                            </div>


                            <div class="notification-row">

                                <div class="notification-info">

                                    <strong>
                                        Push Notifications
                                    </strong>

                                    <span>
                                        Get alerts on this device while you're signed in.
                                    </span>

                                </div>


                                <label class="switch">

                                    <input type="checkbox"
                                           id="pushNotification" />

                                    <span class="slider"></span>

                                </label>

                            </div>


                            <div class="notification-row">

                                <div class="notification-info">

                                    <strong>
                                        SMS Notifications
                                    </strong>

                                    <span>
                                        Text alerts for urgent, time-sensitive events only.
                                    </span>

                                </div>


                                <label class="switch">

                                    <input type="checkbox"
                                           id="smsNotification"
                                           checked />

                                    <span class="slider"></span>

                                </label>

                            </div>

                        </div>


                        <!-- WHAT YOU ARE NOTIFIED ABOUT -->

                        <div class="notification-section">

                            <h2 class="section-title">
                                What you're notified about?
                            </h2>


                            <div class="notification-card">

                                <div class="notification-row">

                                    <div class="notification-info">

                                        <strong>
                                            New Records Added
                                        </strong>

                                        <span>
                                            When a staff member creates or uploads a new record.
                                        </span>

                                    </div>


                                    <label class="switch">

                                        <input type="checkbox"
                                               id="newRecords"
                                               checked />

                                        <span class="slider"></span>

                                    </label>

                                </div>


                                <div class="notification-row">

                                    <div class="notification-info">

                                        <strong>
                                            Security Alerts
                                        </strong>

                                        <span>
                                            Sign-ins from a new device or location, password changes.
                                        </span>

                                    </div>


                                    <label class="switch">

                                        <input type="checkbox"
                                               id="securityAlerts" />

                                        <span class="slider"></span>

                                    </label>

                                </div>


                                <div class="notification-row">

                                    <div class="notification-info">

                                        <strong>
                                            System Updates
                                        </strong>

                                        <span>
                                            Maintenance windows, downtime and new features.
                                        </span>

                                    </div>


                                    <label class="switch">

                                        <input type="checkbox"
                                               id="systemUpdates"
                                               checked />

                                        <span class="slider"></span>

                                    </label>

                                </div>


                                <div class="notification-row">

                                    <div class="notification-info">

                                        <strong>
                                            Weekly Summary
                                        </strong>

                                        <span>
                                            A digest of activity across the workspace every Monday.
                                        </span>

                                    </div>


                                    <label class="switch">

                                        <input type="checkbox"
                                               id="weeklySummary"
                                               checked />

                                        <span class="slider"></span>

                                    </label>

                                </div>

                            </div>


                            <!-- BUTTONS -->

                            <div class="notification-actions">

                                <button type="button"
                                        class="reset-button"
                                        id="resetButton">

                                    Reset Default

                                </button>


                                <button type="button"
                                        class="save-button"
                                        id="notificationSaveButton">

                                    Save Changes

                                </button>

                            </div>

                        </div>

                    </section>

                </div>

            </main>

        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>

        /* =========================================================
           CHANGE SETTINGS SECTION
        ========================================================== */

        const settingsMenus =
            document.querySelectorAll(".settings-menu");

        const settingsSections =
            document.querySelectorAll(".settings-section");


        settingsMenus.forEach(function (menu) {

            menu.addEventListener("click", function () {

                settingsMenus.forEach(function (item) {

                    item.classList.remove("active");

                });


                settingsSections.forEach(function (section) {

                    section.classList.remove("active-section");

                });


                this.classList.add("active");


                const selectedSection =
                    this.getAttribute("data-section");


                document
                    .getElementById(selectedSection)
                    .classList.add("active-section");


                document
                    .querySelector(".settings-main")
                    .scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });

            });

        });


        /* =========================================================
           PROFILE IMAGE UPLOAD
        ========================================================== */

        const uploadButton =
            document.getElementById("uploadButton");

        const profileUpload =
            document.getElementById("profileUpload");

        const profilePreview =
            document.getElementById("profilePreview");


        uploadButton.addEventListener("click", function () {

            profileUpload.click();

        });


        profileUpload.addEventListener("change", function () {

            const file = this.files[0];

            if (file) {

                const reader = new FileReader();

                reader.onload = function (event) {

                    profilePreview.src =
                        event.target.result;

                };

                reader.readAsDataURL(file);

            }

        });


        /* =========================================================
           DELETE PROFILE IMAGE
        ========================================================== */

        document
            .getElementById("deleteImageButton")
            .addEventListener("click", function () {

                profilePreview.src =
                    "/Images/adminpic.jpg";

            });


        /* =========================================================
           PROFILE SAVE
        ========================================================== */

        document
            .getElementById("profileSaveButton")
            .addEventListener("click", function () {

                alert(
                    "Profile changes have been saved successfully."
                );

            });


        /* =========================================================
           CHANGE PASSWORD
        ========================================================== */

        document
            .getElementById("changePasswordButton")
            .addEventListener("click", function () {

                alert(
                    "Change Password function will open here."
                );

            });


        /* =========================================================
           SIGN OUT ALL DEVICES
        ========================================================== */

        document
            .getElementById("signOutButton")
            .addEventListener("click", function () {

                const confirmLogout = confirm(
                    "Are you sure you want to sign out all other devices?"
                );

                if (confirmLogout) {

                    alert(
                        "All other active sessions have been signed out."
                    );

                }

            });


        /* =========================================================
           DELETE ACCOUNT
        ========================================================== */

        document
            .getElementById("deleteAccountButton")
            .addEventListener("click", function () {

                const confirmDelete = confirm(
                    "Are you sure you want to delete this account? This action cannot be undone."
                );

                if (confirmDelete) {

                    alert(
                        "Account deletion requires administrator confirmation."
                    );

                }

            });


        /* =========================================================
           RESET NOTIFICATIONS
        ========================================================== */

        document
            .getElementById("resetButton")
            .addEventListener("click", function () {

                const confirmReset = confirm(
                    "Reset all notification settings to default?"
                );

                if (confirmReset) {

                    document.getElementById(
                        "emailNotification"
                    ).checked = true;

                    document.getElementById(
                        "pushNotification"
                    ).checked = false;

                    document.getElementById(
                        "smsNotification"
                    ).checked = true;

                    document.getElementById(
                        "newRecords"
                    ).checked = true;

                    document.getElementById(
                        "securityAlerts"
                    ).checked = false;

                    document.getElementById(
                        "systemUpdates"
                    ).checked = true;

                    document.getElementById(
                        "weeklySummary"
                    ).checked = true;

                }

            });


        /* =========================================================
           SAVE NOTIFICATIONS
        ========================================================== */

        document
            .getElementById("notificationSaveButton")
            .addEventListener("click", function () {

                alert(
                    "Notification settings have been saved successfully."
                );

            });

    </script>

</body>
</html>