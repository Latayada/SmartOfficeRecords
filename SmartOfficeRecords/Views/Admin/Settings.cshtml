@{
    ViewBag.Title = "Admin Settings";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Admin Settings</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">


    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            height: 100%;
        }

        body {
            background: #FFFFFF;
            overflow: hidden;
            color: #111111;
        }


        /* =========================================================
                   FULL PAGE
                ========================================================= */

        .settings-container {
            width: 100%;
            height: 100vh;
            background: #FFFFFF;
            display: flex;
        }

        .settings-page {
            width: 100%;
            height: 100vh;
            background: #FFFFFF;
            display: flex;
            overflow: hidden;
        }


        /* =========================================================
                   LEFT SETTINGS PANEL
                ========================================================= */

        .settings-sidebar {
            width: 260px;
            min-width: 260px;
            height: 100vh;
            background: #FFFFFF;
            padding: 14px 18px;
            border-right: 1px solid #F0F0F0;
        }


        /* =========================================================
                   SYSTEM LABEL
                ========================================================= */

        .system-label {
            font-size: 13px;
            font-weight: 500;
            color: #B9B9B9;
            margin-bottom: 24px;
        }


        /* =========================================================
                   BACK BUTTON
                ========================================================= */

        .settings-back {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #111111;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 42px;
        }

            .settings-back i {
                font-size: 18px;
            }

            .settings-back:hover {
                color: #E3262E;
            }


        /* =========================================================
                   PROFILE
                ========================================================= */

        .settings-profile {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 3px 22px 3px;
            border-bottom: 1px solid #E5E5E5;
            margin-bottom: 22px;
        }

        .settings-profile-img {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            object-fit: cover;
            border: 2px solid #F4A340;
        }

        .settings-profile-info {
            display: flex;
            flex-direction: column;
            line-height: 1.3;
        }

        .settings-profile-email {
            font-size: 9px;
            font-weight: 500;
            color: #222222;
        }

        .settings-profile-role {
            font-size: 8px;
            color: #555555;
        }


        /* =========================================================
                   SETTINGS NAVIGATION
                ========================================================= */

        .settings-nav {
            display: flex;
            flex-direction: column;
            gap: 3px;
        }

            .settings-nav a {
                display: flex;
                align-items: center;
                gap: 12px;
                width: 100%;
                min-height: 38px;
                padding: 8px 6px;
                text-decoration: none;
                color: #222222;
                font-size: 13px;
                font-weight: 500;
                border-radius: 5px;
                transition: .2s ease;
            }

                .settings-nav a i {
                    width: 20px;
                    text-align: center;
                    font-size: 16px;
                }

                .settings-nav a:hover {
                    color: #E3262E;
                    background: #FFF5F5;
                }

                .settings-nav a.active {
                    color: #E3262E;
                    background: transparent;
                }


        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .settings-main {
            flex: 1;
            height: 100vh;
            background: #FFFFFF;
            padding: 16px 40px 35px 20px;
            overflow-y: auto;
            overflow-x: hidden;
        }


        /* =========================================================
                   SEARCH BAR
                ========================================================= */

        .settings-top {
            width: 100%;
            display: flex;
            justify-content: center;
            margin-bottom: 23px;
        }

        .settings-search {
            width: 630px;
            height: 38px;
            background: #FFFFFF;
            border-radius: 22px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, .08);
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 0 15px;
        }

            .settings-search i {
                font-size: 13px;
                color: #777777;
            }

            .settings-search input {
                width: 100%;
                height: 100%;
                border: none;
                outline: none;
                background: transparent;
                font-size: 11px;
                color: #333333;
            }

                .settings-search input::placeholder {
                    color: #858585;
                }


        /* =========================================================
                   SYSTEM HEADING
                ========================================================= */

        .settings-heading {
            margin-bottom: 23px;
        }

            .settings-heading h1 {
                font-size: 22px;
                font-weight: 500;
                color: #111111;
                margin-bottom: 1px;
            }

            .settings-heading p {
                font-size: 10px;
                font-weight: 500;
                color: #52617A;
                margin: 0;
            }


        /* =========================================================
                   SYSTEM CARD
                ========================================================= */

        .system-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #DFDFDF;
            border-radius: 7px;
            overflow: hidden;
        }


        /* =========================================================
                   SYSTEM ROW
                ========================================================= */

        .system-row {
            min-height: 68px;
            padding: 0 18px 0 33px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #E4E4E4;
        }

            .system-row:last-child {
                border-bottom: none;
            }


        /* =========================================================
                   SELECT
                ========================================================= */

        .settings-select {
            width: 194px;
            height: 38px;
            border: 1px solid #DFDFDF;
            border-radius: 4px;
            background: #FFFFFF;
            padding: 0 12px;
            font-size: 10px;
            font-weight: 400;
            color: #333333;
            outline: none;
        }

            .settings-select:focus {
                border-color: #E3262E;
                box-shadow: none;
            }


        /* =========================================================
                   SESSION TIMEOUT
                ========================================================= */

        .timeout-row {
            min-height: 65px;
        }

        .timeout-control {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .timeout-slider {
            width: 192px;
            height: 4px;
            appearance: none;
            -webkit-appearance: none;
            outline: none;
            border-radius: 10px;
            background: #D9D9D9;
        }

            .timeout-slider::-webkit-slider-runnable-track {
                height: 4px;
                border-radius: 10px;
                background: linear-gradient( to right, #E3262E 0%, #E3262E 70%, #D9D9D9 70%, #D9D9D9 100% );
            }

            .timeout-slider::-webkit-slider-thumb {
                appearance: none;
                -webkit-appearance: none;
                width: 10px;
                height: 10px;
                margin-top: -3px;
                border-radius: 50%;
                background: #E3262E;
                border: 1px solid #FFFFFF;
                box-shadow: 0 0 0 1px #E3262E;
                cursor: pointer;
            }

            .timeout-slider::-moz-range-track {
                height: 4px;
                border-radius: 10px;
                background: #D9D9D9;
            }

            .timeout-slider::-moz-range-progress {
                height: 4px;
                border-radius: 10px;
                background: #E3262E;
            }

            .timeout-slider::-moz-range-thumb {
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: #E3262E;
                border: 1px solid #FFFFFF;
                box-shadow: 0 0 0 1px #E3262E;
                cursor: pointer;
            }

        .timeout-value {
            min-width: 40px;
            font-size: 10px;
            font-weight: 500;
            color: #333333;
        }


        /* =========================================================
                   DANGER ZONE
                ========================================================= */

        .danger-section {
            margin-top: 29px;
        }

        .danger-title {
            font-size: 14px;
            font-weight: 600;
            color: #111111;
            margin-bottom: 10px;
        }

        .danger-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #DFDFDF;
            border-radius: 7px;
            overflow: hidden;
        }

        .danger-row {
            min-height: 96px;
            padding: 18px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border-bottom: 1px solid #E4E4E4;
        }

            .danger-row:last-child {
                border-bottom: none;
            }

        .danger-info {
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

            .danger-info strong {
                font-size: 12px;
                font-weight: 600;
                color: #E3262E;
            }

            .danger-info span {
                font-size: 9px;
                font-weight: 500;
                color: #52617A;
            }

        .danger-button {
            min-width: 140px;
            height: 37px;
            padding: 0 14px;
            background: #FFFFFF;
            border: 1px solid #FF6B70;
            border-radius: 4px;
            color: #E3262E;
            font-size: 10px;
            font-weight: 500;
            cursor: pointer;
            transition: .2s ease;
        }

            .danger-button:hover {
                background: #E3262E;
                border-color: #E3262E;
                color: #FFFFFF;
            }


        /* =========================================================
                   SCROLLBAR
                ========================================================= */

        .settings-main {
            scrollbar-width: thin;
            scrollbar-color: #D0D0D0 transparent;
        }

            .settings-main::-webkit-scrollbar {
                width: 5px;
            }

            .settings-main::-webkit-scrollbar-thumb {
                background: #D0D0D0;
                border-radius: 10px;
            }

            .settings-main::-webkit-scrollbar-track {
                background: transparent;
            }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 900px) {

            .settings-sidebar {
                width: 230px;
                min-width: 230px;
            }

            .settings-main {
                padding-left: 25px;
                padding-right: 25px;
            }

            .settings-search {
                width: 70%;
            }
        }


        @@media (max-width: 700px) {

            body {
                overflow-y: auto;
            }

            .settings-page {
                height: auto;
                min-height: 100vh;
                flex-direction: column;
            }

            .settings-sidebar {
                width: 100%;
                min-width: 100%;
                height: auto;
                border-right: none;
                border-bottom: 1px solid #E5E5E5;
                padding: 15px 20px;
            }

            .settings-back {
                margin-bottom: 20px;
            }

            .settings-profile {
                margin-bottom: 12px;
            }

            .settings-nav {
                flex-direction: row;
            }

                .settings-nav a {
                    flex: 1;
                }

            .settings-main {
                height: auto;
                min-height: calc(100vh - 250px);
                overflow: visible;
                padding: 25px 20px;
            }

            .settings-search {
                width: 100%;
            }

            .system-row {
                min-height: 78px;
                padding: 14px 18px;
            }

            .danger-row {
                align-items: flex-start;
                flex-direction: column;
            }

            .danger-button {
                width: 100%;
            }
        }


        @@media (max-width: 480px) {

            .settings-nav {
                flex-direction: column;
            }

            .system-row {
                align-items: flex-start;
                flex-direction: column;
                gap: 10px;
            }

            .settings-select {
                width: 100%;
            }

            .timeout-control {
                width: 100%;
            }

            .timeout-slider {
                flex: 1;
            }
        }

    </style>

</head>


<body>

    <div class="settings-container">

        <div class="settings-page">


            <!-- =====================================================
                 LEFT SETTINGS SIDEBAR
            ====================================================== -->

            <aside class="settings-sidebar">

                <!-- BACK -->

                <a href="@Url.Action("Dashboard", "Admin")"
                   class="settings-back">

                    <i class="bi bi-arrow-left"></i>

                    <span>
                        Settings
                    </span>

                </a>


                <!-- PROFILE -->

                <div class="settings-profile">

                    <img src="~/Images/adminpic.jpg"
                         class="settings-profile-img"
                         alt="Profile" />

                    <div class="settings-profile-info">

                        <span class="settings-profile-email">
                            smart.officerecords@gmail.com
                        </span>

                        <span class="settings-profile-role">
                            Administrator
                        </span>

                    </div>

                </div>


                <!-- SETTINGS NAVIGATION -->

                <nav class="settings-nav">


                    <!-- SYSTEM -->

                    <a href="@Url.Action("Settings", "Admin")"
                       class="active">

                        <i class="bi bi-display"></i>

                        <span>
                            System
                        </span>

                    </a>


                    <!-- PROFILE -->

                    <a href="@Url.Action("SAccountSettings", "Admin")">

                        <i class="bi bi-person"></i>

                        <span>
                            Profile
                        </span>

                    </a>


                </nav>

            </aside>


            <!-- =====================================================
                 MAIN SETTINGS
            ====================================================== -->

            <main class="settings-main">


                <!-- SEARCH -->

                <div class="settings-top">

                    <div class="settings-search">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Find Settings..." />

                    </div>

                </div>


                <!-- HEADING -->

                <div class="settings-heading">

                    <h1>
                        System
                    </h1>

                    <p>
                        Manage your profile, security and system preferences.
                    </p>

                </div>


                <!-- =================================================
                     SYSTEM SETTINGS CARD
                ================================================== -->

                <div class="system-card">


                    <!-- TIME ZONE -->

                    <div class="system-row">

                        <div class="system-label-text">

                            <strong>
                                Time Zone
                            </strong>

                        </div>


                        <select class="settings-select">

                            <option selected>
                                Asia/Manila (GMT+8)
                            </option>

                            <option>
                                Asia/Tokyo (GMT+9)
                            </option>

                            <option>
                                Asia/Singapore (GMT+8)
                            </option>

                            <option>
                                UTC
                            </option>

                        </select>

                    </div>


                    <!-- DATE FORMAT -->

                    <div class="system-row">

                        <div class="system-label-text">

                            <strong>
                                Date Format
                            </strong>

                        </div>


                        <select class="settings-select">

                            <option selected>
                                MM/DD/YYYY
                            </option>

                            <option>
                                DD/MM/YYYY
                            </option>

                            <option>
                                YYYY-MM-DD
                            </option>

                        </select>

                    </div>


                    <!-- DEFAULT LANGUAGE -->

                    <div class="system-row">

                        <div class="system-label-text">

                            <strong>
                                Default Language
                            </strong>

                        </div>


                        <select class="settings-select">

                            <option selected>
                                English
                            </option>

                            <option>
                                Filipino
                            </option>

                        </select>

                    </div>


                    <!-- SESSION TIMEOUT -->

                    <div class="system-row timeout-row">

                        <div class="system-label-text">

                            <strong>
                                Session Timeout
                            </strong>

                            <span>
                                How long before you're signed out from inactivity.
                            </span>

                        </div>


                        <div class="timeout-control">

                            <input type="range"
                                   id="timeoutSlider"
                                   class="timeout-slider"
                                   min="10"
                                   max="60"
                                   value="40" />

                            <span id="timeoutValue"
                                  class="timeout-value">

                                40 mins

                            </span>

                        </div>

                    </div>


                </div>


                <!-- =================================================
                     DANGER ZONE
                ================================================== -->

                <div class="danger-section">


                    <h2 class="danger-title">
                        Danger Zone
                    </h2>


                    <div class="danger-card">


                        <!-- SIGN OUT EVERYWHERE -->

                        <div class="danger-row">

                            <div class="danger-info">

                                <strong>
                                    Sign out all of devices
                                </strong>

                                <span>
                                    Ends every active session except this one. You'll need to sign back in on other devices.
                                </span>

                            </div>


                            <button type="button"
                                    class="danger-button"
                                    id="signOutButton">

                                Sign out everywhere

                            </button>

                        </div>


                        <!-- DELETE ACCOUNT -->

                        <div class="danger-row">

                            <div class="danger-info">

                                <strong>
                                    Delete Account
                                </strong>

                                <span>
                                    Permanent removes your access and profile. This can't be undone– assign another administrator.
                                </span>

                            </div>


                            <button type="button"
                                    class="danger-button"
                                    id="deleteAccountButton">

                                Delete Account

                            </button>

                        </div>


                    </div>

                </div>


            </main>

        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>

        /* =========================================================
           SESSION TIMEOUT
        ========================================================== */

        const timeoutSlider =
            document.getElementById("timeoutSlider");

        const timeoutValue =
            document.getElementById("timeoutValue");


        timeoutSlider.addEventListener("input", function () {

            timeoutValue.textContent =
                this.value + " mins";

        });


        /* =========================================================
           SIGN OUT EVERYWHERE
        ========================================================== */

        document.getElementById("signOutButton")
            .addEventListener("click", function () {

                const confirmLogout =
                    confirm(
                        "Are you sure you want to sign out all other devices?"
                    );

                if (confirmLogout) {

                    alert(
                        "All other active sessions have been signed out."
                    );

                }

            });


        /* =========================================================
           DELETE ACCOUNT
        ========================================================== */

        document.getElementById("deleteAccountButton")
            .addEventListener("click", function () {

                const confirmDelete =
                    confirm(
                        "Are you sure you want to delete this account? This action cannot be undone."
                    );

                if (confirmDelete) {

                    alert(
                        "Account deletion requires administrator confirmation."
                    );

                }

            });

    </script>

</body>
</html>