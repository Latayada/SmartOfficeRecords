@{
    ViewBag.Title = "Upload Files";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Upload Files - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">


    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #F5F6F8;
            overflow: hidden;
        }


        /* =========================================================
                   MAIN CONTAINER
                ========================================================= */

        .dashboard-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }


        /* =========================================================
                   SIDEBAR
                ========================================================= */

        .sidebar {
            width: 158px;
            min-width: 158px;
            height: 100vh;
            background: #1F2933;
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            transition: all .3s ease;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar {
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.25) transparent;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.25);
                border-radius: 10px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: transparent;
            }


            /* =========================================================
                   COLLAPSED SIDEBAR
                ========================================================= */

            .sidebar.collapsed {
                width: 78px;
                min-width: 78px;
            }

                .sidebar.collapsed .system-name {
                    display: block;
                    font-size: 10px;
                    font-weight: 600;
                    margin-top: 8px;
                }

                .sidebar.collapsed .logo-circle {
                    width: 42px;
                    height: 42px;
                }

                .sidebar.collapsed .logo-section {
                    padding: 18px 10px;
                }

                .sidebar.collapsed .menu a span,
                .sidebar.collapsed .dropdown-toggle-menu span,
                .sidebar.collapsed .logout a span {
                    display: none;
                }

                .sidebar.collapsed .menu {
                    padding: 15px 10px;
                }

                    .sidebar.collapsed .menu a {
                        width: 42px;
                        height: 42px;
                        margin: 0 auto 10px auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        border-radius: 6px;
                    }

                        .sidebar.collapsed .menu a.active {
                            background: #B91C1C;
                            box-shadow: 0 4px 10px rgba(0,0,0,.15);
                        }

                        .sidebar.collapsed .menu a i,
                        .sidebar.collapsed .logout a i {
                            margin: 0;
                        }

                .sidebar.collapsed .dropdown-toggle-menu {
                    width: 42px;
                    height: 42px;
                    margin: 0 auto 10px auto;
                    padding: 0;
                    justify-content: center;
                    align-items: center;
                    border-radius: 6px;
                }

                .sidebar.collapsed .small-arrow {
                    display: none;
                }

                .sidebar.collapsed .dropdown-submenu {
                    display: none !important;
                }

                .sidebar.collapsed .logout {
                    padding-bottom: 15px;
                }

                    .sidebar.collapsed .logout a {
                        width: 42px;
                        height: 42px;
                        margin: 0 auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }


        /* =========================================================
                   LOGO
                ========================================================= */

        .logo-section {
            text-align: center;
            padding: 16px 10px;
            border-bottom: 1px solid rgba(255,255,255,.18);
        }

        .logo-circle {
            width: 40px;
            height: 40px;
            background: #FFFFFF;
            border-radius: 50%;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .system-name {
            margin-top: 8px;
            font-size: 12px;
            font-weight: 600;
            color: #FFFFFF;
        }


        /* =========================================================
                   MENU
                ========================================================= */

        .menu {
            padding: 14px 8px;
        }

            .menu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                margin-bottom: 3px;
                border-radius: 5px;
                font-size: 11px;
                font-weight: 500;
                transition: all .2s ease;
            }

                .menu a i {
                    font-size: 14px;
                    min-width: 14px;
                }

                .menu a:hover {
                    background: rgba(185, 28, 28, .18);
                    color: #FFFFFF;
                }

                .menu a.active {
                    background: #B91C1C;
                    color: #FFFFFF;
                    box-shadow: 0 3px 8px rgba(185,28,28,.22);
                }


        /* =========================================================
                   SETTINGS DROPDOWN
                ========================================================= */

        .sidebar-dropdown {
            margin-bottom: 3px;
        }

        .dropdown-toggle-menu {
            color: #FFFFFF;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 500;
            transition: all .2s ease;
        }

            .dropdown-toggle-menu:hover {
                background: rgba(185,28,28,.18);
                color: #FFFFFF;
            }

        .small-arrow {
            font-size: 8px;
            transition: transform .3s ease;
        }

        .dropdown-submenu {
            display: none;
            flex-direction: column;
            padding-left: 14px;
            margin-top: 3px;
        }

            .dropdown-submenu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 7px 9px;
                font-size: 10px;
                border-radius: 5px;
            }

                .dropdown-submenu a:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }

        .sidebar-dropdown.open .dropdown-submenu {
            display: flex;
        }

        .sidebar-dropdown.open .small-arrow {
            transform: rotate(90deg);
        }


        /* =========================================================
                   LOGOUT
                ========================================================= */

        .logout {
            margin-top: auto;
            padding: 10px 8px 12px 8px;
        }

            .logout a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                gap: 10px;
                align-items: center;
                padding: 8px 10px;
                font-size: 11px;
                font-weight: 500;
                border-radius: 5px;
                transition: all .2s ease;
            }

                .logout a:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }


        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .main-content {
            flex: 1;
            background: #F5F6F8;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }


        /* =========================================================
                   TOPBAR
                ========================================================= */

        .topbar {
            height: 52px;
            min-height: 52px;
            flex-shrink: 0;
            border-bottom: 1px solid #E5E7EB;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 16px;
            background: #FFFFFF;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .menu-toggle {
            background: none;
            border: none;
            color: #B91C1C;
            font-size: 16px;
            cursor: pointer;
            padding: 4px;
        }


        /* =========================================================
                   TOPBAR RIGHT
                ========================================================= */

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-left: auto;
        }

        .notification-icon {
            font-size: 17px;
            color: #374151;
            cursor: pointer;
            transition: color .2s ease;
        }

            .notification-icon:hover {
                color: #B91C1C;
            }


        /* =========================================================
                   PROFILE
                ========================================================= */

        .profile {
            display: flex;
            align-items: center;
            gap: 7px;
            padding-left: 8px;
            border-left: 1px solid #E5E7EB;
        }

            .profile img {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                object-fit: cover;
            }

        .profile-info {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

            .profile-info h5 {
                margin: 0;
                font-size: 10px;
                font-weight: 600;
                color: #111827;
            }

            .profile-info span {
                font-size: 8px;
                color: #6B7280;
            }

        .profile-arrow {
            color: #6B7280;
            font-size: 9px;
            margin-left: 2px;
        }


        /* =========================================================
                   CONTENT AREA
                ========================================================= */

        .content-area {
            flex: 1;
            padding: 18px 28px;
            overflow-y: auto;
            overflow-x: hidden;
        }


        /* =========================================================
                   BREADCRUMB
                ========================================================= */

        .breadcrumb-title {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 19px;
            font-weight: 700;
            margin: 0;
            padding: 0;
            color: #111827;
            line-height: 1.3;
        }

        .files-breadcrumb {
            text-decoration: none;
            color: #9CA3AF;
            transition: .2s ease;
        }

            .files-breadcrumb:hover {
                color: #B91C1C;
            }

        .breadcrumb-title strong {
            color: #E32626;
            font-weight: 700;
        }


        /* =========================================================
                   PAGE DESCRIPTION
                ========================================================= */

        .page-description {
            color: #64748B;
            font-size: 10px;
            font-weight: 400;
            margin: 3px 0 20px 0;
            padding: 0;
            line-height: 1.4;
        }


        /* =========================================================
                   STEPPER
                ========================================================= */

        .stepper-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 9px;
            padding: 18px 22px;
            margin-bottom: 14px;
            box-shadow: 0 3px 12px rgba(0,0,0,.04);
        }

        .stepper {
            display: flex;
            align-items: center;
            width: 100%;
        }

        .step {
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .step-number {
            width: 27px;
            height: 27px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            font-weight: 700;
            background: #E5E7EB;
            color: #6B7280;
            flex-shrink: 0;
        }

        .step.active .step-number {
            background: #EF1C24;
            color: #FFFFFF;
        }

        .step-label {
            font-size: 9px;
            font-weight: 600;
            color: #6B7280;
        }

        .step.active .step-label {
            color: #EF1C24;
        }

        .step-line {
            flex: 1;
            height: 1px;
            background: #D1D5DB;
            margin: 0 15px;
        }


        /* =========================================================
                   UPLOAD CARD
                ========================================================= */

        .upload-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 9px;
            padding: 18px;
            box-shadow: 0 3px 12px rgba(0,0,0,.04);
        }


        /* =========================================================
                   UPLOAD TOP SECTION
                ========================================================= */

        .upload-grid {
            display: grid;
            grid-template-columns: 1fr 255px;
            gap: 10px;
            width: 100%;
        }


        /* =========================================================
                   DROP AREA
                ========================================================= */

        .drop-area {
            width: 100%;
            height: 212px;
            border: 2px dashed #D1D5DB;
            border-radius: 6px;
            background: #FFFFFF;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
            padding: 20px;
            transition: all .2s ease;
        }

            .drop-area:hover {
                border-color: #EF1C24;
                background: #FEF2F2;
            }

            .drop-area.dragover {
                border-color: #EF1C24;
                background: #FEF2F2;
            }


        /* =========================================================
                   UPLOAD ICON
                ========================================================= */

        .upload-icon {
            width: 48px;
            height: 48px;
            border-radius: 50%;
            background: #FEE2E2;
            color: #EF1C24;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 10px;
        }

            .upload-icon i {
                font-size: 23px;
            }


        /* =========================================================
                   DROP TEXT
                ========================================================= */

        .drop-title {
            color: #111827;
            font-size: 12px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .drop-description {
            color: #6B7280;
            font-size: 9px;
            margin-bottom: 12px;
        }


        /* =========================================================
                   CHOOSE FILE BUTTON
                ========================================================= */

        .choose-file-btn {
            height: 34px;
            border: none;
            border-radius: 5px;
            background: #EF1C24;
            color: #FFFFFF;
            padding: 0 17px;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all .2s ease;
        }

            .choose-file-btn:hover {
                background: #B91C1C;
                color: #FFFFFF;
            }


        /* =========================================================
                   FILE TYPE
                ========================================================= */

        .file-types {
            margin-top: 12px;
            color: #6B7280;
            font-size: 9px;
            font-weight: 500;
        }


        /* =========================================================
                   UPLOAD GUIDELINES
                ========================================================= */

        .guidelines-card {
            height: 212px;
            border: 1px solid #E5E7EB;
            border-radius: 6px;
            background: #FFFFFF;
            padding: 14px;
        }

        .guidelines-header {
            display: flex;
            align-items: center;
            gap: 9px;
            margin-bottom: 14px;
        }

        .guidelines-icon {
            width: 25px;
            height: 25px;
            border: 2px solid #3B82F6;
            border-radius: 50%;
            color: #3B82F6;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            flex-shrink: 0;
        }

        .guidelines-title {
            font-size: 10px;
            font-weight: 700;
            color: #111827;
        }

        .guideline-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            margin-bottom: 8px;
        }

        .guideline-check {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #22C55E;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 9px;
            flex-shrink: 0;
        }

        .guideline-text {
            color: #6B7280;
            font-size: 8px;
            line-height: 1.5;
        }


        /* =========================================================
                   SELECTED FILES
                ========================================================= */

        .selected-files {
            margin-top: 14px;
            width: 100%;
            min-height: 66px;
            border: 1px solid #E5E7EB;
            border-radius: 6px;
            background: #FFFFFF;
            padding: 11px 13px;
        }

        .selected-title {
            font-size: 11px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 7px;
        }

        .no-files {
            font-size: 9px;
            color: #9CA3AF;
        }

        .file-list {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .selected-file-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 7px 9px;
            background: #F9FAFB;
            border: 1px solid #E5E7EB;
            border-radius: 5px;
        }

        .selected-file-left {
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 0;
        }

            .selected-file-left i {
                color: #EF1C24;
                font-size: 13px;
            }

        .selected-file-name {
            font-size: 9px;
            color: #374151;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .remove-selected-file {
            border: none;
            background: transparent;
            color: #9CA3AF;
            font-size: 12px;
            cursor: pointer;
        }

            .remove-selected-file:hover {
                color: #EF1C24;
            }


        /* =========================================================
                   FOOTER
                ========================================================= */

        .upload-footer {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px;
            margin-top: 15px;
        }

        .cancel-btn {
            width: 90px;
            height: 34px;
            border: 1px solid #D1D5DB;
            border-radius: 5px;
            background: #FFFFFF;
            color: #374151;
            font-size: 9px;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s ease;
        }

            .cancel-btn:hover {
                background: #F3F4F6;
            }

        .next-btn {
            height: 34px;
            padding: 0 16px;
            border: none;
            border-radius: 5px;
            background: #EF1C24;
            color: #FFFFFF;
            font-size: 9px;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s ease;
        }

            .next-btn:hover {
                background: #B91C1C;
                transform: translateY(-1px);
            }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 1000px) {
            .upload-grid

        {
            grid-template-columns: 1fr;
        }

        .guidelines-card {
            height: auto;
            min-height: 180px;
        }

        .stepper {
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .step-line {
            min-width: 40px;
        }

        }


        @@media (max-width: 768px) {
            body

        {
            overflow-y: auto;
        }

        .sidebar {
            width: 78px;
            min-width: 78px;
        }

        .system-name,
        .menu a span,
        .dropdown-toggle-menu span,
        .logout a span {
            display: none;
        }

        .logo-section {
            padding: 18px 10px;
        }

        .logo-circle {
            width: 42px;
            height: 42px;
        }

        .menu {
            padding: 15px 10px;
        }

            .menu a {
                width: 42px;
                height: 42px;
                margin: 0 auto 10px auto;
                padding: 0;
                justify-content: center;
            }

        .dropdown-toggle-menu {
            width: 42px;
            height: 42px;
            margin: 0 auto 10px auto;
            padding: 0;
            justify-content: center;
        }

        .small-arrow {
            display: none;
        }

        .logout a {
            width: 42px;
            height: 42px;
            margin: 0 auto;
            padding: 0;
            justify-content: center;
        }

        .content-area {
            padding: 14px;
        }

        .breadcrumb-title {
            font-size: 16px;
        }

        .stepper-card {
            padding: 14px;
        }

        .upload-card {
            padding: 14px;
        }

        .upload-footer {
            justify-content: center;
        }

        }


        @@media (max-width: 500px) {
            .profile-info

        {
            display: none;
        }

        .profile-arrow {
            display: none;
        }

        .profile {
            border-left: none;
        }

        .content-area {
            padding: 12px;
        }

        .breadcrumb-title {
            font-size: 15px;
        }

        .upload-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .cancel-btn,
        .next-btn {
            width: 100%;
        }

        }
    </style>

</head>


<body>

    <div class="dashboard-container">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-circle">

                    <img src="~/Images/newlogo.png"
                         class="logo-img"
                         alt="SORS Logo" />

                </div>

                <div class="system-name">
                    SORS
                </div>

            </div>


            <!-- MENU -->

            <div class="menu">


                <!-- DASHBOARD -->

                <a href="@Url.Action("Dashboard", "Admin")">

                    <i class="bi bi-grid-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- REQUEST -->

                <a href="@Url.Action("RequestManagement", "Admin")">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        Request
                    </span>

                </a>


                <!-- RECORDS ACTIVE -->

                <a href="@Url.Action("RecordsManagement", "Admin")"
                   class="active">

                    <i class="bi bi-folder2-open"></i>

                    <span>
                        Records
                    </span>

                </a>


                <!-- REPORTS -->

                <a href="@Url.Action("ReportsManagement", "Admin")">

                    <i class="bi bi-file-earmark-bar-graph"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- AUDIT LOGS -->

                <a href="@Url.Action("AuditLogs", "Admin")">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                <!-- USERS -->

                <a href="@Url.Action("UsersManagement", "Admin")">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- SETTINGS -->

                <div class="sidebar-dropdown">

                    <a href="javascript:void(0)"
                       class="dropdown-toggle-menu">

                        <i class="bi bi-gear-fill"></i>

                        <span>
                            Settings
                        </span>

                        <i class="bi bi-chevron-right ms-auto small-arrow"></i>

                    </a>


                    <div class="dropdown-submenu">

                        <a href="@Url.Action("Settings", "Admin")">

                            <i class="bi bi-sliders"></i>

                            <span>
                                General Settings
                            </span>

                        </a>


                        <a href="@Url.Action("SAccountSettings", "Admin")">

                            <i class="bi bi-person-gear"></i>

                            <span>
                                Account & Security
                            </span>

                        </a>

                    </div>

                </div>


            </div>


            <!-- LOGOUT -->

            <div class="logout">

                <a href="@Url.Action("Login", "Admin")">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>


        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <div class="main-content">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <div class="topbar">


                <div class="topbar-left">

                    <button class="menu-toggle"
                            id="menuToggle">

                        <i class="bi bi-list"></i>

                    </button>

                </div>


                <div class="topbar-right">


                    <!-- NOTIFICATION -->

                    <i class="bi bi-bell notification-icon"></i>


                    <!-- PROFILE -->

                    <div class="profile">

                        <img src="~/Images/adminpic.jpg"
                             alt="Profile" />

                        <div class="profile-info">

                            <h5>
                                John Cruz
                            </h5>

                            <span>
                                Administrator
                            </span>

                        </div>

                        <i class="bi bi-chevron-down profile-arrow"></i>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="content-area">


                <!-- =================================================
                              BREADCRUMB
                ================================================== -->

                <div class="breadcrumb-title">

                    <a href="@Url.Action("RecordsManagement", "Admin")"
                       class="files-breadcrumb">

                        Records

                    </a>

                    <span>
                        ›
                    </span>

                    <strong>
                        Upload Records
                    </strong>

                </div>
                <p class="page-description">
                    Upload files to add a new office record.
                </p>


                <!-- =================================================
                     STEPPER
                ================================================== -->

                <div class="stepper-card">

                    <div class="stepper">


                        <!-- STEP 1 -->

                        <div class="step active">

                            <div class="step-number">
                                1
                            </div>

                            <div class="step-label">
                                Upload Files
                            </div>

                        </div>


                        <div class="step-line"></div>


                        <!-- STEP 2 -->

                        <div class="step">

                            <div class="step-number">
                                2
                            </div>

                            <div class="step-label">
                                Details
                            </div>

                        </div>


                        <div class="step-line"></div>


                        <!-- STEP 3 -->

                        <div class="step">

                            <div class="step-number">
                                3
                            </div>

                            <div class="step-label">
                                Review and Confirm
                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     UPLOAD CARD
                ================================================== -->

                <div class="upload-card">


                    <div class="upload-grid">


                        <!-- =================================================
                             DROP AREA
                        ================================================== -->

                        <div class="drop-area"
                             id="dropArea">


                            <div class="upload-icon">

                                <i class="bi bi-cloud-arrow-up"></i>

                            </div>


                            <div class="drop-title">

                                Drag and drop files here

                            </div>


                            <div class="drop-description">

                                or

                            </div>


                            <input type="file"
                                   id="fileInput"
                                   hidden
                                   multiple
                                   accept=".pdf,.doc,.docx,.png,.jpg,.jpeg" />


                            <button type="button"
                                    class="choose-file-btn"
                                    id="chooseFileBtn">

                                Browse Files

                            </button>


                            <div class="file-types">

                                PDF, DOC, DOCX, PNG, JPG

                            </div>


                        </div>


                        <!-- =================================================
                             GUIDELINES
                        ================================================== -->

                        <div class="guidelines-card">


                            <div class="guidelines-header">

                                <div class="guidelines-icon">

                                    <i class="bi bi-info"></i>

                                </div>

                                <div class="guidelines-title">

                                    Upload Guidelines

                                </div>

                            </div>


                            <div class="guideline-item">

                                <div class="guideline-check">

                                    <i class="bi bi-check"></i>

                                </div>

                                <div class="guideline-text">

                                    Ensure files are clear and readable.

                                </div>

                            </div>


                            <div class="guideline-item">

                                <div class="guideline-check">

                                    <i class="bi bi-check"></i>

                                </div>

                                <div class="guideline-text">

                                    Use appropriate file name.

                                </div>

                            </div>


                            <div class="guideline-item">

                                <div class="guideline-check">

                                    <i class="bi bi-check"></i>

                                </div>

                                <div class="guideline-text">

                                    Ensure files are clear and readable.

                                </div>

                            </div>


                            <div class="guideline-item">

                                <div class="guideline-check">

                                    <i class="bi bi-check"></i>

                                </div>

                                <div class="guideline-text">

                                    Allowed file types: PDF, DOC, DOCX, PNG, JPG.

                                </div>

                            </div>


                            <div class="guideline-item">

                                <div class="guideline-check">

                                    <i class="bi bi-check"></i>

                                </div>

                                <div class="guideline-text">

                                    You can upload multiple files at once.

                                </div>

                            </div>


                        </div>

                    </div>


                    <!-- =================================================
                         SELECTED FILES
                    ================================================== -->

                    <div class="selected-files">


                        <div class="selected-title">

                            Selected files (<span id="fileCount">0</span>)

                        </div>


                        <div class="no-files"
                             id="noFiles">

                            No files selected yet.

                        </div>


                        <div class="file-list"
                             id="fileList">
                        </div>


                    </div>


                    <!-- =================================================
                         FOOTER BUTTONS
                    ================================================== -->

                    <div class="upload-footer">


                        <button type="button"
                                class="cancel-btn"
                                onclick="window.location.href='@Url.Action("RecordsManagement", "Admin")'">

                            Cancel

                        </button>


                        <button type="button"
                                class="next-btn"
                                id="nextBtn">

                            Next: Add Details

                            <i class="bi bi-arrow-right ms-1"></i>

                        </button>


                    </div>


                </div>


            </div>

        </div>

    </div>


    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>


        /* =====================================================
           SETTINGS DROPDOWN
        ===================================================== */

        const dropdown =
            document.querySelector('.sidebar-dropdown');

        const dropdownToggle =
            document.querySelector('.dropdown-toggle-menu');


        dropdownToggle.addEventListener('click', function () {

            dropdown.classList.toggle('open');

        });


        /* =====================================================
           SIDEBAR COLLAPSE
        ===================================================== */

        const sidebar =
            document.querySelector('.sidebar');

        const menuToggle =
            document.getElementById('menuToggle');


        menuToggle.addEventListener('click', function () {

            sidebar.classList.toggle('collapsed');

        });


        /* =====================================================
           FILE UPLOAD
        ===================================================== */

        const chooseFileBtn =
            document.getElementById('chooseFileBtn');

        const fileInput =
            document.getElementById('fileInput');

        const dropArea =
            document.getElementById('dropArea');

        const fileList =
            document.getElementById('fileList');

        const fileCount =
            document.getElementById('fileCount');

        const noFiles =
            document.getElementById('noFiles');


        let selectedFiles = [];


        /* =====================================================
           CHOOSE FILE
        ===================================================== */

        chooseFileBtn.addEventListener('click', function () {

            fileInput.click();

        });


        /* =====================================================
           FILE INPUT CHANGE
        ===================================================== */

        fileInput.addEventListener('change', function () {

            if (fileInput.files.length > 0) {

                selectedFiles =
                    Array.from(fileInput.files);

                displayFiles();

            }

        });


        /* =====================================================
           DISPLAY FILES
        ===================================================== */

        function displayFiles() {

            fileList.innerHTML = "";


            fileCount.textContent =
                selectedFiles.length;


            if (selectedFiles.length === 0) {

                noFiles.style.display = "block";

                return;

            }


            noFiles.style.display = "none";


            selectedFiles.forEach(function (file, index) {


                const fileItem =
                    document.createElement("div");

                fileItem.className =
                    "selected-file-item";


                fileItem.innerHTML = `

                    <div class="selected-file-left">

                        <i class="bi bi-file-earmark"></i>

                        <span class="selected-file-name">
                            ${file.name}
                        </span>

                    </div>

                    <button type="button"
                            class="remove-selected-file"
                            onclick="removeFile(${index})">

                        <i class="bi bi-x-lg"></i>

                    </button>

                `;


                fileList.appendChild(fileItem);

            });

        }


        /* =====================================================
           REMOVE FILE
        ===================================================== */

        function removeFile(index) {

            selectedFiles.splice(index, 1);

            displayFiles();

        }


        /* =====================================================
           DRAG OVER
        ===================================================== */

        dropArea.addEventListener('dragover', function (e) {

            e.preventDefault();

            dropArea.classList.add('dragover');

        });


        /* =====================================================
           DRAG LEAVE
        ===================================================== */

        dropArea.addEventListener('dragleave', function () {

            dropArea.classList.remove('dragover');

        });


        /* =====================================================
           DROP
        ===================================================== */

        dropArea.addEventListener('drop', function (e) {

            e.preventDefault();

            dropArea.classList.remove('dragover');


            if (e.dataTransfer.files.length > 0) {

                selectedFiles =
                    Array.from(e.dataTransfer.files);

                displayFiles();

            }

        });


        /* =====================================================
           NEXT BUTTON
        ===================================================== */

        document.getElementById('nextBtn')
            .addEventListener('click', function () {


                if (selectedFiles.length === 0) {

                    alert("Please select at least one file first.");

                    return;

                }


                window.location.href =
                    '@Url.Action("UploadRecordDetails", "Admin")';

            });


    </script>

</body>
</html>