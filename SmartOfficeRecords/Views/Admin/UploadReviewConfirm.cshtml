@{
    ViewBag.Title = "Upload Review Confirm";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Upload Review Confirm - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- SAME FONT AS CREATE REQUEST -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        body {
            background: #F5F6F8;
            overflow: hidden;
            color: #111827;
        }

        .dashboard-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }


        /* =========================================================
                   SIDEBAR
                ========================================================= */

        .sidebar {
            width: 158px;
            min-width: 158px;
            height: 100vh;
            background: #1F2933;
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            transition: all .3s ease;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.25) transparent;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.25);
                border-radius: 10px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: transparent;
            }


            /* =========================================================
                   COLLAPSED SIDEBAR
                ========================================================= */

            .sidebar.collapsed {
                width: 78px;
                min-width: 78px;
            }

                .sidebar.collapsed .system-name {
                    display: block;
                    font-size: 11px;
                    font-weight: 700;
                    margin-top: 8px;
                    letter-spacing: .2px;
                }

                .sidebar.collapsed .logo-circle {
                    width: 42px;
                    height: 42px;
                }

                .sidebar.collapsed .logo-section {
                    padding: 18px 10px;
                }

                .sidebar.collapsed .menu a span,
                .sidebar.collapsed .dropdown-toggle-menu span,
                .sidebar.collapsed .logout a span {
                    display: none;
                }

                .sidebar.collapsed .menu {
                    padding: 16px 10px;
                }

                    .sidebar.collapsed .menu a {
                        width: 44px;
                        height: 44px;
                        margin: 0 auto 10px auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        border-radius: 6px;
                    }

                        .sidebar.collapsed .menu a.active {
                            background: #B91C1C;
                            box-shadow: 0 4px 10px rgba(0,0,0,.15);
                        }

                        .sidebar.collapsed .menu a i,
                        .sidebar.collapsed .logout a i {
                            margin: 0;
                            font-size: 17px;
                        }

                .sidebar.collapsed .dropdown-toggle-menu {
                    width: 44px;
                    height: 44px;
                    margin: 0 auto 10px auto;
                    padding: 0;
                    justify-content: center;
                    align-items: center;
                    border-radius: 6px;
                }

                .sidebar.collapsed .small-arrow {
                    display: none;
                }

                .sidebar.collapsed .dropdown-submenu {
                    display: none !important;
                }

                .sidebar.collapsed .logout {
                    padding-bottom: 15px;
                }

                    .sidebar.collapsed .logout a {
                        width: 44px;
                        height: 44px;
                        margin: 0 auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }


        /* =========================================================
                   LOGO
                ========================================================= */

        .logo-section {
            text-align: center;
            padding: 18px 10px;
            border-bottom: 1px solid rgba(255,255,255,.18);
        }

        .logo-circle {
            width: 42px;
            height: 42px;
            background: #FFFFFF;
            border-radius: 50%;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .system-name {
            margin-top: 9px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .3px;
            color: #FFFFFF;
        }


        /* =========================================================
                   MENU
                ========================================================= */

        .menu {
            padding: 16px 9px;
        }

            .menu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 11px;
                padding: 10px 11px;
                margin-bottom: 5px;
                border-radius: 6px;
                font-size: 13px;
                font-weight: 500;
                line-height: 1.2;
                transition: all .2s ease;
            }

                .menu a i {
                    font-size: 16px;
                    min-width: 16px;
                }

                .menu a:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }

                .menu a.active {
                    background: #B91C1C;
                    color: #FFFFFF;
                    box-shadow: 0 3px 8px rgba(185,28,28,.22);
                }


        /* =========================================================
                   SETTINGS DROPDOWN
                ========================================================= */

        .sidebar-dropdown {
            margin-bottom: 5px;
        }

        .dropdown-toggle-menu {
            color: #FFFFFF;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 10px 11px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 500;
            line-height: 1.2;
            transition: all .2s ease;
        }

            .dropdown-toggle-menu:hover {
                background: rgba(185,28,28,.18);
                color: #FFFFFF;
            }

        .small-arrow {
            font-size: 9px;
            transition: transform .3s ease;
        }

        .dropdown-submenu {
            display: none;
            flex-direction: column;
            padding-left: 14px;
            margin-top: 3px;
        }

            .dropdown-submenu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 9px;
                font-size: 11px;
                border-radius: 5px;
            }

                .dropdown-submenu a:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }

        .sidebar-dropdown.open .dropdown-submenu {
            display: flex;
        }

        .sidebar-dropdown.open .small-arrow {
            transform: rotate(90deg);
        }


        /* =========================================================
                   LOGOUT
                ========================================================= */

        .logout {
            margin-top: auto;
            padding: 12px 9px 15px 9px;
        }

            .logout a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                gap: 11px;
                align-items: center;
                padding: 10px 11px;
                font-size: 13px;
                font-weight: 500;
                border-radius: 6px;
                transition: all .2s ease;
            }

                .logout a i {
                    font-size: 16px;
                }

                .logout a:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }


        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .main-content {
            flex: 1;
            background: #F5F6F8;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }


        /* =========================================================
                   TOPBAR
                ========================================================= */

        .topbar {
            height: 56px;
            min-height: 56px;
            flex-shrink: 0;
            border-bottom: 1px solid #E5E7EB;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            background: #FFFFFF;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .menu-toggle {
            background: none;
            border: none;
            color: #B91C1C;
            font-size: 19px;
            cursor: pointer;
            padding: 5px;
        }


        /* =========================================================
                   TOPBAR RIGHT
                ========================================================= */

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-left: auto;
        }

        .notification-icon {
            font-size: 19px;
            color: #374151;
            cursor: pointer;
            transition: color .2s ease;
        }

            .notification-icon:hover {
                color: #B91C1C;
            }


        /* =========================================================
                   PROFILE
                ========================================================= */

        .profile {
            display: flex;
            align-items: center;
            gap: 9px;
            padding-left: 12px;
            border-left: 1px solid #E5E7EB;
        }

            .profile img {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                object-fit: cover;
            }

        .profile-info {
            display: flex;
            flex-direction: column;
            line-height: 1.25;
        }

            .profile-info h5 {
                margin: 0;
                font-size: 12px;
                font-weight: 600;
                color: #111827;
            }

            .profile-info span {
                font-size: 10px;
                color: #6B7280;
                margin-top: 2px;
            }

        .profile-arrow {
            color: #6B7280;
            font-size: 10px;
            margin-left: 3px;
        }


        /* =========================================================
                   CONTENT AREA
                ========================================================= */

        .content-area {
            flex: 1;
            padding: 22px 30px;
            overflow-y: auto;
            overflow-x: hidden;
        }


        /* =========================================================
                   BREADCRUMB
                   SAME SIZE AS CREATE REQUEST
                ========================================================= */

        .breadcrumb-title {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 24px;
            font-weight: 700;
            margin: 0;
            padding: 0;
            color: #111827;
            line-height: 1.2;
        }

        .review-breadcrumb {
            text-decoration: none;
            color: #9CA3AF;
            transition: .2s ease;
        }

            .review-breadcrumb:hover {
                color: #B91C1C;
            }

        .breadcrumb-title strong {
            color: #B91C1C;
            font-weight: 700;
        }


        /* =========================================================
                   PAGE DESCRIPTION
                ========================================================= */

        .page-description {
            color: #64748B;
            font-size: 13px;
            font-weight: 400;
            margin: 5px 0 18px 0;
            padding: 0;
            line-height: 1.5;
        }


        /* =========================================================
                   STEPPER
                ========================================================= */

        .stepper-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            padding: 18px 20px;
            margin-bottom: 16px;
            box-shadow: 0 3px 12px rgba(0,0,0,.04);
        }

        .stepper {
            display: flex;
            align-items: center;
            width: 100%;
        }

        .step {
            display: flex;
            align-items: center;
            gap: 9px;
            white-space: nowrap;
        }

        .step-number {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 700;
            background: #E5E7EB;
            color: #6B7280;
            flex-shrink: 0;
        }

        .step.completed .step-number,
        .step.active .step-number {
            background: #EF1C24;
            color: #FFFFFF;
        }

        .step-label {
            font-size: 11px;
            font-weight: 600;
            color: #6B7280;
        }

        .step.completed .step-label,
        .step.active .step-label {
            color: #EF1C24;
        }

        .step-line {
            flex: 1;
            height: 1px;
            background: #D1D5DB;
            margin: 0 16px;
        }

            .step-line.completed {
                background: #EF1C24;
            }


        /* =========================================================
                   REVIEW CARD
                ========================================================= */

        .review-card {
            width: 100%;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            border-radius: 8px;
            padding: 18px;
            box-shadow: 0 3px 12px rgba(0,0,0,.04);
        }

        .review-title {
            font-size: 14px;
            font-weight: 700;
            color: #111827;
            margin-bottom: 4px;
        }

        .review-subtitle {
            font-size: 12px;
            color: #9CA3AF;
            font-weight: 400;
            margin-bottom: 18px;
        }


        /* =========================================================
                   SECTION BOX
                ========================================================= */

        .section-box {
            border: 1px solid #E5E7EB;
            border-radius: 6px;
            background: #FFFFFF;
            margin-bottom: 14px;
            overflow: hidden;
        }

        .section-header {
            padding: 10px 12px;
            border-bottom: 1px solid #E5E7EB;
            font-size: 12px;
            font-weight: 700;
            color: #111827;
        }


        /* =========================================================
                   FILE AREA
                ========================================================= */

        .file-area {
            min-height: 65px;
            padding: 12px;
        }

        .no-files {
            font-size: 11px;
            color: #9CA3AF;
        }

        .total-size {
            border-top: 1px solid #E5E7EB;
            padding: 7px 12px;
            font-size: 10px;
            color: #9CA3AF;
        }


        /* =========================================================
                   DETAILS SUMMARY
                ========================================================= */

        .summary-table {
            width: 100%;
            border-collapse: collapse;
        }

            .summary-table tr {
                border-bottom: 1px solid #E5E7EB;
            }

                .summary-table tr:last-child {
                    border-bottom: none;
                }

            .summary-table td {
                padding: 7px 12px;
                font-size: 11px;
            }

        .summary-label {
            width: 18%;
            color: #9CA3AF;
            font-weight: 600;
        }

        .summary-value {
            color: #6B7280;
            font-weight: 500;
        }


        /* =========================================================
                   FOOTER
                ========================================================= */

        .review-footer {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            gap: 10px;
            margin-top: 18px;
        }

        .cancel-btn,
        .back-btn {
            width: 180px;
            height: 40px;
            border-radius: 6px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s ease;
        }

        .cancel-btn,
        .back-btn {
            border: 1px solid #D1D5DB;
            background: #FFFFFF;
            color: #374151;
        }

            .cancel-btn:hover,
            .back-btn:hover {
                background: #F3F4F6;
            }

        .upload-btn {
            width: 180px;
            height: 40px;
            border: none;
            border-radius: 6px;
            background: #EF1C24;
            color: #FFFFFF;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s ease;
            box-shadow: 0 3px 8px rgba(239,28,36,.20);
        }

            .upload-btn:hover {
                background: #B91C1C;
                transform: translateY(-1px);
                box-shadow: 0 5px 12px rgba(185,28,28,.25);
            }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 1000px) {

            .stepper {
                overflow-x: auto;
                padding-bottom: 5px;
            }

            .step-line {
                min-width: 50px;
            }

            .review-footer {
                margin-top: 30px;
            }
        }


        @@media (max-width: 768px) {

            body {
                overflow-y: auto;
            }

            .sidebar {
                width: 78px;
                min-width: 78px;
            }

            .system-name,
            .menu a span,
            .dropdown-toggle-menu span,
            .logout a span {
                display: none;
            }

            .logo-section {
                padding: 18px 10px;
            }

            .logo-circle {
                width: 42px;
                height: 42px;
            }

            .menu {
                padding: 15px 10px;
            }

                .menu a {
                    width: 44px;
                    height: 44px;
                    margin: 0 auto 10px auto;
                    padding: 0;
                    justify-content: center;
                }

            .dropdown-toggle-menu {
                width: 44px;
                height: 44px;
                margin: 0 auto 10px auto;
                padding: 0;
                justify-content: center;
            }

            .small-arrow {
                display: none;
            }

            .logout a {
                width: 44px;
                height: 44px;
                margin: 0 auto;
                padding: 0;
                justify-content: center;
            }

            .content-area {
                padding: 16px;
            }

            .breadcrumb-title {
                font-size: 21px;
            }

            .stepper-card,
            .review-card {
                padding: 16px;
            }

            .review-footer {
                justify-content: center;
            }
        }


        @@media (max-width: 500px) {

            .profile-info {
                display: none;
            }

            .profile-arrow {
                display: none;
            }

            .profile {
                border-left: none;
            }

            .content-area {
                padding: 12px;
            }

            .breadcrumb-title {
                font-size: 19px;
            }

            .review-footer {
                flex-direction: column-reverse;
                align-items: stretch;
            }

            .cancel-btn,
            .back-btn,
            .upload-btn {
                width: 100%;
            }
        }

    </style>

</head>

<body>

    <div class="dashboard-container">

        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">

            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-circle">

                    <img src="~/Images/newlogo.png"
                         class="logo-img"
                         alt="SORS Logo" />

                </div>

                <div class="system-name">
                    SORS
                </div>

            </div>


            <!-- MENU -->

            <div class="menu">

                <!-- DASHBOARD -->

                <a href="@Url.Action("Dashboard", "Admin")">

                    <i class="bi bi-grid-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- REQUEST -->

                <a href="@Url.Action("RequestManagement", "Admin")">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        Request
                    </span>

                </a>


                <!-- RECORDS -->

                <a href="@Url.Action("RecordsManagement", "Admin")"
                   class="active">

                    <i class="bi bi-folder2-open"></i>

                    <span>
                        Records
                    </span>

                </a>


                <!-- REPORTS -->

                <a href="@Url.Action("ReportsManagement", "Admin")">

                    <i class="bi bi-file-earmark-bar-graph"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- AUDIT LOGS -->

                <a href="@Url.Action("AuditLogs", "Admin")">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                <!-- USERS -->

                <a href="@Url.Action("UsersManagement", "Admin")">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- SETTINGS -->

                <div class="sidebar-dropdown">

                    <a href="javascript:void(0)"
                       class="dropdown-toggle-menu">

                        <i class="bi bi-gear-fill"></i>

                        <span>
                            Settings
                        </span>

                        <i class="bi bi-chevron-right ms-auto small-arrow"></i>

                    </a>


                    <div class="dropdown-submenu">

                        <a href="@Url.Action("Settings", "Admin")">

                            <i class="bi bi-sliders"></i>

                            <span>
                                General Settings
                            </span>

                        </a>


                        <a href="@Url.Action("SAccountSettings", "Admin")">

                            <i class="bi bi-person-gear"></i>

                            <span>
                                Account & Security
                            </span>

                        </a>

                    </div>

                </div>

            </div>


            <!-- LOGOUT -->

            <div class="logout">

                <a href="@Url.Action("Login", "Admin")">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>

        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <div class="main-content">


            <!-- TOPBAR -->

            <div class="topbar">

                <div class="topbar-left">

                    <button class="menu-toggle"
                            id="menuToggle"
                            type="button">

                        <i class="bi bi-list"></i>

                    </button>

                </div>


                <div class="topbar-right">

                    <i class="bi bi-bell notification-icon"></i>


                    <div class="profile">

                        <img src="~/Images/adminpic.jpg"
                             alt="Profile" />

                        <div class="profile-info">

                            <h5>
                                John Cruz
                            </h5>

                            <span>
                                Administrator
                            </span>

                        </div>

                        <i class="bi bi-chevron-down profile-arrow"></i>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 CONTENT
            ================================================== -->

            <div class="content-area">


                <!-- BREADCRUMB -->

                <div class="breadcrumb-title">

                    <a href="@Url.Action("RecordsManagement", "Admin")"
                       class="review-breadcrumb">

                        Records

                    </a>

                    <span>
                        ›
                    </span>

                    <strong>
                        Upload Records
                    </strong>

                </div>


                <!-- DESCRIPTION -->

                <p class="page-description">
                    Review the record details and confirm the information before saving.
                </p>


                <!-- =================================================
                     STEPPER
                ================================================== -->

                <div class="stepper-card">

                    <div class="stepper">


                        <!-- STEP 1 -->

                        <div class="step completed">

                            <div class="step-number">

                                <i class="bi bi-check"></i>

                            </div>

                            <div class="step-label">
                                Upload Files
                            </div>

                        </div>


                        <div class="step-line completed"></div>


                        <!-- STEP 2 -->

                        <div class="step completed">

                            <div class="step-number">

                                <i class="bi bi-check"></i>

                            </div>

                            <div class="step-label">
                                Details
                            </div>

                        </div>


                        <div class="step-line completed"></div>


                        <!-- STEP 3 -->

                        <div class="step active">

                            <div class="step-number">
                                3
                            </div>

                            <div class="step-label">
                                Review and Confirm
                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     REVIEW CARD
                ================================================== -->

                <div class="review-card">


                    <div class="review-title">
                        Review your Upload file
                    </div>

                    <div class="review-subtitle">
                        Please review all the details before uploading the records.
                    </div>


                    <!-- =================================================
                         UPLOADED FILES
                    ================================================== -->

                    <div class="section-box">

                        <div class="section-header">

                            Uploaded files
                            (<span id="fileCount">0</span>)

                        </div>


                        <div class="file-area">

                            <div class="no-files"
                                 id="noFiles">

                                No files uploaded.

                            </div>

                            <div id="fileList"></div>

                        </div>


                        <div class="total-size">

                            Total size:
                            <span id="totalSize">
                                0
                            </span>

                        </div>

                    </div>


                    <!-- =================================================
                         DETAILS SUMMARY
                    ================================================== -->

                    <div class="section-box">

                        <div class="section-header">
                            Details Summary
                        </div>


                        <table class="summary-table">

                            <tr>

                                <td class="summary-label">
                                    Full name
                                </td>

                                <td class="summary-value"
                                    id="summaryName">

                                    Juan Dela Paz

