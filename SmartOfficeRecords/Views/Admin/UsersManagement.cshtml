@{
    ViewBag.Title = "User Management";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>User Management - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #F5F6F8;
            overflow: hidden;
        }


        /* =========================================================
                   MAIN CONTAINER
                ========================================================= */

        .dashboard-container {
            display: flex;
            height: 100vh;
            width: 100%;
        }


        /* =========================================================
                   SIDEBAR
                ========================================================= */

        .sidebar {
            width: 158px;
            min-width: 158px;
            height: 100vh;
            background: #1F2933;
            color: #FFFFFF;
            display: flex;
            flex-direction: column;
            transition: all .3s ease;
            overflow-y: auto;
            overflow-x: hidden;
        }

        .sidebar {
            scrollbar-width: thin;
            scrollbar-color: rgba(255,255,255,.25) transparent;
        }

            .sidebar::-webkit-scrollbar {
                width: 5px;
            }

            .sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.25);
                border-radius: 10px;
            }

            .sidebar::-webkit-scrollbar-track {
                background: transparent;
            }


            /* =========================================================
                   COLLAPSED SIDEBAR
                ========================================================= */

            .sidebar.collapsed {
                width: 78px;
                min-width: 78px;
            }

                .sidebar.collapsed .system-name {
                    display: block;
                    font-size: 10px;
                    font-weight: 600;
                    margin-top: 8px;
                }

                .sidebar.collapsed .logo-circle {
                    width: 42px;
                    height: 42px;
                }

                .sidebar.collapsed .logo-section {
                    padding: 18px 10px;
                }

                .sidebar.collapsed .menu a span,
                .sidebar.collapsed .logout a span {
                    display: none;
                }

                .sidebar.collapsed .menu {
                    padding: 15px 10px;
                }

                    .sidebar.collapsed .menu a {
                        width: 42px;
                        height: 42px;
                        margin: 0 auto 10px auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                        border-radius: 6px;
                    }

                        .sidebar.collapsed .menu a.active {
                            background: #B91C1C;
                            box-shadow: 0 4px 10px rgba(0,0,0,.15);
                        }

                        .sidebar.collapsed .menu a i,
                        .sidebar.collapsed .logout a i {
                            margin: 0;
                        }

                .sidebar.collapsed .logout {
                    padding-bottom: 15px;
                }

                    .sidebar.collapsed .logout a {
                        width: 42px;
                        height: 42px;
                        margin: 0 auto;
                        padding: 0;
                        display: flex;
                        justify-content: center;
                        align-items: center;
                    }

                .sidebar.collapsed .small-arrow {
                    display: none;
                }


        /* =========================================================
                   LOGO SECTION
                ========================================================= */

        .logo-section {
            text-align: center;
            padding: 16px 10px;
            border-bottom: 1px solid rgba(255,255,255,.18);
        }

        .logo-circle {
            width: 40px;
            height: 40px;
            background: #FFFFFF;
            border-radius: 50%;
            margin: auto;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .system-name {
            margin-top: 8px;
            font-size: 12px;
            font-weight: 600;
            color: #FFFFFF;
        }


        /* =========================================================
                   MENU
                ========================================================= */

        .menu {
            padding: 14px 8px;
        }

            .menu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 8px 10px;
                margin-bottom: 3px;
                border-radius: 5px;
                font-size: 11px;
                font-weight: 500;
                transition: all .2s ease;
            }

                .menu a i {
                    font-size: 14px;
                    min-width: 14px;
                }

                .menu a:hover {
                    background: rgba(185, 28, 28, .18);
                    color: #FFFFFF;
                }

                .menu a.active {
                    background: #B91C1C;
                    color: #FFFFFF;
                    box-shadow: 0 3px 8px rgba(185,28,28,.22);
                }


        /* =========================================================
                   SETTINGS DROPDOWN
                ========================================================= */

        .sidebar-dropdown {
            margin-bottom: 3px;
        }

        .dropdown-toggle-menu {
            color: #FFFFFF;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 10px;
            border-radius: 5px;
            cursor: pointer;
            font-size: 11px;
            font-weight: 500;
            transition: all .2s ease;
        }

            .dropdown-toggle-menu:hover {
                background: rgba(185,28,28,.18);
                color: #FFFFFF;
            }

        .small-arrow {
            font-size: 8px;
            transition: transform .3s ease;
        }

        .dropdown-submenu {
            display: none;
            flex-direction: column;
            padding-left: 14px;
            margin-top: 3px;
        }

            .dropdown-submenu a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 7px 9px;
                font-size: 10px;
                border-radius: 5px;
            }

                .dropdown-submenu a:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }

        .sidebar-dropdown.open .dropdown-submenu {
            display: flex;
        }

        .sidebar-dropdown.open .small-arrow {
            transform: rotate(90deg);
        }


        /* =========================================================
                   LOGOUT
                ========================================================= */

        .logout {
            margin-top: auto;
            padding: 10px 8px 12px 8px;
        }

            .logout a {
                color: #FFFFFF;
                text-decoration: none;
                display: flex;
                gap: 10px;
                align-items: center;
                padding: 8px 10px;
                font-size: 11px;
                font-weight: 500;
                border-radius: 5px;
                transition: all .2s ease;
            }

                .logout a:hover {
                    background: rgba(185,28,28,.18);
                    color: #FFFFFF;
                }


        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .main-content {
            flex: 1;
            background: #F5F6F8;
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }


        /* =========================================================
                   TOPBAR
                ========================================================= */

        .topbar {
            height: 52px;
            min-height: 52px;
            flex-shrink: 0;
            border-bottom: 1px solid #E5E7EB;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 16px;
            background: #FFFFFF;
        }

        .topbar-left {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .menu-toggle {
            background: none;
            border: none;
            color: #B91C1C;
            font-size: 16px;
            cursor: pointer;
            padding: 4px;
        }

            .menu-toggle:hover {
                color: #991B1B;
            }


        /* =========================================================
                   TOPBAR RIGHT
                ========================================================= */

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-left: auto;
        }

        .notification-icon {
            font-size: 17px;
            color: #374151;
            cursor: pointer;
            transition: color .2s ease;
        }

            .notification-icon:hover {
                color: #B91C1C;
            }


        /* =========================================================
                   PROFILE
                ========================================================= */

        .profile {
            display: flex;
            align-items: center;
            gap: 7px;
            padding-left: 8px;
            border-left: 1px solid #E5E7EB;
        }

            .profile img {
                width: 30px;
                height: 30px;
                border-radius: 50%;
                object-fit: cover;
            }

        .profile-info {
            display: flex;
            flex-direction: column;
            line-height: 1.15;
        }

            .profile-info h5 {
                margin: 0;
                font-size: 10px;
                font-weight: 600;
                color: #111827;
            }

            .profile-info span {
                font-size: 8px;
                color: #6B7280;
            }

        .profile-arrow {
            color: #6B7280;
            font-size: 9px;
            margin-left: 2px;
        }


        /* =========================================================
                   CONTENT AREA
                ========================================================= */

        .content-area {
            flex: 1;
            padding: 18px 28px;
            overflow-y: auto;
            overflow-x: hidden;
        }


        /* =========================================================
                   PAGE HEADER
                ========================================================= */

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .page-title {
            color: #B91C1C;
            font-size: 18px;
            font-weight: 700;
            margin: 0 0 2px 0;
        }

        .page-description {
            color: #64748B;
            font-size: 9px;
            font-weight: 500;
            margin: 0;
        }


        /* =========================================================
                   ACTION BAR
                ========================================================= */

        .action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
        }

        .search-filter {
            display: flex;
            align-items: center;
            gap: 12px;
            flex: 1;
        }


        /* =========================================================
                   SEARCH BOX
                ========================================================= */

        .search-box {
            height: 34px;
            flex: 1;
            max-width: 560px;
            background: #FFFFFF;
            border-radius: 20px;
            box-shadow: 0 3px 12px rgba(0,0,0,.07);
            display: flex;
            align-items: center;
            padding: 0 12px;
            gap: 8px;
        }

            .search-box i {
                color: #6B7280;
                font-size: 12px;
            }

            .search-box input {
                width: 100%;
                border: none;
                outline: none;
                font-size: 10px;
                color: #374151;
                background: transparent;
            }

                .search-box input::placeholder {
                    color: #9CA3AF;
                }


        /* =========================================================
                   ROLE FILTER
                ========================================================= */

        .status-filter {
            width: 120px;
            height: 34px;
            background: #FFFFFF;
            border: 1px solid #D1D5DB;
            border-radius: 6px;
            padding: 0 10px;
            font-size: 10px;
            font-weight: 600;
            color: #374151;
            outline: none;
        }

            .status-filter:focus {
                border-color: #B91C1C;
            }


        /* =========================================================
                   ADD USER BUTTON
                ========================================================= */

        .create-btn {
            background: #B91C1C;
            border: none;
            color: #FFFFFF;
            height: 34px;
            padding: 0 14px;
            border-radius: 5px;
            font-weight: 600;
            font-size: 10px;
            transition: all .2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            text-decoration: none;
            white-space: nowrap;
        }

            .create-btn i {
                font-size: 14px;
            }

            .create-btn:hover {
                background: #991B1B;
                color: #FFFFFF;
                transform: translateY(-1px);
                box-shadow: 0 4px 10px rgba(201,28,28,.25);
            }

            .create-btn:active {
                transform: translateY(0);
            }


        /* =========================================================
                   TABLE CONTAINER
                ========================================================= */

        .table-container {
            background: #FFFFFF;
            border: 1px solid #D9DDE3;
            border-radius: 6px;
            overflow: hidden;
        }


        /* =========================================================
                   USER TABLE
                ========================================================= */

        .user-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
            table-layout: fixed;
        }


            /* =========================================================
                   TABLE HEADER
                ========================================================= */

            .user-table thead {
                background: #111111;
            }

            .user-table th {
                height: 38px;
                padding: 0 12px;
                font-size: 9px;
                font-weight: 700;
                color: #ffffff;
                border-bottom: 1px solid #CCCCCC;
                white-space: nowrap;
                text-align: left;
            }


                /* =========================================================
                   COLUMN WIDTHS
                   STATUS AND LAST ACTIVE ARE BESIDE EACH OTHER
                ========================================================= */

                .user-table th:nth-child(1),
                .user-table td:nth-child(1) {
                    width: 8%;
                }

                .user-table th:nth-child(2),
                .user-table td:nth-child(2) {
                    width: 14%;
                }

                .user-table th:nth-child(3),
                .user-table td:nth-child(3) {
                    width: 24%;
                }

                .user-table th:nth-child(4),
                .user-table td:nth-child(4) {
                    width: 12%;
                }

                .user-table th:nth-child(5),
                .user-table td:nth-child(5) {
                    width: 13%;
                }

                .user-table th:nth-child(6),
                .user-table td:nth-child(6) {
                    width: 16%;
                }

                .user-table th:nth-child(7),
                .user-table td:nth-child(7) {
                    width: 13%;
                }


            /* =========================================================
                   TABLE BODY
                ========================================================= */

            .user-table td {
                height: 36px;
                padding: 0 12px;
                font-size: 8px;
                color: #374151;
                border-bottom: 1px solid #E5E7EB;
                white-space: nowrap;
                vertical-align: middle;
            }

            .user-table tbody tr:hover {
                background: #FAFAFA;
            }

            .user-table tbody tr:last-child td {
                border-bottom: none;
            }


        /* =========================================================
                   ROLE BADGES
                ========================================================= */

        .role-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 45px;
            padding: 3px 8px;
            border-radius: 8px;
            font-size: 7px;
            font-weight: 600;
        }

        .role-admin {
            background: #FECACA;
            color: #DC2626;
        }

        .role-staff {
            background: #F3F4F6;
            color: #374151;
        }


        /* =========================================================
                   STATUS BADGES
                ========================================================= */

        .active-badge,
        .inactive-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 4px 9px;
            border-radius: 10px;
            font-size: 7px;
            font-weight: 600;
        }

        .active-badge {
            background: #D1FAE5;
            color: #10B981;
        }

            .active-badge::before {
                content: "";
                width: 4px;
                height: 4px;
                background: #10B981;
                border-radius: 50%;
            }

        .inactive-badge {
            background: #FEE2E2;
            color: #DC2626;
        }

            .inactive-badge::before {
                content: "";
                width: 4px;
                height: 4px;
                background: #DC2626;
                border-radius: 50%;
            }


        /* =========================================================
                   LAST ACTIVE
                ========================================================= */

        .last-active {
            font-size: 8px;
            color: #374151;
            white-space: nowrap;
        }


        /* =========================================================
                   USER ACTIONS
                ========================================================= */

        .user-actions {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .edit-btn,
        .deactivate-btn {
            height: 24px;
            padding: 0 9px;
            border-radius: 5px;
            font-size: 8px;
            font-weight: 600;
            text-decoration: none;
            cursor: pointer;
            transition: all .2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            white-space: nowrap;
        }

        .edit-btn {
            background: #FFFFFF;
            color: #374151;
            border: 1px solid #E2E5E8;
        }

            .edit-btn:hover {
                background: #F3F4F6;
                color: #111827;
                border-color: #CBD5E1;
            }

        .deactivate-btn {
            background: #F8D7DA;
            color: #DC3545;
            border: 1px solid transparent;
        }

            .deactivate-btn:hover {
                background: #F1BFC3;
                color: #B91C1C;
            }


        /* =========================================================
                   PAGINATION
                ========================================================= */

        .pagination-area {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 8px;
        }

        .showing-text {
            font-size: 9px;
            color: #374151;
            font-weight: 500;
        }

        .pagination-section {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .pagination-btn {
            height: 28px;
            padding: 0 11px;
            border: 1px solid #E5E7EB;
            background: #FFFFFF;
            border-radius: 5px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: #6B7280;
            font-size: 8px;
            cursor: pointer;
            transition: all .2s ease;
        }

            .pagination-btn:hover {
                background: #F3F4F6;
                color: #374151;
            }

        .pagination-next {
            background: #B91C1C;
            color: #FFFFFF;
            border-color: #B91C1C;
            min-width: 55px;
        }

            .pagination-next:hover {
                background: #991B1B;
                color: #FFFFFF;
                border-color: #991B1B;
            }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 1100px) {

            .action-bar {
                flex-wrap: wrap;
            }

            .search-filter {
                width: 100%;
            }

            .search-box {
                max-width: none;
            }

            .status-filter {
                width: 160px;
            }

            .create-btn {
                margin-left: auto;
            }
        }


        @@media (max-width: 768px) {

            body {
                overflow-y: auto;
            }

            .sidebar {
                width: 78px;
                min-width: 78px;
            }

            .system-name,
            .menu a span,
            .dropdown-toggle-menu span,
            .logout a span {
                display: none;
            }

            .logo-section {
                padding: 18px 10px;
            }

            .logo-circle {
                width: 42px;
                height: 42px;
            }

            .menu {
                padding: 15px 10px;
            }

                .menu a {
                    width: 42px;
                    height: 42px;
                    margin: 0 auto 10px auto;
                    padding: 0;
                    justify-content: center;
                }

            .dropdown-toggle-menu {
                justify-content: center;
                padding: 10px;
            }

            .small-arrow {
                display: none;
            }

            .logout a {
                justify-content: center;
            }

            .content-area {
                padding: 14px;
            }

            .action-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-filter {
                width: 100%;
                flex-direction: column;
            }

            .search-box {
                width: 100%;
                max-width: none;
            }

            .status-filter {
                width: 100%;
            }

            .create-btn {
                width: 100%;
                margin-left: 0;
            }

            .table-container {
                overflow-x: auto;
            }

            .user-table {
                min-width: 1050px;
            }
        }


        @@media (max-width: 500px) {

            .profile-info {
                display: none;
            }

            .profile {
                border-left: none;
            }

            .content-area {
                padding: 12px;
            }
        }

    </style>

</head>


<body>

    <div class="dashboard-container">


        <!-- =====================================================
             SIDEBAR
        ====================================================== -->

        <aside class="sidebar">


            <!-- LOGO -->

            <div class="logo-section">

                <div class="logo-circle">

                    <img src="~/Images/newlogo.png"
                         class="logo-img"
                         alt="SORS Logo" />

                </div>

                <div class="system-name">
                    SORS
                </div>

            </div>


            <!-- MENU -->

            <div class="menu">


                <!-- DASHBOARD -->

                <a href="@Url.Action("Dashboard", "Admin")">

                    <i class="bi bi-grid-fill"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- REQUEST -->

                <a href="@Url.Action("RequestManagement", "Admin")">

                    <i class="bi bi-file-earmark-text"></i>

                    <span>
                        Request
                    </span>

                </a>


                <!-- RECORDS -->

                <a href="@Url.Action("RecordsManagement", "Admin")">

                    <i class="bi bi-folder2-open"></i>

                    <span>
                        Records
                    </span>

                </a>


                <!-- REPORTS -->

                <a href="@Url.Action("ReportsManagement", "Admin")">

                    <i class="bi bi-file-earmark-bar-graph"></i>

                    <span>
                        Reports
                    </span>

                </a>


                <!-- AUDIT LOGS -->

                <a href="@Url.Action("AuditLogs", "Admin")">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Audit Logs
                    </span>

                </a>


                <!-- USERS - ACTIVE -->

                <a href="@Url.Action("UsersManagement", "Admin")"
                   class="active">

                    <i class="bi bi-people-fill"></i>

                    <span>
                        Users
                    </span>

                </a>


                <!-- SETTINGS -->

                <div class="sidebar-dropdown">

                    <a href="javascript:void(0)"
                       class="dropdown-toggle-menu">

                        <i class="bi bi-gear-fill"></i>

                        <span>
                            Settings
                        </span>

                        <i class="bi bi-chevron-right ms-auto small-arrow"></i>

                    </a>


                    <div class="dropdown-submenu">

                        <a href="@Url.Action("Settings", "Admin")">

                            <i class="bi bi-sliders"></i>

                            <span>
                                General Settings
                            </span>

                        </a>


                        <a href="@Url.Action("SAccountSettings", "Admin")">

                            <i class="bi bi-person-gear"></i>

                            <span>
                                Account & Security
                            </span>

                        </a>

                    </div>

                </div>

            </div>


            <!-- LOGOUT -->

            <div class="logout">

                <a href="@Url.Action("Login", "Admin")">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>
                        Logout
                    </span>

                </a>

            </div>


        </aside>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <div class="main-content">


            <!-- =================================================
                 TOPBAR
            ================================================== -->

            <div class="topbar">


                <!-- LEFT -->

                <div class="topbar-left">

                    <button class="menu-toggle"
                            id="menuToggle">

                        <i class="bi bi-list"></i>

                    </button>

                </div>


                <!-- RIGHT -->

                <div class="topbar-right">


                    <!-- NOTIFICATION -->

                    <i class="bi bi-bell notification-icon"></i>


                    <!-- PROFILE -->

                    <div class="profile">

                        <img src="~/Images/adminpic.jpg"
                             alt="Profile" />

                        <div class="profile-info">

                            <h5>
                                John Cruz
                            </h5>

                            <span>
                                Administrator
                            </span>

                        </div>

