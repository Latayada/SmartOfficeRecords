@{
    ViewBag.Title = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - SORS</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #eaf6ed; /* Light mint background */
            min-height: 100vh;
            color: #334155;
            padding-top: 70px;
        }

        /* --- NAVBAR STYLING --- */
        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 0;
            z-index: 1030;
            height: 70px;
        }

        /* White Logo Brand Box Container */
        .navbar-left-box {
            display: flex;
            align-items: center;
            width: 260px;
            height: 100%;
            padding: 0 24px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            transition: width 0.3s ease, padding 0.3s ease;
        }

        /* Dedicated Light Green Toggle Zone Box from Image */
        .toggle-zone-box {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            width: 70px;
        }

        .sidebar-toggle-btn {
            background: none;
            border: none;
            color: #16a34a; /* Green hamburger menu icon */
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 10px;
        }

            .navbar-brand-custom img {
                width: 42px;
                height: 42px;
                object-fit: contain;
            }

        .brand-text {
            color: #0f6328;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 0.5px;
        }

        /* --- NAVBAR PROFILE AND UTILITY --- */
        .navbar-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-left: auto;
        }

        .notification-btn {
            background: none;
            border: none;
            color: #64748b;
            font-size: 20px;
            position: relative;
            cursor: pointer;
        }

        .profile-widget {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8fafc;
            padding: 6px 12px;
            border-radius: 30px;
            border: 1px solid #e2e8f0;
            cursor: pointer;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #ffb74d;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 13px;
        }

        .profile-info {
            text-align: left;
            line-height: 1.2;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 600;
            color: #1e293b;
            display: block;
        }

        .profile-email {
            font-size: 10px;
            color: #64748b;
            display: block;
        }

        /*==============================
                      PROFILE DROPDOWN
                ==============================*/

        .profile-container {
            position: relative;
        }

        .profile-widget {
            cursor: pointer;
            user-select: none;
        }

        .profile-arrow {
            transition: .3s;
        }

        .profile-dropdown-custom {
            position: absolute;
            right: 0;
            top: 115%;
            width: 230px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            box-shadow: 0 12px 30px rgba(0,0,0,.08);
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            visibility: hidden;
            transition: max-height .35s ease, opacity .25s ease, transform .25s ease;
            transform: translateY(-10px);
        }

            .profile-dropdown-custom a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 18px;
                text-decoration: none;
                color: #475569;
                font-weight: 500;
                transition: .25s;
            }

                .profile-dropdown-custom a:hover {
                    background: #f0fdf4;
                    color: #16a34a;
                }

                .profile-dropdown-custom a i {
                    font-size: 18px;
                }

        .profile-container.open .profile-dropdown-custom {
            max-height: 200px;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-container.open .profile-arrow {
            transform: rotate(180deg);
        }

        /* --- VERTICAL SIDEBAR MENU STYLING --- */
        .sidebar-menu-wrapper {
            position: fixed;
            top: 70px;
            left: 0;
            bottom: 0;
            width: 260px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            padding: 24px 16px;
            overflow-y: auto;
            z-index: 1020;
            transition: width 0.3s ease, padding 0.3s ease;
        }

        .sidebar-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-link-item {
            text-decoration: none;
            color: #64748b;
            font-weight: 500;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .sidebar-link-item i {
                font-size: 20px;
                min-width: 24px;
                display: inline-flex;
                justify-content: center;
            }

            .sidebar-link-item:hover {
                color: #16a34a;
                background-color: #f0fdf4;
            }

            .sidebar-link-item.active {
                color: #16a34a;
                background-color: #f0fdf4;
                font-weight: 600;
            }

        /* --- LAYOUT WORKSPACE CONTAINER --- */
        .page-container {
            margin-left: 260px;
            max-width: 1300px;
            padding: 40px 30px;
            transition: margin-left 0.3s ease;
        }

        .heading-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
        }

        .page-title {
            color: #16a34a;
            font-size: 28px;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 14px;
            margin: 0;
        }

        /* ==========================================================================
                    DRIVEN COLLAPSE STYLES (Matches image perfectly on toggle click)
                   ========================================================================== */

        /* 1. Logo Box shrinks to a perfectly clean white square */
        body.sidebar-collapsed .navbar-left-box {
            width: 76px;
            padding: 0;
            justify-content: center;
        }

        /* 2. Brand name text drops out cleanly */
        body.sidebar-collapsed .brand-text {
            display: none;
        }

        /* 3. Navigation Sidebar wrapper body collapses down */
        body.sidebar-collapsed .sidebar-menu-wrapper {
            width: 76px;
            padding: 24px 10px;
        }

        body.sidebar-collapsed .sidebar-link-text {
            display: none;
        }

        body.sidebar-collapsed .sidebar-link-item {
            justify-content: center;
            padding: 12px 0;
            gap: 0;
        }

        /* 4. Core layout workspace shifts outward */
        body.sidebar-collapsed .page-container {
            margin-left: 76px;
        }

        /* --- DASHBOARD CONTENT CARDS --- */
        .main-dashboard-box {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
            height: 100%;
        }

        .section-title-custom {
            font-size: 18px;
            font-weight: 700;
            color: #475569;
            margin-bottom: 20px;
        }

        /* --- QUICK ACTIONS STYLING --- */
        .quick-actions-grid {
            display: flex;
            gap: 20px;
            margin-bottom: 45px;
            flex-wrap: wrap;
        }

        .action-card-button {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: flex-start;
            gap: 16px;
            width: 230px;
            height: 75px;
            background-color: #ffffff;
            border: 1.5px solid #a7f3d0;
            border-radius: 8px;
            text-decoration: none;
            color: #1e293b;
            transition: all 0.2s ease;
            padding: 10px 20px;
        }

            .action-card-button:hover {
                background-color: #f0fdf4;
                border-color: #16a34a;
                transform: translateY(-2px);
                color: #16a34a;
            }

            .action-card-button i {
                font-size: 32px;
                color: #16a34a;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .action-card-button span {
                font-size: 11px;
                font-weight: 700;
                line-height: 1.3;
                text-align: left;
                color: #334155;
            }

        /* --- TABLE STYLING --- */
        .recent-request-section {
            margin-top: 20px;
        }

        .custom-table-container {
            border: 1px solid #16a34a;
            border-radius: 8px;
            overflow: hidden;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

            .custom-table th {
                background-color: #eaf6ed;
                color: #000000;
                font-weight: 700;
                font-size: 14px;
                padding: 14px 20px;
                text-align: left;
                border-bottom: 1px solid #16a34a;
            }

            .custom-table td {
                padding: 16px 20px;
                vertical-align: middle;
                font-size: 13px;
                color: #334155;
                background-color: #ffffff;
                font-weight: 500;
            }

        .status-pill-pending {
            background-color: #ffe0b2;
            color: #e65100;
            font-weight: 600;
            font-size: 11px;
            padding: 4px 12px;
            border-radius: 4px;
            display: inline-block;
        }

        .status-pill-approved {
            background-color: #a7f3d0;
            color: #047857;
            font-weight: 600;
            font-size: 11px;
            padding: 4px 12px;
            border-radius: 4px;
            display: inline-block;
        }

        /* --- RIGHT COL SIDEBAR CARDS --- */
        .sidebar-panel {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
            margin-bottom: 24px;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 12px;
        }

            .sidebar-header i {
                color: #16a34a;
                font-size: 18px;
            }

        .sidebar-body {
            font-size: 12px;
            color: #64748b;
            line-height: 1.6;
        }

        .announcements-box {
            background-color: #eaf6ed;
            border: none;
        }

        /* Responsive UI adjustments */
        @@media (max-width: 991px) {
            .toggle-zone-box

        {
            display: none !important;
        }

        .navbar-left-box {
            width: auto !important;
            padding: 0 15px !important;
            border-right: none !important;
        }

        .brand-text {
            display: inline !important;
        }

        .sidebar-menu-wrapper {
            position: static;
            width: 100% !important;
            height: auto;
            border-right: none;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 15px 20px !important;
        }

        .sidebar-links {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 10px;
        }

        .sidebar-link-text {
            display: inline !important;
        }

        .sidebar-link-item {
            padding: 8px 14px !important;
            font-size: 14px;
            justify-content: flex-start !important;
            gap: 12px !important;
        }

        .page-container {
            margin-left: 0 !important;
            padding: 20px;
        }

        }

        /* SETTINGS */
        .sidebar-settings {
            list-style: none;
        }

        .settings-toggle {
            justify-content: space-between;
        }
            /* Parent active */
            .settings-toggle.active {
                background: #f0fdf4;
                color: #16a34a;
                font-weight: 600;
            }
        /* Child active */
        .settings-submenu a.active {
            background: #f0fdf4;
            color: #16a34a;
            font-weight: 600;
        }

        .settings-arrow {
            font-size: 14px;
            transition: .3s;
            color: #64748b;
        }

        .settings-submenu {
            list-style: none;
            padding-left: 18px;
            margin-top: 5px;
            max-height: 0;
            overflow: hidden;
            transition: max-height .35s ease;
        }


            .settings-submenu li {
                margin: 5px 0;
            }

            .settings-submenu a {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                color: #64748b;
                padding: 10px 15px;
                border-radius: 8px;
                font-size: 14px;
                transition: .3s;
            }

                .settings-submenu a:hover {
                    background: #f0fdf4;
                    color: #16a34a;
                }

        .sidebar-settings.open .settings-submenu {
            max-height: 200px;
        }

        .sidebar-settings.open .settings-arrow {
            transform: rotate(90deg);
        }

        /* Hide submenu text when sidebar collapses */
        body.sidebar-collapsed .settings-submenu {
            display: none !important;
        }

        body.sidebar-collapsed .settings-arrow {
            display: none;
        }
    </style>
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top d-flex flex-row align-items-center justify-content-start">

        <!-- Left Brand Logo Panel (White background box) -->
        <div class="navbar-left-box" id="navLeftBox">
            <a class="navbar-brand-custom" href="#">
                <img src="~/Images/logo.png" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <div class="brand-text" id="brandText">SORS</div>
            </a>
        </div>

        <!-- Menu Toggle Area Container (Light Green Background Strip) -->
        <div class="toggle-zone-box">
            <button class="sidebar-toggle-btn" id="toggleSidebar" title="Toggle Menu">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <!-- Right Profile/Notification Actions -->
        <div class="navbar-profile pe-4">
            <button class="notification-btn" title="Notifications">
                <i class="bi bi-bell"></i>
            </button>

            <div class="profile-container">

                <div class="profile-widget" id="profileToggle">

                    <div class="profile-avatar">
                        MG
                    </div>

                    <div class="profile-info">
                        <span class="profile-name">Mary Grace</span>
                        <span class="profile-email">smartoffice@gmail.com</span>
                    </div>

                    <i class="bi bi-chevron-down profile-arrow ms-2"></i>

                </div>

                <div class="profile-dropdown-custom" id="profileMenu">

                    <a href="@Url.Action("MyAccount", "Applicant")">
                        <i class="bi bi-person-circle"></i>
                        My Account
                    </a>

                    <a href="@Url.Action("ApplicantLogin", "Applicant")" class="text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        Sign Out
                    </a>

                </div>

            </div>
        </div>
    </nav>

    <!-- LEFT SIDEBAR NAV MENU -->
    <aside class="sidebar-menu-wrapper" id="sidebarMenu">
        <ul class="sidebar-links">
            <li>
                <a href="@Url.Action("ApplicantDash", "Applicant")" class="sidebar-link-item active">
                    <i class="bi bi-house-door-fill"></i>
                    <span class="sidebar-link-text">Home</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("BookInterview", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                    <span class="sidebar-link-text">Book Interview</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("MyAppointment", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-person-bounding-box"></i>
                    <span class="sidebar-link-text">My Appointment</span>
                </a>
            </li>

            <!-- Open by default on Settings page -->
            <li class="sidebar-settings">
                <div class="sidebar-link-item settings-toggle">

                    <a href="@Url.Action("Settings", "Applicant")"
                       class="d-flex align-items-center flex-grow-1 text-decoration-none text-reset">

                        <i class="bi bi-gear-fill"></i>
                        <span class="sidebar-link-text ms-2">
                            Settings & Account
                        </span>

                    </a>

                    <i class="bi bi-chevron-right settings-arrow"
                       id="settingsToggle"></i>

                </div>

                <ul class="settings-submenu" id="settingsMenu">
                    <li>
                        <a href="@Url.Action("Settings", "Applicant")" id="settingsLink">
                            <i class="bi bi-shield-lock"></i>
                            <span class="sidebar-link-text">Settings</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("MyAccount", "Applicant")">
                            <i class="bi bi-person-circle"></i>
                            <span class="sidebar-link-text">My Account</span>
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
    </aside>

    <!-- WORKSPACE MAIN CONTENT AREA -->
    <main class="page-container" id="mainContent">

        <div class="heading-section mb-4">
            <div>
                <h1 class="page-title">Welcome Mary!</h1>
                <p class="page-subtitle">Here's what's happening with your interviews and records today.</p>
            </div>
        </div>

        <div class="row g-4">
            <!-- Left Column: Main Dashboard Features (Col-8) -->
            <div class="col-lg-8">
                <div class="main-dashboard-box">

                    <!-- Quick Actions -->
                    <h5 class="section-title-custom">Quick Actions</h5>
                    <div class="quick-actions-grid">
                        <a href="@Url.Action("BookInterview", "Applicant")" class="action-card-button">
                            <i class="bi bi-funnel-fill"></i>
                            <span>Submit New Request</span>
                        </a>
                        <a href="@Url.Action("MyAppointment", "Applicant")" class="action-card-button">
                            <i class="bi bi-folder-fill"></i>
                            <span>My Request</span>
                        </a>
                        <a href="#" class="action-card-button">
                            <i class="bi bi-box-arrow-down"></i>
                            <span>Download Approved Documents</span>
                        </a>
                    </div>

                    <!-- Recent Request Table -->
                    <div class="recent-request-section">
                        <h5 class="section-title-custom">Recent Request</h5>

                        <div class="custom-table-container">
                            <table class="custom-table">
                                <thead>
                                    <tr>
                                        <th style="width: 25%;">Request ID</th>
                                        <th style="width: 25%;">Service</th>
                                        <th style="width: 30%;">Date Submitted</th>
                                        <th style="width: 20%;">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>RI01</td>
                                        <td>RI01</td>
                                        <td>July 15, 2026</td>
                                        <td><span class="status-pill-pending">Pending</span></td>
                                    </tr>
                                    <tr>
                                        <td>RI01</td>
                                        <td>RI01</td>
                                        <td>July 15, 2026</td>
                                        <td><span class="status-pill-approved">Approved</span></td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>

            <!-- Right Column: Sidebar Panels (Col-4) -->
            <div class="col-lg-4">
                <!-- Announcements Card -->
                <div class="sidebar-panel announcements-box">
                    <div class="sidebar-header">
                        <i class="bi bi-megaphone-fill"></i> Announcements
                    </div>
                    <div class="sidebar-body">
                        Office holiday schedule updated. (August 04, 2030)
                    </div>
                </div>

                <!-- Office Info Card -->
                <div class="sidebar-panel">
                    <div class="sidebar-header">
                        <i class="bi bi-info-circle-fill"></i> Office Info
                    </div>
                    <div class="sidebar-body">
                        Office holiday schedule updated. (August 04, 2030)
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Toggle Script Logic -->
    <script>
        
        //Top menu toggle
        document.getElementById('toggleSidebar').addEventListener('click', function () {
            document.body.classList.toggle('sidebar-collapsed');
        });

        // Settings expand/collapse
        const settingsToggle = document.getElementById("settingsToggle");
        const settingsParent = document.querySelector(".settings-toggle");
        const settingsGroup = document.querySelector(".sidebar-settings");
        const settingsLink = document.getElementById("settingsLink");

        // Open Settings menu
        settingsToggle.addEventListener("click", function (e) {

            e.preventDefault();
            e.stopPropagation();

            settingsGroup.classList.toggle("open");

            // Make Settings & Account active
            settingsParent.classList.add("active");
        });

        // Click Settings
        settingsLink.addEventListener("click", function () {

            // Parent remains active
            settingsParent.classList.add("active");

            // Child becomes active
            settingsLink.classList.add("active");

        });

        //Profile dropdown
                const profileContainer = document.querySelector(".profile-container");
        const profileToggle = document.getElementById("profileToggle");

        profileToggle.addEventListener("click", function (e) {

            e.stopPropagation();

            profileContainer.classList.toggle("open");

        });

        document.addEventListener("click", function (e) {

            if (!profileContainer.contains(e.target)) {

                profileContainer.classList.remove("open");

            }

        });
    </script>
</body>
</html>