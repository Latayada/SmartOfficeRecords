@{
    ViewBag.Title = "Book Interview";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Book Interview - SORS</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- BOOTSTRAP ICONS -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- POPPINS -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">





    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f1f1f1;
            color: #263238;
            min-height: 100vh;
            overflow-x: hidden;
        }

        a {
            text-decoration: none;
        }

        :root {
            --red: #ed1c24;
            --red-dark: #c9151c;
            --red-light: #fff1f1;
            --sidebar: #222b30;
            --sidebar-hover: #2d373d;
            --white: #ffffff;
            --black-gray: #263238;
            --dark-gray: #455a64;
            --gray: #78909c;
            --light-gray: #eceff1;
            --border: #e1e5e8;
            --page-bg: #f1f1f1;
        }


        /* =========================================================
                   TOP NAVBAR
                ========================================================= */

        .navbar-custom {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 56px;
            background: var(--white);
            border-bottom: 1px solid #e0e0e0;
            display: flex;
            align-items: center;
            z-index: 1030;
            padding: 0;
        }


        /* =========================================================
                   LEFT LOGO BOX
                ========================================================= */

        .navbar-left-box {
            width: 155px;
            height: 56px;
            background: var(--sidebar);
            display: flex;
            align-items: center;
            padding: 0 15px;
            border-right: 1px solid #39434a;
            transition: all .3s ease;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

            .navbar-brand-custom img {
                width: 34px;
                height: 34px;
                object-fit: contain;
                border-radius: 50%;
            }

        .brand-text {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: .4px;
        }


        /* =========================================================
                   HAMBURGER
                ========================================================= */

        .toggle-zone-box {
            height: 56px;
            width: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #ffffff;
        }

        .sidebar-toggle-btn {
            border: none;
            background: transparent;
            color: var(--red);
            font-size: 18px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: .2s ease;
        }

            .sidebar-toggle-btn:hover {
                color: var(--red-dark);
            }


        /* =========================================================
                   NAVBAR RIGHT
                ========================================================= */

        .navbar-profile {
            margin-left: auto;
            height: 56px;
            display: flex;
            align-items: center;
            gap: 15px;
            padding-right: 15px;
        }


        /* =========================================================
                   NOTIFICATION
                ========================================================= */

        .notification-container {
            position: relative;
        }

        .notification-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: transparent;
            color: var(--dark-gray);
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: .2s ease;
        }

            .notification-btn:hover {
                color: var(--red);
            }

        .notification-badge-dot {
            position: absolute;
            top: 8px;
            right: 7px;
            width: 7px;
            height: 7px;
            background: var(--red);
            border-radius: 50%;
            border: 1px solid white;
        }


        /* =========================================================
                   NOTIFICATION DROPDOWN
                ========================================================= */

        .notification-dropdown-custom {
            position: absolute;
            right: 0;
            top: 48px;
            width: 330px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all .25s ease;
            z-index: 1050;
        }

        .notification-container.open .notification-dropdown-custom {
            max-height: 450px;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .notif-header {
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid #eeeeee;
        }

        .notif-header-title {
            color: var(--black-gray);
            font-size: 13px;
            font-weight: 700;
        }

        .notif-mark-read {
            color: var(--red);
            font-size: 10px;
            font-weight: 600;
        }

            .notif-mark-read:hover {
                color: var(--red-dark);
            }

        .notif-body {
            max-height: 300px;
            overflow-y: auto;
        }

        .notif-item {
            display: flex;
            gap: 10px;
            padding: 12px 15px;
            border-bottom: 1px solid #f1f1f1;
            color: inherit;
            transition: .2s ease;
        }

            .notif-item:hover {
                background: var(--red-light);
            }

        .notif-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .notif-icon-success {
            background: #e8f5e9;
            color: #43a047;
        }

        .notif-icon-warning {
            background: #fff3e0;
            color: #fb8c00;
        }

        .notif-text {
            color: var(--dark-gray);
            font-size: 11px;
            line-height: 1.4;
        }

        .notif-time {
            color: #9e9e9e;
            font-size: 9px;
            margin-top: 3px;
        }

        .notif-footer {
            padding: 10px;
            text-align: center;
            background: #fafafa;
            border-top: 1px solid #eeeeee;
        }

        .notif-footer-btn {
            color: var(--red);
            font-size: 11px;
            font-weight: 600;
        }


        /* =========================================================
                   PROFILE
                ========================================================= */

        .profile-container {
            position: relative;
        }

        .profile-widget {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 8px;
            border-radius: 20px;
            background: #f5f5f5;
            border: 1px solid #e3e3e3;
            cursor: pointer;
            transition: .2s ease;
        }

            .profile-widget:hover {
                background: #eeeeee;
            }

        .profile-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #ffb52e;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
        }

        .profile-info {
            line-height: 1.1;
        }

        .profile-name {
            display: block;
            color: var(--black-gray);
            font-size: 10px;
            font-weight: 700;
        }

        .profile-email {
            display: block;
            color: #78909c;
            font-size: 8px;
        }

        .profile-arrow {
            color: #546e7a;
            font-size: 11px;
            transition: .3s;
        }

        .profile-dropdown-custom {
            position: absolute;
            right: 0;
            top: 48px;
            width: 200px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,.12);
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: all .25s ease;
            z-index: 1050;
        }

        .profile-container.open .profile-dropdown-custom {
            max-height: 200px;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-container.open .profile-arrow {
            transform: rotate(180deg);
        }

        .profile-dropdown-custom a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 15px;
            color: var(--dark-gray);
            font-size: 12px;
            font-weight: 500;
            transition: .2s ease;
        }

            .profile-dropdown-custom a:hover {
                background: var(--red-light);
                color: var(--red);
            }

            .profile-dropdown-custom a i {
                font-size: 16px;
            }


        /* =========================================================
                   SIDEBAR
                ========================================================= */

        .sidebar-menu-wrapper {
            position: fixed;
            top: 56px;
            left: 0;
            bottom: 0;
            width: 155px;
            background: var(--sidebar);
            border-right: 1px solid #39434a;
            padding: 15px 8px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1020;
            transition: all .3s ease;
        }

            .sidebar-menu-wrapper::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-menu-wrapper::-webkit-scrollbar-track {
                background: var(--sidebar);
            }

            .sidebar-menu-wrapper::-webkit-scrollbar-thumb {
                background: #45545d;
                border-radius: 10px;
            }

        .sidebar-links {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 10px;
            border-radius: 5px;
            color: #ffffff;
            font-size: 12px;
            font-weight: 500;
            white-space: nowrap;
            transition: all .2s ease;
        }

            .sidebar-link-item i {
                width: 17px;
                min-width: 17px;
                font-size: 14px;
                display: inline-flex;
                justify-content: center;
            }

            .sidebar-link-item:hover {
                color: var(--red);
                background: rgba(237, 28, 36, .08);
            }

            /* BOOK INTERVIEW ACTIVE */
            .sidebar-link-item.active {
                color: var(--red);
                background: transparent;
                font-weight: 600;
            }


        /* =========================================================
                   SETTINGS
                ========================================================= */

        .sidebar-settings {
            list-style: none;
        }

        .settings-toggle {
            justify-content: space-between;
            cursor: pointer;
        }

            .settings-toggle > a {
                color: #ffffff !important;
            }

                .settings-toggle > a:hover {
                    color: var(--red) !important;
                }

            .settings-toggle.active {
                color: var(--red);
                background: rgba(237,28,36,.08);
            }

                .settings-toggle.active > a {
                    color: var(--red) !important;
                }

        .settings-arrow {
            color: #ffffff;
            font-size: 11px;
            transition: .3s;
        }

        .settings-toggle:hover .settings-arrow {
            color: var(--red);
        }

        .settings-submenu {
            list-style: none;
            padding: 0 0 0 12px;
            margin: 2px 0 0 0;
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
        }

            .settings-submenu li {
                margin: 2px 0;
            }

            .settings-submenu a {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 9px;
                border-radius: 5px;
                color: #ffffff !important;
                font-size: 11px;
                font-weight: 500;
                transition: .2s ease;
            }

                .settings-submenu a:hover {
                    background: rgba(237,28,36,.10);
                    color: var(--red) !important;
                }

                .settings-submenu a i {
                    color: #ffffff;
                    font-size: 12px;
                }

                .settings-submenu a:hover i {
                    color: var(--red);
                }

                .settings-submenu a.active {
                    color: var(--red) !important;
                    background: rgba(237,28,36,.10);
                }

                    .settings-submenu a.active i {
                        color: var(--red);
                    }

        .sidebar-settings.open .settings-submenu {
            max-height: 150px;
        }

        .sidebar-settings.open .settings-arrow {
            transform: rotate(90deg);
        }


        /* =========================================================
                   LOGOUT
                ========================================================= */

        .logout-wrapper {
            position: absolute;
            bottom: 15px;
            left: 8px;
            right: 8px;
        }

        .logout-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px;
            color: #ffffff;
            font-size: 12px;
            font-weight: 500;
            border-radius: 5px;
            transition: .2s ease;
        }

            .logout-link:hover {
                color: var(--red);
                background: rgba(237,28,36,.08);
            }

            .logout-link i {
                font-size: 16px;
            }


        /* =========================================================
                   MAIN CONTENT
                   BASED ON YOUR IMAGE
                ========================================================= */

        .page-container {
            margin-left: 155px;
            padding: 78px 18px 35px 18px;
            min-height: 100vh;
            transition: margin-left .3s ease;
        }


        /* =========================================================
                   PAGE HEADING
                ========================================================= */

        .heading-section {
            margin-bottom: 18px;
        }

        .page-title {
            color: var(--black-gray);
            font-size: 21px;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .page-subtitle {
            color: #607d8b;
            font-size: 10px;
            font-weight: 500;
            margin: 0;
        }


        /* =========================================================
                   BOOKING LAYOUT
                ========================================================= */

        .booking-layout {
            display: grid;
            grid-template-columns: minmax(0, 2.2fr) minmax(220px, .78fr);
            gap: 12px;
            align-items: start;
        }


        /* =========================================================
                   BOOKING CARD
                ========================================================= */

        .booking-card {
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 9px;
            padding: 16px 17px 20px;
            box-shadow: 0 3px 15px rgba(0,0,0,.05);
        }

        .booking-card-header {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 18px;
        }

        .booking-card-icon {
            width: 26px;
            height: 26px;
            border-radius: 5px;
            background: #ffffff;
            border: 2px solid #455a64;
            color: #455a64;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
        }

        .booking-card-title {
            color: #263238;
            font-size: 13px;
            font-weight: 700;
        }


        /* =========================================================
                   SECTION TITLE
                ========================================================= */

        .form-section {
            margin-bottom: 18px;
        }

        .form-section-title {
            color: #263238;
            font-size: 12px;
            font-weight: 700;
            padding-bottom: 8px;
            border-bottom: 1px solid #e1e5e8;
            margin-bottom: 15px;
        }


        /* =========================================================
                   FORM LABEL
                ========================================================= */

        .form-label-custom {
            display: block;
            color: #37474f;
            font-size: 10px;
            font-weight: 600;
            margin-bottom: 6px;
        }


        /* =========================================================
                   INPUT WRAPPER
                ========================================================= */

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: #78909c;
            font-size: 14px;
            pointer-events: none;
            z-index: 2;
        }

        .form-control-custom {
            width: 100%;
            height: 38px;
            border: 1px solid #d8dde0;
            border-radius: 7px;
            background: #ffffff;
            color: #455a64;
            font-size: 10px;
            padding: 0 12px 0 36px;
            outline: none;
            box-shadow: 0 2px 6px rgba(0,0,0,.10);
            transition: all .2s ease;
        }

            .form-control-custom::placeholder {
                color: #a0a8ad;
            }

            .form-control-custom:focus {
                border-color: var(--red);
                box-shadow: 0 0 0 3px rgba(237,28,36,.08);
            }


        /* =========================================================
                   FILE INPUT
                ========================================================= */

        .file-input-wrapper {
            position: relative;
            display: flex;
            height: 38px;
            border: 1px solid #d8dde0;
            border-radius: 7px;
            overflow: hidden;
            background: #ffffff;
            box-shadow: 0 2px 6px rgba(0,0,0,.10);
        }

        .file-input-label {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 12px;
            color: #a0a8ad;
            font-size: 10px;
            cursor: pointer;
            overflow: hidden;
            white-space: nowrap;
        }

            .file-input-label i {
                color: #78909c;
                font-size: 14px;
            }

        .file-input-wrapper input[type="file"] {
            position: absolute;
            width: 1px;
            height: 1px;
            opacity: 0;
        }

        .browse-btn {
            width: 66px;
            border: none;
            background: var(--red);
            color: #ffffff;
            font-size: 10px;
            font-weight: 600;
            cursor: pointer;
            transition: .2s ease;
        }

            .browse-btn:hover {
                background: var(--red-dark);
            }


        /* =========================================================
                   DATE / TIME INPUT
                ========================================================= */

        .form-control-custom[type="date"],
        .form-control-custom[type="time"] {
            color: #78909c;
            padding-right: 32px;
        }

            .form-control-custom[type="date"]::-webkit-calendar-picker-indicator,
            .form-control-custom[type="time"]::-webkit-calendar-picker-indicator {
                opacity: .55;
                cursor: pointer;
            }


        /* =========================================================
                   TEXTAREA
                ========================================================= */

        .textarea-custom {
            width: 100%;
            min-height: 46px;
            resize: vertical;
            border: 1px solid #d8dde0;
            border-radius: 7px;
            background: #ffffff;
            color: #455a64;
            font-size: 10px;
            padding: 12px;
            outline: none;
            box-shadow: 0 2px 6px rgba(0,0,0,.10);
            transition: all .2s ease;
        }

            .textarea-custom::placeholder {
                color: #a0a8ad;
            }

            .textarea-custom:focus {
                border-color: var(--red);
                box-shadow: 0 0 0 3px rgba(237,28,36,.08);
            }


        /* =========================================================
                   FORM BUTTONS
                ========================================================= */

        .booking-actions {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 10px;
            margin-top: 18px;
        }

        .btn-reset {
            min-width: 184px;
            height: 38px;
            border: 1px solid #ff6b70;
            border-radius: 7px;
            background: #ffffff;
            color: var(--red);
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: all .2s ease;
        }

            .btn-reset:hover {
                background: var(--red-light);
            }

        .btn-submit {
            min-width: 184px;
            height: 38px;
            border: none;
            border-radius: 7px;
            background: var(--red);
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            box-shadow: 0 4px 10px rgba(237,28,36,.18);
            transition: all .2s ease;
        }

            .btn-submit:hover {
                background: var(--red-dark);
                transform: translateY(-1px);
                box-shadow: 0 5px 13px rgba(237,28,36,.22);
            }


        /* =========================================================
                   RIGHT SIDE CARDS
                ========================================================= */

        .right-side {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }


        /* =========================================================
                   REMINDER
                ========================================================= */

        .reminder-card {
            background: #fff6f6;
            border: 1px solid #ffc5c7;
            border-radius: 7px;
            padding: 13px;
        }

        .side-card-header {
            display: flex;
            align-items: center;
            gap: 9px;
            color: #263238;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 8px;
        }

            .side-card-header i {
                color: var(--red);
                font-size: 14px;
            }

        .reminder-text {
            color: #78909c;
            font-size: 9px;
            line-height: 1.5;
            margin: 0;
        }


        /* =========================================================
                   GUIDELINES
                ========================================================= */

        .guideline-card {
            background: #ffffff;
            border: 1px solid #e5e5e5;
            border-radius: 7px;
            padding: 13px;
            box-shadow: 0 2px 8px rgba(0,0,0,.03);
        }

        .guideline-list {
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .guideline-item {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            padding: 8px 0;
            border-bottom: 1px solid #eeeeee;
        }

            .guideline-item:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .guideline-icon {
            width: 15px;
            min-width: 15px;
            color: var(--red);
            font-size: 12px;
            margin-top: 2px;
        }

        .guideline-content {
            flex: 1;
        }

        .guideline-title {
            display: block;
            color: #37474f;
            font-size: 10px;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .guideline-description {
            display: block;
            color: #78909c;
            font-size: 8.5px;
            line-height: 1.35;
        }


        /* =========================================================
                   SIDEBAR COLLAPSE
                ========================================================= */

        body.sidebar-collapsed .navbar-left-box {
            width: 60px;
            padding: 0;
            justify-content: center;
        }

        body.sidebar-collapsed .brand-text {
            display: none;
        }

        body.sidebar-collapsed .sidebar-menu-wrapper {
            width: 60px;
            padding-left: 6px;
            padding-right: 6px;
        }

        body.sidebar-collapsed .sidebar-link-item {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
            gap: 0;
        }

        body.sidebar-collapsed .sidebar-link-text {
            display: none;
        }

        body.sidebar-collapsed .settings-arrow {
            display: none;
        }

        body.sidebar-collapsed .settings-submenu {
            display: none !important;
        }

        body.sidebar-collapsed .logout-link {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
        }

        body.sidebar-collapsed .logout-text {
            display: none;
        }

        body.sidebar-collapsed .page-container {
            margin-left: 60px;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 1000px) {

            .navbar-left-box {
                width: 210px;
            }

            .sidebar-menu-wrapper {
                width: 210px;
            }

            .page-container {
                margin-left: 210px;
            }

            body.sidebar-collapsed .page-container {
                margin-left: 60px;
            }

            .booking-layout {
                grid-template-columns: 1fr;
            }

            .right-side {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }
        }


        @@media (max-width: 700px) {

            .navbar-left-box {
                width: 60px;
                padding: 0;
                justify-content: center;
            }

            .brand-text {
                display: none;
            }

            .sidebar-menu-wrapper {
                width: 60px;
            }

            .sidebar-link-item {
                justify-content: center;
                padding: 11px 0;
                gap: 0;
            }

            .sidebar-link-text {
                display: none;
            }

            .settings-arrow {
                display: none;
            }

            .settings-submenu {
                display: none !important;
            }

            .page-container {
                margin-left: 60px;
                padding: 75px 12px 25px;
            }

            .profile-info {
                display: none;
            }

            .profile-widget {
                padding: 4px;
            }

            .booking-card {
                padding: 14px;
            }

            .right-side {
                display: flex;
            }

            .booking-actions {
                flex-direction: column;
            }

            .btn-reset,
            .btn-submit {
                width: 100%;
            }
        }


        @@media (max-width: 500px) {

            .navbar-profile {
                gap: 5px;
                padding-right: 7px;
            }

            .notification-dropdown-custom {
                width: 280px;
                right: -60px;
            }

            .profile-dropdown-custom {
                right: -5px;
            }

            .page-title {
                font-size: 18px;
            }

            .page-subtitle {
                font-size: 9px;
            }
        }

    </style>

</head>


<body>


    <!-- =========================================================
         TOP NAVBAR
    ========================================================== -->

    <nav class="navbar-custom">


        <!-- LOGO -->

        <div class="navbar-left-box">

            <a class="navbar-brand-custom"
               href="@Url.Action("ApplicantDash", "Applicant")">

                <img src="~/Images/logo.png"
                     alt="SORS Logo"
                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />

                <span class="brand-text">
                    SORS
                </span>

            </a>

        </div>


        <!-- HAMBURGER -->

        <div class="toggle-zone-box">

            <button class="sidebar-toggle-btn"
                    id="toggleSidebar"
                    type="button"
                    title="Toggle Sidebar">

                <i class="bi bi-list"></i>

            </button>

        </div>


        <!-- RIGHT NAVIGATION -->

        <div class="navbar-profile">


            <!-- NOTIFICATION -->

            <div class="notification-container">

                <button class="notification-btn"
                        id="notificationToggle"
                        type="button"
                        title="Notifications">

                    <i class="bi bi-bell"></i>

                    <span class="notification-badge-dot"></span>

                </button>


                <!-- NOTIFICATION DROPDOWN -->

                <div class="notification-dropdown-custom"
                     id="notificationMenu">

                    <div class="notif-header">

                        <span class="notif-header-title">
                            Notifications
                        </span>

                        <a href="#"
                           class="notif-mark-read">
                            Mark all as read
                        </a>

                    </div>


                    <div class="notif-body">

                        <a href="#"
                           class="notif-item">

                            <div class="notif-icon-box notif-icon-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>

                            <div>

                                <div class="notif-text">
                                    Your interview request has been approved.
                                </div>

                                <div class="notif-time">
                                    10 mins ago
                                </div>

                            </div>

                        </a>


                        <a href="#"
                           class="notif-item">

                            <div class="notif-icon-box notif-icon-warning">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div>

                                <div class="notif-text">
                                    Reminder: Check your interview schedule.
                                </div>

                                <div class="notif-time">
                                    2 hours ago
                                </div>

                            </div>

                        </a>

                    </div>


                    <div class="notif-footer">

                        <a href="#"
                           class="notif-footer-btn">
                            View All Notifications
                        </a>

                    </div>

                </div>

            </div>


            <!-- PROFILE -->

            <div class="profile-container">

                <div class="profile-widget"
                     id="profileToggle">

                    <div class="profile-avatar">
                        JC
                    </div>

                    <div class="profile-info">

                        <span class="profile-name">
                            John Cruz
                        </span>

                        <span class="profile-email">
                            johncruz@gmail.com
                        </span>

                    </div>

                    <i class="bi bi-chevron-down profile-arrow"></i>

                </div>


                <!-- PROFILE DROPDOWN -->

                <div class="profile-dropdown-custom"
                     id="profileMenu">

                    <a href="@Url.Action("MyAccount", "Applicant")">

                        <i class="bi bi-person-circle"></i>

                        My Account

                    </a>

                    <a href="@Url.Action("ApplicantLogin", "Applicant")">

                        <i class="bi bi-box-arrow-right"></i>

                        Sign Out

                    </a>

                </div>

            </div>

        </div>

    </nav>



    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar-menu-wrapper"
           id="sidebarMenu">


        <ul class="sidebar-links">


            <!-- DASHBOARD -->

            <li>

                <a href="@Url.Action("ApplicantDash", "Applicant")"
                   class="sidebar-link-item">

                    <i class="bi bi-house-door-fill"></i>

                    <span class="sidebar-link-text">
                        Dashboard
                    </span>

                </a>

            </li>


            <!-- BOOK INTERVIEW -->

            <li>

                <a href="@Url.Action("BookInterview", "Applicant")"
                   class="sidebar-link-item active">

                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>

                    <span class="sidebar-link-text">
                        Book Interview
                    </span>

                </a>

            </li>


            <!-- MY APPOINTMENT -->

            <li>

                <a href="@Url.Action("MyAppointment", "Applicant")"
                   class="sidebar-link-item">

                    <i class="bi bi-person-bounding-box"></i>

                    <span class="sidebar-link-text">
                        My Appointment
                    </span>

                </a>

            </li>


            <!-- SETTINGS -->

            <li class="sidebar-settings">

                <div class="sidebar-link-item settings-toggle"
                     id="settingsToggle">

                    <a href="@Url.Action("Settings", "Applicant")"
                       class="d-flex align-items-center flex-grow-1 text-decoration-none">

                        <i class="bi bi-gear-fill"></i>

                        <span class="sidebar-link-text ms-2">
                            Settings
                        </span>

                    </a>

                    <i class="bi bi-chevron-right settings-arrow"></i>

                </div>


                <!-- SETTINGS SUBMENU -->

                <ul class="settings-submenu"
                    id="settingsMenu">

                    <li>

                        <a href="@Url.Action("Settings", "Applicant")">

                            <i class="bi bi-shield-lock"></i>

                            <span class="sidebar-link-text">
                                General Settings
                            </span>

                        </a>

                    </li>


                    <li>

                        <a href="@Url.Action("MyAccount", "Applicant")">

                            <i class="bi bi-person-circle"></i>

                            <span class="sidebar-link-text">
                                My Account
                            </span>

                        </a>

                    </li>

                </ul>

            </li>

        </ul>


        <!-- LOGOUT -->

        <div class="logout-wrapper">

            <a href="@Url.Action("ApplicantLogin", "Applicant")"
               class="logout-link">

                <i class="bi bi-box-arrow-right"></i>

                <span class="logout-text">
                    Logout
                </span>

            </a>

        </div>

    </aside>



    <!-- =========================================================
         MAIN CONTENT
    ========================================================== -->

    <main class="page-container">


        <!-- PAGE HEADING -->

        <div class="heading-section">

            <h1 class="page-title">
                Book Interview
            </h1>

            <p class="page-subtitle">
                Fill out the form below to schedule your interview.
            </p>

        </div>



        <!-- =====================================================
             BOOKING LAYOUT
        ====================================================== -->

        <div class="booking-layout">


            <!-- =================================================
                 LEFT : BOOKING FORM
            ================================================== -->

            <div class="booking-card">


                <!-- CARD HEADER -->

                <div class="booking-card-header">

                    <div class="booking-card-icon">

                        <i class="bi bi-card-checklist"></i>

                    </div>

                    <div class="booking-card-title">
                        Interview Booking Form
                    </div>

                </div>



                <!-- =================================================
                     PERSONAL INFORMATION
                ================================================== -->

                <div class="form-section">

                    <div class="form-section-title">
                        Personal Information
                    </div>


                    <div class="row g-3">


                        <!-- FULL NAME -->

                        <div class="col-md-6">

                            <label class="form-label-custom">
                                Full name
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-person input-icon"></i>

                                <input type="text"
                                       name="FullName"
                                       class="form-control-custom"
                                       placeholder="Enter full name" />

                            </div>

                        </div>


                        <!-- CONTACT NUMBER -->

                        <div class="col-md-6">

                            <label class="form-label-custom">
                                Contact Number
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-telephone input-icon"></i>

                                <input type="text"
                                       name="ContactNumber"
                                       class="form-control-custom"
                                       placeholder="Enter Contact Number" />

                            </div>

                        </div>


                        <!-- EMAIL -->

                        <div class="col-md-6">

                            <label class="form-label-custom">
                                Email Address
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-envelope input-icon"></i>

                                <input type="email"
                                       name="Email"
                                       class="form-control-custom"
                                       placeholder="Enter your email address" />

                            </div>

                        </div>


                        <!-- RESUME -->

                        <div class="col-md-6">

                            <label class="form-label-custom">
                                Upload Resume (PDF, DOC, DOCX)
                            </label>

                            <div class="file-input-wrapper">

                                <label class="file-input-label"
                                       for="resumeFile">

                                    <i class="bi bi-file-earmark"></i>

                                    <span id="fileName">
                                        Choose File
                                    </span>

                                </label>

                                <button type="button"
                                        class="browse-btn"
                                        onclick="document.getElementById('resumeFile').click();">

                                    Browse

                                </button>

                                <input type="file"
                                       id="resumeFile"
                                       name="Resume"
                                       accept=".pdf,.doc,.docx" />

                            </div>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     INTERVIEW DETAILS
                ================================================== -->

                <div class="form-section">

                    <div class="form-section-title">
                        Interview Details
                    </div>


                    <div class="row g-3">


                        <!-- DATE -->

                        <div class="col-md-6">

                            <label class="form-label-custom">
                                Preferred Interview Date
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-calendar3 input-icon"></i>

                                <input type="date"
                                       name="InterviewDate"
                                       class="form-control-custom" />

                            </div>

                        </div>


                        <!-- TIME -->

                        <div class="col-md-6">

                            <label class="form-label-custom">
                                Preferred Time
                            </label>

                            <div class="input-wrapper">

                                <i class="bi bi-clock input-icon"></i>

                                <select name="InterviewTime"
                                        class="form-control-custom">

                                    <option value="">
                                        Select Time
                                    </option>

                                    <option value="08:00 AM">
                                        08:00 AM
                                    </option>

                                    <option value="09:00 AM">
                                        09:00 AM
                                    </option>

                                    <option value="10:00 AM">
                                        10:00 AM
                                    </option>

                                    <option value="11:00 AM">
                                        11:00 AM
                                    </option>

                                    <option value="01:00 PM">
                                        01:00 PM
                                    </option>

                                    <option value="02:00 PM">
                                        02:00 PM
                                    </option>

                                    <option value="03:00 PM">
                                        03:00 PM
                                    </option>

                                    <option value="04:00 PM">
                                        04:00 PM
                                    </option>

                                </select>

                            </div>

                        </div>


                    </div>

                </div>



                <!-- =================================================
                     ADDITIONAL NOTES
                ================================================== -->

                <div class="form-section">

                    <label class="form-label-custom">
                        Additional Notes (Optional)
                    </label>

                    <textarea name="AdditionalNotes"
                              class="textarea-custom"
                              placeholder="Enter any additional notes...."></textarea>

                </div>



                <!-- =================================================
                     BUTTONS
                ================================================== -->

                <div class="booking-actions">

                    <button type="reset"
                            class="btn-reset">

                        Reset

                    </button>

                    <button type="submit"
                            class="btn-submit">

                        Submit Booking

                    </button>

                </div>


            </div>



            <!-- =================================================
                 RIGHT SIDE
            ================================================== -->

            <div class="right-side">


                <!-- =================================================
                     REMINDER
                ================================================== -->

                <div class="reminder-card">

                    <div class="side-card-header">

                        <i class="bi bi-info-circle-fill"></i>

                        <span>
                            Reminder
                        </span>

                    </div>

                    <p class="reminder-text">

                        Please provide accurate information.
                        You will receive a confirmation once your
                        booking is successfully submitted.

                    </p>

                </div>



                <!-- =================================================
                     INTERVIEW GUIDELINES
                ================================================== -->

                <div class="guideline-card">

                    <div class="side-card-header">

                        <i class="bi bi-card-list"></i>

                        <span>
                            Interview Guidelines
                        </span>

                    </div>


                    <ul class="guideline-list">


                        <!-- BE ON TIME -->

                        <li class="guideline-item">

                            <div class="guideline-icon">

                                <i class="bi bi-clock"></i>

                            </div>

                            <div class="guideline-content">

                                <span class="guideline-title">
                                    Be on time
                                </span>

                                <span class="guideline-description">
                                    Please arrive at least 10 minutes
                                    before your scheduled time.
                                </span>

                            </div>

                        </li>


                        <!-- VALID ID -->

                        <li class="guideline-item">

                            <div class="guideline-icon">

                                <i class="bi bi-card-text"></i>

                            </div>

                            <div class="guideline-content">

                                <span class="guideline-title">
                                    Bring Valid ID
                                </span>

                                <span class="guideline-description">
                                    Present valid government-issued ID
                                    for verification.
                                </span>

                            </div>

                        </li>


                        <!-- DRESS APPROPRIATELY -->

                        <li class="guideline-item">

                            <div class="guideline-icon">

                                <i class="bi bi-person-workspace"></i>

                            </div>

                            <div class="guideline-content">

                                <span class="guideline-title">
                                    Dress appropriately
                                </span>

                                <span class="guideline-description">
                                    Please wear professional attire
                                    for your interview.
                                </span>

                            </div>

                        </li>


                    </ul>

                </div>


            </div>


        </div>


    </main>



    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script>


        /* =====================================================
           SIDEBAR TOGGLE
        ====================================================== */

        const toggleSidebar =
            document.getElementById("toggleSidebar");

        toggleSidebar.addEventListener("click", function () {

            document.body.classList.toggle("sidebar-collapsed");

        });



        /* =====================================================
           SETTINGS DROPDOWN
        ====================================================== */

        const settingsToggle =
            document.getElementById("settingsToggle");

        const settingsGroup =
            document.querySelector(".sidebar-settings");


        settingsToggle.addEventListener("click", function (e) {

            e.preventDefault();
            e.stopPropagation();

            settingsGroup.classList.toggle("open");

        });



        /* =====================================================
           PROFILE DROPDOWN
        ====================================================== */

        const profileContainer =
            document.querySelector(".profile-container");

        const profileToggle =
            document.getElementById("profileToggle");


        profileToggle.addEventListener("click", function (e) {

            e.stopPropagation();

            profileContainer.classList.toggle("open");

            notificationContainer.classList.remove("open");

        });



        /* =====================================================
           NOTIFICATION DROPDOWN
        ====================================================== */

        const notificationContainer =
            document.querySelector(".notification-container");

        const notificationToggle =
            document.getElementById("notificationToggle");


        notificationToggle.addEventListener("click", function (e) {

            e.stopPropagation();

            notificationContainer.classList.toggle("open");

            profileContainer.classList.remove("open");

        });



        /* =====================================================
           CLOSE DROPDOWNS
        ====================================================== */

        document.addEventListener("click", function (e) {

            if (!profileContainer.contains(e.target)) {

                profileContainer.classList.remove("open");

            }

            if (!notificationContainer.contains(e.target)) {

                notificationContainer.classList.remove("open");

            }

        });



        /* =====================================================
           FILE NAME
        ====================================================== */

        const resumeFile =
            document.getElementById("resumeFile");

        const fileName =
            document.getElementById("fileName");


        resumeFile.addEventListener("change", function () {

            if (this.files.length > 0) {

                fileName.textContent =
                    this.files[0].name;

            }
            else {

                fileName.textContent =
                    "Choose File";

            }

        });


    </script>


    <!-- BOOTSTRAP JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>
</html>