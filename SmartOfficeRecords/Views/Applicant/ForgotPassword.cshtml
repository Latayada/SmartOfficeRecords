@{
    ViewBag.Title = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Forgot Password</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- FontAwesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css" rel="stylesheet" />

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI',sans-serif;
        }

        body {
            background: #f4f7fb;
            height: 100vh;
            overflow: hidden;
        }

        .wrapper {
            display: flex;
            height: 100vh;
        }

        /* LEFT SIDE */

        .left-panel {
            width: 40%;
            background: linear-gradient(180deg,#16a34a,#0f8f40);
            color: white;
            position: relative;
            overflow: hidden;
        }

            .left-panel::before {
                content: "";
                position: absolute;
                inset: 0;
                background-image: radial-gradient(rgba(255,255,255,.05) 25%, transparent 25%);
                background-size: 70px 70px;
            }

        .left-content {
            position: relative;
            z-index: 2;
            text-align: center;
            padding-top: 60px;
        }

        .logo {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: white;
            padding: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,.2);
        }

        .title {
            margin-top: 25px;
            font-size: 50px;
            font-weight: 800;
            line-height: 1.1;
        }

        .illustration {
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 95%;
        }

        /* RIGHT */

        .right-panel {
            width: 60%;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card-box {
            width: 580px;
            background: white;
            border-radius: 30px;
            padding: 50px;
            box-shadow: 0 15px 40px rgba(0,0,0,.08);
        }

        .icon-circle {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: #e8fff0;
            margin: auto;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 48px;
            color: #16a34a;
        }

        h1 {
            text-align: center;
            margin-top: 20px;
            font-weight: 800;
            color: #1e293b;
        }

        .subtitle {
            text-align: center;
            color: #64748b;
            font-size: 18px;
            margin-bottom: 40px;
        }

        label {
            font-weight: 600;
            margin-bottom: 8px;
        }

        .input-group-text {
            background: white;
            border-right: none;
            border-radius: 14px 0 0 14px;
        }

        .form-control {
            height: 60px;
            border-left: none;
            border-radius: 0 14px 14px 0;
            font-size: 17px;
        }

        .btn-send {
            margin-top: 25px;
            height: 58px;
            border: none;
            border-radius: 14px;
            background: #22c55e;
            color: white;
            font-size: 20px;
            font-weight: 700;
            transition: .3s;
        }

            .btn-send:hover {
                background: #16a34a;
                transform: translateY(-2px);
            }

        .divider {
            text-align: center;
            margin: 30px 0;
            color: #9ca3af;
            position: relative;
        }

            .divider:before {
                content: "";
                width: 40%;
                height: 1px;
                background: #ddd;
                position: absolute;
                left: 0;
                top: 50%;
            }

            .divider:after {
                content: "";
                width: 40%;
                height: 1px;
                background: #ddd;
                position: absolute;
                right: 0;
                top: 50%;
            }

        .back {
            text-align: center;
        }

            .back a {
                color: #16a34a;
                text-decoration: none;
                font-weight: 700;
                font-size: 20px;
            }

        .footer-note {
            margin-top: 35px;
            text-align: center;
            color: #64748b;
        }

            .footer-note i {
                color: #16a34a;
            }

    </style>

</head>

<body>

    <div class="wrapper">

        <!-- LEFT -->

        <div class="left-panel">

            <div class="left-content">

                <img src="~/Content/images/logo.png" class="logo" />

                <div class="title">

                    SMART OFFICE<br />

                    RECORDS SYSTEM

                </div>

            </div>

            <img src="~/Content/images/forgot-illustration.png" class="illustration" />

        </div>


        <!-- RIGHT -->

        <div class="right-panel">

            <div class="card-box">

                <div class="icon-circle">

                    <i class="fa-solid fa-key"></i>

                </div>

                <h1>Forgot Password?</h1>

                <div class="subtitle">

                    Enter your registered email address and we'll send
                    you a password reset link.

                </div>

                @using (Html.BeginForm("ForgotPassword", "Applicant", FormMethod.Post))
                {

                    <label>Email Address</label>

                    <div class="input-group">

                        <span class="input-group-text">

                            <i class="fa-regular fa-envelope"></i>

                        </span>

                        <input type="email"
                               class="form-control"
                               name="Email"
                               placeholder="Enter your email address"
                               required />

                    </div>

                    <button class="btn btn-send w-100">

                        <i class="fa-solid fa-paper-plane"></i>

                        Send Reset Link

                    </button>

                }

                @if (ViewBag.Message != null)
                {
                    <div class="alert alert-success mt-4">

                        @ViewBag.Message

                    </div>
                }

                <div class="divider">

                    OR

                </div>

                <div class="back">

                    <a href="@Url.Action("Login", "Applicant")">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back to Login

                    </a>

                </div>

                <div class="footer-note">

                    <i class="fa-solid fa-shield-halved"></i>

                    For your security, the reset link will expire in <strong>15 minutes.</strong>

                </div>

            </div>

        </div>

    </div>

</body>
</html>