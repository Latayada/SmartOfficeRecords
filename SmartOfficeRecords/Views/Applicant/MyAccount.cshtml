    <!-- =========================================================
         JAVASCRIPT
    ========================================================= -->

    <script>

        /* =========================================================
           SIDEBAR
        ========================================================= */

        const toggleSidebar =
            document.getElementById("toggleSidebar");

        toggleSidebar.addEventListener("click", function () {

            document.body.classList.toggle("sidebar-collapsed");

        });


        /* =========================================================
           SETTINGS DROPDOWN
        ========================================================= */

        const settingsToggle =
            document.getElementById("settingsToggle");

        const settingsGroup =
            document.querySelector(".sidebar-settings");

        settingsToggle.addEventListener("click", function (e) {

            if (e.target.closest("a")) {
                return;
            }

            e.preventDefault();

            settingsGroup.classList.toggle("open");

        });


        /* =========================================================
           PROFILE DROPDOWN
        ========================================================= */

        const profileContainer =
            document.querySelector(".profile-container");

        const profileToggle =
            document.getElementById("profileToggle");


        /* =========================================================
           NOTIFICATION
        ========================================================= */

        const notificationContainer =
            document.querySelector(".notification-container");

        const notificationToggle =
            document.getElementById("notificationToggle");


        profileToggle.addEventListener("click", function (e) {

            e.stopPropagation();

            profileContainer.classList.toggle("open");

            notificationContainer.classList.remove("open");

        });


        notificationToggle.addEventListener("click", function (e) {

            e.stopPropagation();

            notificationContainer.classList.toggle("open");

            profileContainer.classList.remove("open");

        });


        document.addEventListener("click", function (e) {

            if (!profileContainer.contains(e.target)) {

                profileContainer.classList.remove("open");

            }

            if (!notificationContainer.contains(e.target)) {

                notificationContainer.classList.remove("open");

            }

        });


        /* =========================================================
           PROFILE / SECURITY TABS
        ========================================================= */

        const accountTabs =
            document.querySelectorAll(".account-tab");

        const profileContent =
            document.getElementById("profileContent");

        const securityContent =
            document.getElementById("securityContent");


        accountTabs.forEach(function (tab) {

            tab.addEventListener("click", function (e) {

                e.preventDefault();

                accountTabs.forEach(function (item) {

                    item.classList.remove("active");

                });

                this.classList.add("active");


                const selectedTab =
                    this.getAttribute("data-tab");


                if (selectedTab === "profile") {

                    profileContent.classList.add("active");

                    securityContent.classList.remove("active");

                }

                else if (selectedTab === "security") {

                    securityContent.classList.add("active");

                    profileContent.classList.remove("active");

                }

            });

        });


        /* =========================================================
           CHANGE PROFILE PHOTO
        ========================================================= */

        const cameraBtn =
            document.getElementById("changePhotoBtn");

        const changePhotoTextBtn =
            document.getElementById("changePhotoTextBtn");

        const photoInput =
            document.getElementById("profilePhotoInput");

        const preview =
            document.getElementById("profilePreview");


        cameraBtn.addEventListener("click", function () {

            photoInput.click();

        });


        changePhotoTextBtn.addEventListener("click", function () {

            photoInput.click();

        });


        photoInput.addEventListener("change", function () {

            if (this.files.length > 0) {

                const reader =
                    new FileReader();

                reader.onload =
                    function (e) {

                        preview.src =
                            e.target.result;

                    };

                reader.readAsDataURL(this.files[0]);

            }

        });


        /* =========================================================
           CHANGE PASSWORD MODAL
        ========================================================= */

        const changePasswordBtn =
            document.getElementById("changePasswordBtn");

        const passwordOverlay =
            document.getElementById("passwordOverlay");

        const closePasswordModal =
            document.getElementById("closePasswordModal");


        changePasswordBtn.addEventListener("click", function () {

            passwordOverlay.classList.add("show");

            document.body.style.overflow = "hidden";

        });


        closePasswordModal.addEventListener("click", function () {

            passwordOverlay.classList.remove("show");

            document.body.style.overflow = "";

        });


        /* CLICK OUTSIDE MODAL */

        passwordOverlay.addEventListener("click", function (e) {

            if (e.target === passwordOverlay) {

                passwordOverlay.classList.remove("show");

                document.body.style.overflow = "";

            }

        });


        /* ESCAPE KEY */

        document.addEventListener("keydown", function (e) {

            if (e.key === "Escape") {

                passwordOverlay.classList.remove("show");

                document.body.style.overflow = "";

            }

        });


        /* =========================================================
           PASSWORD SHOW / HIDE
        ========================================================= */

        const newPassword =
            document.getElementById("newPassword");

        const confirmPassword =
            document.getElementById("confirmPassword");

        const newPasswordEye =
            document.getElementById("newPasswordEye");

        const confirmPasswordEye =
            document.getElementById("confirmPasswordEye");


        newPasswordEye.addEventListener("click", function () {

            if (newPassword.type === "password") {

                newPassword.type = "text";

                this.classList.remove("bi-eye");

                this.classList.add("bi-eye-slash");

            }

            else {

                newPassword.type = "password";

                this.classList.remove("bi-eye-slash");

                this.classList.add("bi-eye");

            }

        });


        confirmPasswordEye.addEventListener("click", function () {

            if (confirmPassword.type === "password") {

                confirmPassword.type = "text";

                this.classList.remove("bi-eye");

                this.classList.add("bi-eye-slash");

            }

            else {

                confirmPassword.type = "password";

                this.classList.remove("bi-eye-slash");

                this.classList.add("bi-eye");

            }

        });


        /* =========================================================
           PASSWORD VALIDATION
        ========================================================= */

        const passwordRules =
            document.querySelectorAll(".password-rules li");

        const strengthBars =
            document.querySelectorAll(".strength-bar");

        const strengthText =
            document.querySelector(".strength-text");

        const matchMessage =
            document.querySelector(".match-message");


        function validatePassword() {

            const password =
                newPassword.value;

            const hasLength =
                password.length >= 8;

            const hasUppercase =
                /[A-Z]/.test(password);

            const hasNumber =
                /[0-9]/.test(password);

            const hasSpecial =
                /[^A-Za-z0-9]/.test(password);


            if (hasLength) {

                passwordRules[0].style.color =
                    "#22C55E";

            }

            if (hasUppercase && hasNumber) {

                passwordRules[1].style.color =
                    "#22C55E";

            }

            if (hasSpecial) {

                passwordRules[2].style.color =
                    "#22C55E";

            }


            let score = 0;

            if (hasLength) score++;

            if (hasUppercase) score++;

            if (hasNumber) score++;

            if (hasSpecial) score++;


            strengthBars.forEach(function (bar, index) {

                if (index < score) {

                    bar.style.background =
                        "#22C55E";

                }

                else {

                    bar.style.background =
                        "#e5e7eb";

                }

            });


            if (score === 4) {

                strengthText.textContent =
                    "Strong Password";

                strengthText.style.color =
                    "#22C55E";

            }

            else {

                strengthText.textContent =
                    "Password needs improvement";

                strengthText.style.color =
                    "#ED1C24";

            }


            checkPasswordMatch();

        }


        function checkPasswordMatch() {

            if (
                confirmPassword.value ===
                newPassword.value &&
                confirmPassword.value !== ""
            ) {

                matchMessage.innerHTML =
                    '<i class="bi bi-check-lg"></i> Password match';

                matchMessage.style.color =
                    "#22C55E";

                confirmPassword.style.borderColor =
                    "#22C55E";

            }

            else {

                matchMessage.innerHTML =
                    '<i class="bi bi-x-lg"></i> Password does not match';

                matchMessage.style.color =
                    "#ED1C24";

                confirmPassword.style.borderColor =
                    "#ED1C24";

            }

        }


        newPassword.addEventListener(
            "input",
            validatePassword
        );

        confirmPassword.addEventListener(
            "input",
            checkPasswordMatch
        );


        /* =========================================================
           CHANGE PASSWORD SUBMIT
        ========================================================= */

        const submitNewPassword =
            document.getElementById("submitNewPassword");


        submitNewPassword.addEventListener("click", function () {

            const password =
                newPassword.value;

            const confirm =
                confirmPassword.value;


            if (password.length < 8) {

                alert("Password must contain at least 8 characters.");

                return;

            }


            if (!/[A-Z]/.test(password)) {

                alert("Password must contain at least one uppercase letter.");

                return;

            }


            if (!/[0-9]/.test(password)) {

                alert("Password must contain at least one number.");

                return;

            }


            if (!/[^A-Za-z0-9]/.test(password)) {

                alert("Password must contain a special character.");

                return;

            }


            if (password !== confirm) {

                alert("Passwords do not match.");

                return;

            }


            alert("Password changed successfully!");


            passwordOverlay.classList.remove("show");

            document.body.style.overflow = "";

        });


        /* =========================================================
           SAVE PROFILE
        ========================================================= */

        document
            .getElementById("saveProfileBtn")
            .addEventListener("click", function () {

                alert("Profile updated successfully!");

            });


        /* =========================================================
           SAVE SECURITY
        ========================================================= */

        document
            .getElementById("saveSecurityBtn")
            .addEventListener("click", function () {

                alert("Security settings updated successfully!");

            });


        /* =========================================================
           INITIAL PASSWORD VALIDATION
           So green na dayon ang requirements
        ========================================================= */

        validatePassword();

    </script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>