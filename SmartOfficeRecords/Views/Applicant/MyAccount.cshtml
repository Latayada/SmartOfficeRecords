@{
    ViewBag.Title = "Profile";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account - Smart Office Records System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #eaf6ed; /* Light mint background */
            min-height: 100vh;
            color: #334155;
            padding-top: 70px; /* Offset fixed navbar */
        }

        /* --- NAVBAR STYLING --- */
        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 0;
            z-index: 1030;
            height: 70px;
        }

        /* White Logo Brand Box Container */
        .navbar-left-box {
            display: flex;
            align-items: center;
            width: 260px;
            height: 100%;
            padding: 0 24px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            transition: width 0.3s ease, padding 0.3s ease;
        }

        /* Dedicated Light Green Toggle Zone Box from Image */
        .toggle-zone-box {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            width: 70px;
        }

        .sidebar-toggle-btn {
            background: none;
            border: none;
            color: #16a34a; /* Green hamburger menu icon */
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 10px;
        }

            .navbar-brand-custom img {
                width: 42px;
                height: 42px;
                object-fit: contain;
            }

        .brand-text {
            color: #0f6328;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 0.5px;
        }

        /* --- NAVBAR PROFILE AND UTILITY --- */
        .navbar-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-left: auto;
        }

        .notification-btn {
            background: none;
            border: none;
            color: #64748b;
            font-size: 20px;
            position: relative;
            cursor: pointer;
        }

        .profile-widget {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8fafc;
            padding: 6px 12px;
            border-radius: 30px;
            border: 1px solid #e2e8f0;
            cursor: pointer;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #ffb74d;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 13px;
        }

        .profile-info {
            text-align: left;
            line-height: 1.2;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 600;
            color: #1e293b;
            display: block;
        }

        .profile-email {
            font-size: 10px;
            color: #64748b;
            display: block;
        }

        .profile-dropdown {
            min-width: 220px;
            border-radius: 16px;
            border: 1px solid #dbe4dc;
            padding: 10px 0;
            margin-top: 12px;
        }

            .profile-dropdown .dropdown-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 18px;
                font-size: 15px;
                font-weight: 500;
                color: #374151;
            }

                .profile-dropdown .dropdown-item i {
                    font-size: 18px;
                    width: 20px;
                }

                .profile-dropdown .dropdown-item:hover {
                    background: #f0fdf4;
                    color: #16a34a;
                }

        /* --- VERTICAL SIDEBAR MENU STYLING --- */
        .sidebar-menu-wrapper {
            position: fixed;
            top: 70px;
            left: 0;
            bottom: 0;
            width: 260px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            padding: 24px 16px;
            overflow-y: auto;
            z-index: 1020;
            transition: width 0.3s ease, padding 0.3s ease;
        }

        .sidebar-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-link-item {
            text-decoration: none;
            color: #64748b;
            font-weight: 500;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .sidebar-link-item i {
                font-size: 20px;
                min-width: 24px;
                display: inline-flex;
                justify-content: center;
            }

            .sidebar-link-item:hover {
                color: #16a34a;
                background-color: #f0fdf4;
            }

            .sidebar-link-item.active {
                color: #16a34a;
                background-color: #f0fdf4;
                font-weight: 600;
            }

        /* --- LAYOUT WORKSPACE CONTAINER --- */
        .page-container {
            margin-left: 260px;
            padding: 40px 30px;
            width: calc(100% - 260px);
            transition: margin-left 0.3s ease;
        }

        /* ==========================================================================
                                    DRIVEN COLLAPSE STYLES (Matches image perfectly on toggle click)
                                   ========================================================================== */

        /* 1. Logo Box shrinks to a perfectly clean white square */
        body.sidebar-collapsed .navbar-left-box {
            width: 76px;
            padding: 0;
            justify-content: center;
        }

        /* 2. Brand name text drops out cleanly */
        body.sidebar-collapsed .brand-text {
            display: none;
        }

        /* 3. Navigation Sidebar wrapper body collapses down */
        body.sidebar-collapsed .sidebar-menu-wrapper {
            width: 76px;
            padding: 24px 10px;
        }

        body.sidebar-collapsed .sidebar-link-text {
            display: none;
        }

        body.sidebar-collapsed .sidebar-link-item {
            justify-content: center;
            padding: 12px 0;
            gap: 0;
        }

        /* 4. Core layout workspace shifts outward */
        body.sidebar-collapsed .page-container {
            margin-left: 76px;
            width: calc(100% - 76px);
        }

        /* --- CONTENT BODY STYLING --- */
        .page-container {
            margin-left: 260px;
            width: calc(100% - 260px);
            padding: 35px;
            transition: all .3s ease;
        }

        .heading-section {
            margin-bottom: 35px;
        }

        .page-title {
            color: #16a34a;
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 14px;
            font-weight: 500;
            margin: 0;
        }

        .account-card {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
            height: 100%;
        }

        .section-title-custom {
            font-size: 18px;
            font-weight: 700;
            color: #475569;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .section-title-custom i {
                color: #16a34a;
            }

        /* --- IMAGE MATCHED LIST DISPLAY --- */
        .profile-info-table {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 35px;
        }

        .profile-info-row {
            display: flex;
            align-items: flex-start;
        }

        .profile-info-label-block {
            display: flex;
            align-items: center;
            gap: 14px;
            width: 200px;
            flex-shrink: 0;
            color: #64748b;
        }

            .profile-info-label-block i {
                font-size: 22px;
                color: #64748b;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 24px;
            }

        .profile-info-label-text {
            font-size: 15px;
            font-weight: 500;
        }

        .profile-info-value {
            font-size: 15px;
            font-weight: 500;
            color: #475569;
            line-height: 1.5;
        }

        /* Image Matched Status Pill */
        .status-pill-active {
            background-color: #6ee7b7; /* Bright soft green from image */
            color: #000000;
            font-weight: 700;
            font-size: 13px;
            padding: 4px 20px;
            border-radius: 8px;
            display: inline-block;
        }

        /* Image Matched Button Style */
        .btn-edit-profile-outline {
            background: transparent;
            color: #16a34a;
            font-weight: 700;
            font-size: 18px;
            padding: 12px;
            border-radius: 10px;
            border: 2px solid #16a34a;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s ease;
        }

            .btn-edit-profile-outline:hover {
                background-color: #f0fdf4;
                transform: translateY(-1px);
            }

        /* --- SIDEBAR PANEL STYLING --- */
        .sidebar-panel {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
            margin-bottom: 24px;
        }

        .sidebar-header {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 15px;
            font-weight: 700;
            color: #1e293b;
            margin-bottom: 12px;
        }

            .sidebar-header i {
                color: #16a34a;
                font-size: 18px;
            }

        .sidebar-body {
            font-size: 13px;
            color: #64748b;
            line-height: 1.6;
        }

        @@media (max-width: 991px) {
            .nav-links-custom

        {
            display: none;
        }

        .profile-info-row {
            flex-direction: column;
            gap: 4px;
        }

        .profile-info-label-block {
            width: 100%;
        }

        }
    </style>
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top d-flex flex-row align-items-center justify-content-start">

        <!-- Left Brand Logo Panel (White background box) -->
        <div class="navbar-left-box" id="navLeftBox">
            <a class="navbar-brand-custom" href="#">
                <img src="~/Images/logo.png" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <div class="brand-text" id="brandText">SORS</div>
            </a>
        </div>

        <!-- Menu Toggle Area Container (Light Green Background Strip) -->
        <div class="toggle-zone-box">
            <button class="sidebar-toggle-btn" id="toggleSidebar" title="Toggle Menu">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <!-- Right Profile/Notification Actions -->
        <div class="navbar-profile pe-4">
            <button class="notification-btn" title="Notifications">
                <i class="bi bi-bell"></i>
            </button>

            <div class="dropdown">
                <div class="profile-widget" data-bs-toggle="dropdown" aria-expanded="false">
                    <div class="profile-avatar">MG</div>
                    <div class="profile-info">
                        <span class="profile-name">Mary Grace</span>
                        <span class="profile-email">smartoffice@gmail.com</span>
                    </div>
                    <i class="bi bi-chevron-down text-muted ms-2"></i>
                </div>

                <ul class="dropdown-menu dropdown-menu-end profile-dropdown shadow">
                    <li>
                        <a class="dropdown-item" href="@Url.Action("MyAccount", "Applicant")">
                            <i class="bi bi-person-circle"></i> My Account
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger" href="@Url.Action("ApplicantLogin", "Applicant")">
                            <i class="bi bi-box-arrow-right"></i> Sign out
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- LEFT SIDEBAR NAV MENU -->
    <aside class="sidebar-menu-wrapper" id="sidebarMenu">
        <ul class="sidebar-links">
            <li>
                <a href="@Url.Action("ApplicantDash", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-house-door-fill"></i>
                    <span class="sidebar-link-text">Home</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("BookInterview", "Applicant")" class="sidebar-link-item active">
                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                    <span class="sidebar-link-text">Book Interview</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("MyAppointment", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-person-bounding-box"></i>
                    <span class="sidebar-link-text">My Appointment</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- CONTENT BODY -->
    <div class="page-container">

        <div class="heading-section">
            <h1 class="page-title">My Account</h1>
            <p class="page-subtitle">View and update your registered system records.</p>
        </div>

        <div class="row g-4">
            <!-- Left Column: Profile View Box (Col-8) -->
            <div class="col-lg-8">
                <div class="account-card">

                    <h5 class="section-title-custom"><i class="bi bi-person-lines-fill"></i> Profile Details</h5>

                    <!-- Exact Image Copy List Layout -->
                    <div class="profile-info-table">

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-person"></i>
                                <span class="profile-info-label-text">Full Name</span>
                            </div>
                            <div class="profile-info-value">Juan Dela Cruz</div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-envelope"></i>
                                <span class="profile-info-label-text">Email Address</span>
                            </div>
                            <div class="profile-info-value">juandelacruz@gmail.com</div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-telephone"></i>
                                <span class="profile-info-label-text">Phone Number</span>
                            </div>
                            <div class="profile-info-value">+6363 968 6682</div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-calendar3"></i>
                                <span class="profile-info-label-text">Birthdate</span>
                            </div>
                            <div class="profile-info-value">January 18, 1995</div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-geo-alt"></i>
                                <span class="profile-info-label-text">Address</span>
                            </div>
                            <div class="profile-info-value">65 Street, Barangay Cogon,<br>City of Naga Cebu, Philippiness</div>
                        </div>

                        <div class="profile-info-row align-items-center">
                            <div class="profile-info-label-block">
                                <i class="bi bi-person-check"></i>
                                <span class="profile-info-label-text">Status</span>
                            </div>
                            <div class="profile-info-value">
                                <span class="status-pill-active">Active</span>
                            </div>
                        </div>

                        <div class="profile-info-row">
                            <div class="profile-info-label-block">
                                <i class="bi bi-people"></i>
                                <span class="profile-info-label-text">Member Since</span>
                            </div>
                            <div class="profile-info-value">May 13, 2026</div>
                        </div>

                    </div>

                    <!-- Exact Image Design Edit Profile Outline Button -->
                    <button class="btn-edit-profile-outline">
                        <i class="bi bi-pencil"></i> Edit Profile
                    </button>

                </div>
            </div>

            <!-- Right Column: Sidebar Panels (Col-4) -->
            <div class="col-lg-4">

                <div class="sidebar-panel">
                    <div class="sidebar-header">
                        <i class="bi bi-shield-lock-fill"></i> Security Tip
                    </div>
                    <div class="sidebar-body">
                        Please keep your phone number and email information updated to avoid losing access to account announcements and verification documents.
                    </div>
                </div>

                <div class="sidebar-panel">
                    <div class="sidebar-header">
                        <i class="bi bi-info-circle-fill"></i> Help & Support
                    </div>
                    <div class="sidebar-body">
                        Need to change critical verification details? Get in touch with the main administration branch office.
                    </div>
                </div>

            </div>
        </div>
    </div>

    <script>

        //Toggle
        document.getElementById('toggleSidebar').addEventListener('click', function () {    
            document.body.classList.toggle('sidebar-collapsed');
        });

        </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>