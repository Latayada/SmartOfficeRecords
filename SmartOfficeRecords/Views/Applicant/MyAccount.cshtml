@{
    ViewBag.Title = "My Account";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Account - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f4f5f6;
            color: #334155;
            min-height: 100vh;
            overflow-x: hidden;
        }

        :root {
            --primary-red: #ED1C24;
            --dark-red: #C9080E;
            --light-red: #FFF1F2;
            --sidebar-black: #222C33;
            --sidebar-hover: #303B41;
            --white: #FFFFFF;
            --page-bg: #F4F5F6;
            --border-gray: #E2E8F0;
            --light-gray: #E5E7EB;
            --text-dark: #334155;
            --text-gray: #64748B;
            --text-light: #94A3B8;
        }


        /* =========================================================
                   TOPBAR
                ========================================================= */

        .navbar-custom {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 56px;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            z-index: 1100;
            display: flex;
            align-items: center;
        }


        /* =========================================================
                   NAVBAR LEFT
                ========================================================= */

        .navbar-left-box {
            width: 155px;
            height: 56px;
            background: var(--sidebar-black);
            display: flex;
            align-items: center;
            padding: 0 14px;
            transition: .3s ease;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

            .navbar-brand-custom img {
                width: 34px;
                height: 34px;
                object-fit: contain;
                border-radius: 50%;
            }

        .brand-text {
            color: #ffffff;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: .3px;
        }


        /* =========================================================
                   TOGGLE
                ========================================================= */

        .toggle-zone-box {
            width: 48px;
            height: 56px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-toggle-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: transparent;
            color: var(--primary-red);
            font-size: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border-radius: 8px;
            transition: .2s ease;
        }

            .sidebar-toggle-btn:hover {
                background: var(--light-red);
                color: var(--dark-red);
            }


        /* =========================================================
                   NAVBAR RIGHT
                ========================================================= */

        .navbar-profile {
            margin-left: auto;
            height: 56px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding-right: 18px;
        }


        /* =========================================================
                   NOTIFICATION
                ========================================================= */

        .notification-container {
            position: relative;
        }

        .notification-btn {
            width: 38px;
            height: 38px;
            border: none;
            background: transparent;
            color: #1f2933;
            font-size: 19px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            cursor: pointer;
            position: relative;
            transition: .2s ease;
        }

            .notification-btn:hover {
                background: #f5f5f5;
                color: var(--primary-red);
            }

        .notification-badge-dot {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 7px;
            height: 7px;
            background: var(--primary-red);
            border-radius: 50%;
            border: 1px solid #ffffff;
        }


        /* =========================================================
                   NOTIFICATION DROPDOWN
                ========================================================= */

        .notification-dropdown-custom {
            position: absolute;
            right: 0;
            top: 48px;
            width: 340px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(0,0,0,.12);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: .25s ease;
            z-index: 1200;
        }

        .notification-container.open .notification-dropdown-custom {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .notif-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
        }

        .notif-header-title {
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
        }

        .notif-mark-read {
            font-size: 10px;
            color: var(--primary-red);
            text-decoration: none;
            font-weight: 600;
        }

            .notif-mark-read:hover {
                color: var(--dark-red);
                text-decoration: underline;
            }

        .notif-body {
            max-height: 300px;
            overflow-y: auto;
        }

        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 16px;
            text-decoration: none;
            border-bottom: 1px solid #f8fafc;
            transition: .2s ease;
        }

            .notif-item:hover {
                background: var(--light-red);
            }

            .notif-item.unread {
                background: #fff8f8;
            }

        .notif-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .notif-icon-success {
            background: #dcfce7;
            color: #16a34a;
        }

        .notif-icon-warning {
            background: #fef3c7;
            color: #d97706;
        }

        .notif-content {
            flex: 1;
        }

        .notif-text {
            font-size: 11px;
            color: #334155;
            line-height: 1.4;
        }

        .notif-time {
            font-size: 9px;
            color: #94a3b8;
            margin-top: 2px;
        }

        .notif-footer {
            padding: 10px;
            text-align: center;
            background: #fafafa;
            border-top: 1px solid #f1f5f9;
        }

        .notif-footer-btn {
            color: var(--primary-red);
            font-size: 11px;
            text-decoration: none;
            font-weight: 600;
        }

            .notif-footer-btn:hover {
                text-decoration: underline;
            }


        /* =========================================================
                   PROFILE WIDGET
                ========================================================= */

        .profile-container {
            position: relative;
        }

        .profile-widget {
            min-width: 155px;
            height: 40px;
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 4px 8px;
            background: #f5f5f5;
            border: 1px solid #e5e7eb;
            border-radius: 20px;
            cursor: pointer;
            user-select: none;
            transition: .2s ease;
        }

            .profile-widget:hover {
                background: #eeeeee;
            }

        .profile-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #ffb347;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .profile-info {
            line-height: 1.15;
            flex: 1;
        }

        .profile-name {
            display: block;
            font-size: 10px;
            font-weight: 700;
            color: #1f2937;
        }

        .profile-email {
            display: block;
            font-size: 8px;
            color: #64748b;
        }

        .profile-arrow {
            font-size: 11px;
            color: #334155;
            transition: .3s ease;
        }

        .profile-container.open .profile-arrow {
            transform: rotate(180deg);
        }


        /* =========================================================
                   PROFILE DROPDOWN
                ========================================================= */

        .profile-dropdown-custom {
            position: absolute;
            top: 48px;
            right: 0;
            width: 210px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(0,0,0,.12);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: .25s ease;
            z-index: 1200;
        }

        .profile-container.open .profile-dropdown-custom {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-dropdown-custom a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 15px;
            color: #475569;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
            transition: .2s ease;
        }

            .profile-dropdown-custom a:hover {
                background: var(--light-red);
                color: var(--primary-red);
            }

            .profile-dropdown-custom a i {
                font-size: 16px;
            }


        /* =========================================================
                   SIDEBAR
                ========================================================= */

        .sidebar-menu-wrapper {
            position: fixed;
            top: 56px;
            left: 0;
            bottom: 0;
            width: 155px;
            background: var(--sidebar-black);
            border-right: 1px solid #39434a;
            padding: 15px 8px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1020;
            transition: all .3s ease;
        }

            .sidebar-menu-wrapper::-webkit-scrollbar {
                width: 4px;
            }

            .sidebar-menu-wrapper::-webkit-scrollbar-track {
                background: var(--sidebar-black);
            }

            .sidebar-menu-wrapper::-webkit-scrollbar-thumb {
                background: #45545d;
                border-radius: 10px;
            }

        .sidebar-links {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .sidebar-link-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 11px 10px;
            border-radius: 5px;
            color: #ffffff;
            font-size: 12px;
            font-weight: 500;
            white-space: nowrap;
            text-decoration: none;
            transition: all .2s ease;
        }

            .sidebar-link-item i {
                width: 17px;
                min-width: 17px;
                font-size: 14px;
                display: inline-flex;
                justify-content: center;
            }

            .sidebar-link-item:hover {
                color: var(--primary-red);
                background: rgba(237, 28, 36, .08);
            }

                .sidebar-link-item:hover i {
                    color: var(--primary-red);
                }

            .sidebar-link-item.active {
                color: var(--primary-red);
                background: transparent;
                font-weight: 600;
            }

                .sidebar-link-item.active i {
                    color: var(--primary-red);
                }


        /* =========================================================
                   SETTINGS
                ========================================================= */

        .sidebar-settings {
            list-style: none;
        }

        .settings-toggle {
            justify-content: space-between;
            cursor: pointer;
        }

            .settings-toggle > a {
                color: #ffffff !important;
            }

                .settings-toggle > a:hover {
                    color: var(--primary-red) !important;
                }

                    .settings-toggle > a:hover i {
                        color: var(--primary-red);
                    }

            .settings-toggle.active {
                background: rgba(237, 28, 36, .10);
                color: var(--primary-red);
                font-weight: 600;
            }

                .settings-toggle.active > a {
                    color: var(--primary-red) !important;
                }

                    .settings-toggle.active > a i {
                        color: var(--primary-red) !important;
                    }

        .settings-arrow {
            color: #ffffff;
            font-size: 11px;
            transition: .3s ease;
        }

        .settings-toggle.active .settings-arrow {
            color: var(--primary-red);
        }

        .settings-toggle:hover .settings-arrow {
            color: var(--primary-red);
        }


        /* =========================================================
                   SETTINGS SUBMENU
                ========================================================= */

        .settings-submenu {
            list-style: none;
            padding: 0 0 0 12px;
            margin: 2px 0 0 0;
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
        }

            .settings-submenu li {
                margin: 2px 0;
            }

            .settings-submenu a {
                display: flex;
                align-items: center;
                gap: 8px;
                padding: 8px 9px;
                border-radius: 5px;
                color: #ffffff !important;
                font-size: 11px;
                font-weight: 500;
                text-decoration: none;
                transition: .2s ease;
            }

                .settings-submenu a:hover {
                    background: rgba(237, 28, 36, .10);
                    color: var(--primary-red) !important;
                }

                .settings-submenu a i {
                    color: #ffffff;
                    font-size: 12px;
                }

                .settings-submenu a:hover i {
                    color: var(--primary-red);
                }

                .settings-submenu a.active {
                    color: var(--primary-red) !important;
                    background: rgba(237, 28, 36, .10);
                    font-weight: 600;
                }

                    .settings-submenu a.active i {
                        color: var(--primary-red);
                    }

        .sidebar-settings.open .settings-submenu {
            max-height: 150px;
        }

        .sidebar-settings.open .settings-arrow {
            transform: rotate(90deg);
        }


        /* =========================================================
                   LOGOUT
                ========================================================= */

        .logout-wrapper {
            position: absolute;
            bottom: 15px;
            left: 8px;
            right: 8px;
        }

        .logout-link {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 10px;
            color: #ffffff;
            font-size: 12px;
            font-weight: 500;
            border-radius: 5px;
            text-decoration: none;
            transition: .2s ease;
        }

            .logout-link:hover {
                color: var(--primary-red);
                background: rgba(237, 28, 36, .08);
            }

            .logout-link i {
                font-size: 16px;
            }

            .logout-link:hover i {
                color: var(--primary-red);
            }


        /* =========================================================
                   MAIN PAGE
                ========================================================= */

        .page-container {
            margin-left: 155px;
            padding: 78px 18px 35px;
            min-height: 100vh;
            transition: margin-left .3s ease;
        }


        /* =========================================================
                   PAGE HEADER
                ========================================================= */

        .heading-section {
            margin-bottom: 18px;
        }

        .breadcrumb-text {
            font-size: 10px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .page-title {
            font-size: 23px;
            color: #263238;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 11px;
            font-weight: 500;
            margin: 0;
        }


        /* =========================================================
                   ACCOUNT TABS
                ========================================================= */

        .account-tabs {
            border-bottom: 1px solid #d9dee3;
            margin-bottom: 20px;
        }

        .account-tab {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 0;
            margin-right: 25px;
            color: #94a3b8;
            font-size: 12px;
            font-weight: 600;
            text-decoration: none;
            border-bottom: 2px solid transparent;
            transition: .2s ease;
            cursor: pointer;
        }

            .account-tab:hover {
                color: var(--primary-red);
            }

            .account-tab.active {
                color: var(--primary-red);
                border-bottom-color: var(--primary-red);
            }


        /* =========================================================
                   TAB CONTENT
                ========================================================= */

        .account-tab-content {
            display: none;
        }

            .account-tab-content.active {
                display: block;
            }


        /* =========================================================
                   ACCOUNT CARD
                ========================================================= */

        .account-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,.06);
            margin-bottom: 18px;
        }


        /* =========================================================
                   PROFILE TOP
                ========================================================= */

        .profile-top {
            display: flex;
            align-items: center;
            gap: 22px;
            margin-bottom: 25px;
        }

        .profile-image-wrapper {
            position: relative;
            width: 90px;
            height: 90px;
            flex-shrink: 0;
        }

        .profile-large-image {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid #ffe0a8;
            background: #fff;
        }

        .camera-btn {
            position: absolute;
            right: -2px;
            bottom: -2px;
            width: 28px;
            height: 28px;
            border: 2px solid #ffffff;
            border-radius: 50%;
            background: var(--primary-red);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            cursor: pointer;
            box-shadow: 0 3px 8px rgba(0,0,0,.15);
        }

            .camera-btn:hover {
                background: var(--dark-red);
            }

        .profile-details {
            flex: 1;
        }

            .profile-details label {
                display: block;
                color: #64748b;
                font-size: 10px;
                font-weight: 600;
                margin-bottom: 5px;
            }

        .applicant-id {
            display: inline-block;
            min-width: 120px;
            padding: 8px 12px;
            background: #f1f3f5;
            border-radius: 7px;
            color: #475569;
            font-size: 11px;
            font-weight: 600;
            box-shadow: inset 0 0 8px rgba(0,0,0,.03);
        }

        .id-note {
            display: block;
            color: #94a3b8;
            font-size: 9px;
            margin-top: 5px;
        }

        .btn-change-photo {
            margin-top: 8px;
            padding: 5px 10px;
            font-size: 9px;
            border-radius: 6px;
            border: 1px solid var(--primary-red);
            color: var(--primary-red);
            background: #ffffff;
            font-weight: 600;
        }

            .btn-change-photo:hover {
                background: var(--light-red);
                color: var(--dark-red);
            }


        /* =========================================================
                   FORM
                ========================================================= */

        .form-label {
            font-size: 10px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            height: 42px;
            border: 1px solid #e2e8f0;
            border-radius: 7px;
            font-size: 10px;
            color: #334155;
            padding: 8px 12px;
            background: #ffffff;
            box-shadow: 0 4px 12px rgba(237,28,36,.08);
        }

            .form-control:focus,
            .form-select:focus {
                border-color: var(--primary-red);
                box-shadow: 0 0 0 3px rgba(237,28,36,.10);
                outline: none;
            }

            .form-control::placeholder {
                color: #a1a8b0;
            }


        /* =========================================================
                   DATE INPUT
                ========================================================= */

        .date-wrapper {
            position: relative;
        }

            .date-wrapper .form-control {
                padding-right: 35px;
            }

        .calendar-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 13px;
            pointer-events: none;
        }


        /* =========================================================
                   SAVE BUTTON
                ========================================================= */

        .btn-action-save {
            background: var(--primary-red);
            border: none;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            padding: 10px 18px;
            border-radius: 6px;
            transition: .2s ease;
        }

            .btn-action-save:hover {
                background: var(--dark-red);
                color: #ffffff;
                transform: translateY(-1px);
            }


        /* =========================================================
                   SECURITY
                ========================================================= */

        .security-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .security-box {
            background: #ffffff;
            border: 1px solid #eef1f4;
            border-radius: 10px;
            padding: 16px;
            box-shadow: 0 5px 15px rgba(0,0,0,.05);
        }

            .security-box h4 {
                font-size: 15px;
                font-weight: 700;
                color: #334155;
                margin-bottom: 2px;
            }

                .security-box h4 i {
                    color: var(--primary-red);
                    margin-right: 5px;
                    font-size: 14px;
                }

        .security-description {
            font-size: 9px;
            color: #94a3b8;
            margin-bottom: 14px;
        }


        /* =========================================================
                   PASSWORD BOX
                ========================================================= */

        .password-info {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .password-last-changed {
            font-size: 9px;
            color: #64748b;
            font-weight: 600;
        }

            .password-last-changed span {
                display: block;
                margin-top: 2px;
                color: #94a3b8;
                font-weight: 500;
            }

        .btn-small {
            border: 1px solid #dbe1e7;
            background: #ffffff;
            color: #334155;
            padding: 7px 10px;
            border-radius: 6px;
            font-size: 9px;
            font-weight: 600;
            white-space: nowrap;
        }

            .btn-small:hover {
                border-color: var(--primary-red);
                color: var(--primary-red);
                background: var(--light-red);
            }


        /* =========================================================
                   ACTIVE SESSIONS
                ========================================================= */

        .session-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid #f1f5f9;
        }

            .session-item:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .session-icon {
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 5px;
            background: #f1f3f5;
            color: #64748b;
            flex-shrink: 0;
        }

        .session-info {
            flex: 1;
        }

        .session-device {
            font-size: 10px;
            color: #475569;
            font-weight: 600;
        }

        .session-location {
            font-size: 9px;
            color: #64748b;
        }

        .session-device span {
            color: #16a34a;
            font-weight: 700;
            margin-left: 4px;
        }

        .btn-logout-session {
            border: 1px solid var(--primary-red);
            color: var(--primary-red);
            background: #ffffff;
            font-size: 9px;
            padding: 5px 10px;
            border-radius: 6px;
            font-weight: 600;
        }

            .btn-logout-session:hover {
                background: var(--primary-red);
                color: #ffffff;
            }


