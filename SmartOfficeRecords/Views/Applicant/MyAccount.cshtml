    <!-- =========================================================
         MAIN CONTENT
    ========================================================= -->

    <main class="page-container">


        <!-- PAGE HEADER -->

        <div class="heading-section">

            <div class="breadcrumb-text">
                Settings
            </div>

            <h1 class="page-title">
                My Account
            </h1>

            <p class="page-subtitle">
                Keeps your personal details up to date.
            </p>

        </div>


        <!-- =====================================================
             ACCOUNT TABS
        ====================================================== -->

        <div class="account-tabs">


            <a href="#profile"
               class="account-tab active">

                Profile

            </a>


            <a href="#security"
               class="account-tab">

                Security

            </a>


        </div>



        <!-- =====================================================
             PROFILE CARD
        ====================================================== -->

        <div class="account-card"
             id="profile">


            <!-- PROFILE TOP -->

            <div class="profile-top">


                <!-- PROFILE IMAGE -->

                <div>

                    <div class="profile-image-wrapper">


                        <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png"
                             class="profile-large-image"
                             id="profilePreview"
                             alt="Profile Photo" />


                        <button type="button"
                                class="camera-btn"
                                id="changePhotoBtn"
                                title="Change Photo">

                            <i class="bi bi-camera-fill"></i>

                        </button>


                        <input type="file"
                               id="profilePhotoInput"
                               accept="image/*"
                               hidden />

                    </div>


                    <button type="button"
                            class="btn-change-photo"
                            id="changePhotoTextBtn">

                        Change Photo

                    </button>

                </div>


                <!-- APPLICANT ID -->

                <div class="profile-details">


                    <label>
                        Applicant ID
                    </label>


                    <div class="applicant-id">
                        AP-0001
                    </div>


                    <span class="id-note">
                        (Cannot be changed)
                    </span>


                </div>

            </div>



            <!-- =================================================
                 PERSONAL INFORMATION
            ================================================== -->

            <div class="row">


                <!-- NAME -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Name
                    </label>

                    <input type="text"
                           class="form-control"
                           value="John Cruz" />

                </div>


                <!-- USERNAME -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Username
                    </label>

                    <input type="text"
                           class="form-control"
                           value="john" />

                </div>


                <!-- BIRTHDATE -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Birthdate
                    </label>

                    <div class="date-wrapper">

                        <input type="date"
                               class="form-control"
                               value="2004-01-01" />

                        <i class="bi bi-calendar3 calendar-icon"></i>

                    </div>

                </div>


                <!-- PHONE -->

                <div class="col-md-6 mb-3">

                    <label class="form-label">
                        Phone Number
                    </label>

                    <input type="text"
                           class="form-control"
                           value="+63 963 900 0000" />

                </div>


                <!-- ADDRESS -->

                <div class="col-12 mb-3">

                    <label class="form-label">
                        Address
