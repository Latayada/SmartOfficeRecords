    <!-- =========================================================
         JAVASCRIPT
    ========================================================= -->

    <script>


        /* =========================================================
           SIDEBAR TOGGLE
        ========================================================= */

        const toggleSidebar =
            document.getElementById("toggleSidebar");

        toggleSidebar.addEventListener("click", function () {

            document.body.classList.toggle(
                "sidebar-collapsed"
            );

        });



        /* =========================================================
           SETTINGS DROPDOWN
        ========================================================= */

        const settingsToggle =
            document.getElementById("settingsToggle");

        const settingsGroup =
            document.querySelector(".sidebar-settings");

        settingsToggle.addEventListener("click", function (e) {

            if (e.target.closest("a")) {
                return;
            }

            e.preventDefault();
            e.stopPropagation();

            settingsGroup.classList.toggle("open");

        });



        /* =========================================================
           PROFILE DROPDOWN
        ========================================================= */

        const profileContainer =
            document.querySelector(".profile-container");

        const profileToggle =
            document.getElementById("profileToggle");

        const notificationContainer =
            document.querySelector(".notification-container");

        profileToggle.addEventListener("click", function (e) {

            e.stopPropagation();

            profileContainer.classList.toggle("open");

            notificationContainer.classList.remove("open");

        });



        /* =========================================================
           NOTIFICATION DROPDOWN
        ========================================================= */

        const notificationToggle =
            document.getElementById("notificationToggle");

        notificationToggle.addEventListener("click", function (e) {

            e.stopPropagation();

            notificationContainer.classList.toggle("open");

            profileContainer.classList.remove("open");

        });



        /* =========================================================
           CLOSE DROPDOWNS
        ========================================================= */

        document.addEventListener("click", function (e) {

            if (!profileContainer.contains(e.target)) {

                profileContainer.classList.remove("open");

            }

            if (!notificationContainer.contains(e.target)) {

                notificationContainer.classList.remove("open");

            }

        });



        /* =========================================================
           PROFILE / SECURITY TABS
        ========================================================= */

        const accountTabs =
            document.querySelectorAll(".account-tab");

        const profileContent =
            document.getElementById("profileContent");

        const securityContent =
            document.getElementById("securityContent");


        accountTabs.forEach(function (tab) {

            tab.addEventListener("click", function (e) {

                e.preventDefault();

                const selectedTab =
                    this.getAttribute("data-tab");


                /* Remove active from all tabs */

                accountTabs.forEach(function (item) {

                    item.classList.remove("active");

                });


                /* Hide all content */

                profileContent.classList.remove("active");

                securityContent.classList.remove("active");


                /* Activate selected tab */

                this.classList.add("active");


                if (selectedTab === "profile") {

                    profileContent.classList.add("active");

                    history.replaceState(
                        null,
                        null,
                        "#profile"
                    );

                }


                if (selectedTab === "security") {

                    securityContent.classList.add("active");

                    history.replaceState(
                        null,
                        null,
                        "#security"
                    );

                }

            });

        });



        /* =========================================================
           OPEN TAB FROM URL HASH
        ========================================================= */

        function openTabFromHash() {

            const hash =
                window.location.hash;


            if (hash === "#security") {

                accountTabs.forEach(function (tab) {

                    tab.classList.remove("active");

                });

                profileContent.classList.remove("active");

                securityContent.classList.add("active");


                document
                    .querySelector('[data-tab="security"]')
                    .classList.add("active");

            }

            else {

                accountTabs.forEach(function (tab) {

                    tab.classList.remove("active");

                });

                securityContent.classList.remove("active");

                profileContent.classList.add("active");


                document
                    .querySelector('[data-tab="profile"]')
                    .classList.add("active");

            }

        }

        openTabFromHash();



        /* =========================================================
           CHANGE PROFILE PHOTO
        ========================================================= */

        const cameraBtn =
            document.getElementById("changePhotoBtn");

        const changePhotoTextBtn =
            document.getElementById("changePhotoTextBtn");

        const photoInput =
            document.getElementById("profilePhotoInput");

        const preview =
            document.getElementById("profilePreview");


        cameraBtn.addEventListener("click", function () {

            photoInput.click();

        });


        changePhotoTextBtn.addEventListener("click", function () {

            photoInput.click();

        });


        photoInput.addEventListener("change", function () {

            if (this.files.length > 0) {

                const reader =
                    new FileReader();


                reader.onload = function (e) {

                    preview.src =
                        e.target.result;

                };


                reader.readAsDataURL(
                    this.files[0]
                );

            }

        });



        /* =========================================================
           SAVE PROFILE
        ========================================================= */

        const saveProfileBtn =
            document.getElementById("saveProfileBtn");


        saveProfileBtn.addEventListener("click", function () {

            alert(
                "Profile updated successfully!"
            );

        });



        /* =========================================================
           CHANGE PASSWORD
        ========================================================= */

        const changePasswordBtn =
            document.getElementById("changePasswordBtn");


        changePasswordBtn.addEventListener("click", function () {

            alert(
                "Change Password option selected."
            );

        });



        /* =========================================================
           TWO FACTOR
        ========================================================= */

        const twoFactorToggle =
            document.getElementById("twoFactorToggle");


        twoFactorToggle.addEventListener("change", function () {

            const status =
                this.checked
                    ? "enabled"
                    : "disabled";


            const label =
                this.closest(".security-box")
                    .querySelector(
                        ".two-factor-title span"
                    );


            label.textContent =
                this.checked
                    ? "on"
                    : "off";


            alert(
                "Two-factor authentication " +
                status +
                "."
            );

        });



        /* =========================================================
           SECURITY SAVE
        ========================================================= */

        const saveSecurityBtn =
            document.getElementById("saveSecurityBtn");


        saveSecurityBtn.addEventListener("click", function () {

            alert(
                "Security settings updated successfully!"
            );

        });



        /* =========================================================
           ACTIVE SESSION LOGOUT
        ========================================================= */

        const logoutSessionButtons =
            document.querySelectorAll(
                ".btn-logout-session"
            );


        logoutSessionButtons.forEach(function (button) {

            button.addEventListener(
                "click",
                function () {

                    const confirmed =
                        confirm(
                            "Are you sure you want to logout this device?"
                        );


                    if (confirmed) {

                        this.closest(
                            ".session-item"
                        ).remove();

                    }

                }
            );

        });

    </script>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


</body>
</html>