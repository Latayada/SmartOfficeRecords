@{
    ViewBag.Title = "My Account";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>My Account - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>

        /* =========================================================
           GLOBAL
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f4f5f6;
            color: #334155;
            min-height: 100vh;
            overflow-x: hidden;
        }

        :root {
            --primary-red: #ED1C24;
            --dark-red: #C9080E;
            --light-red: #FFF1F2;
            --sidebar-black: #222C33;
            --sidebar-hover: #303B41;
            --white: #FFFFFF;
            --page-bg: #F4F5F6;
            --border-gray: #E2E8F0;
            --light-gray: #E5E7EB;
            --text-dark: #334155;
            --text-gray: #64748B;
            --text-light: #94A3B8;
            --success: #22C55E;
            --success-light: #DCFCE7;
        }


        /* =========================================================
           TOPBAR
        ========================================================= */

        .navbar-custom {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 62px;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            z-index: 1100;
            display: flex;
            align-items: center;
        }

        .navbar-left-box {
            width: 181px;
            height: 62px;
            background: var(--sidebar-black);
            display: flex;
            align-items: center;
            padding: 0 14px;
            transition: .3s ease;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            gap: 9px;
            text-decoration: none;
        }

        .navbar-brand-custom img {
            width: 38px;
            height: 38px;
            object-fit: contain;
            border-radius: 50%;
        }

        .brand-text {
            color: #ffffff;
            font-size: 16px;
            font-weight: 700;
            letter-spacing: .3px;
        }

        .toggle-zone-box {
            width: 48px;
            height: 62px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-toggle-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: transparent;
            color: var(--primary-red);
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border-radius: 8px;
            transition: .2s ease;
        }

        .sidebar-toggle-btn:hover {
            background: var(--light-red);
            color: var(--dark-red);
        }


        /* =========================================================
           NAVBAR RIGHT
        ========================================================= */

        .navbar-profile {
            margin-left: auto;
            height: 62px;
            display: flex;
            align-items: center;
            gap: 14px;
            padding-right: 16px;
        }

        .notification-container {
            position: relative;
        }

        .notification-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: transparent;
            color: #1f2933;
            font-size: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            cursor: pointer;
            position: relative;
            transition: .2s ease;
        }

        .notification-btn:hover {
            background: #f5f5f5;
            color: var(--primary-red);
        }

        .notification-badge-dot {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 7px;
            height: 7px;
            background: var(--primary-red);
            border-radius: 50%;
            border: 1px solid #ffffff;
        }


        /* =========================================================
           NOTIFICATION DROPDOWN
        ========================================================= */

        .notification-dropdown-custom {
            position: absolute;
            right: 0;
            top: 48px;
            width: 340px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(0,0,0,.12);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: .25s ease;
            z-index: 1200;
        }

        .notification-container.open .notification-dropdown-custom {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .notif-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            border-bottom: 1px solid #f1f5f9;
        }

        .notif-header-title {
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
        }

        .notif-mark-read {
            font-size: 10px;
            color: var(--primary-red);
            text-decoration: none;
            font-weight: 600;
        }

        .notif-mark-read:hover {
            color: var(--dark-red);
            text-decoration: underline;
        }

        .notif-body {
            max-height: 300px;
            overflow-y: auto;
        }

        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 12px 16px;
            text-decoration: none;
            border-bottom: 1px solid #f8fafc;
            transition: .2s ease;
        }

        .notif-item:hover {
            background: var(--light-red);
        }

        .notif-item.unread {
            background: #fff8f8;
        }

        .notif-icon-box {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .notif-icon-success {
            background: #dcfce7;
            color: #16a34a;
        }

        .notif-icon-warning {
            background: #fef3c7;
            color: #d97706;
        }

        .notif-content {
            flex: 1;
        }

        .notif-text {
            font-size: 11px;
            color: #334155;
            line-height: 1.4;
        }

        .notif-time {
            font-size: 9px;
            color: #94a3b8;
            margin-top: 2px;
        }

        .notif-footer {
            padding: 10px;
            text-align: center;
            background: #fafafa;
            border-top: 1px solid #f1f5f9;
        }

        .notif-footer-btn {
            color: var(--primary-red);
            font-size: 11px;
            text-decoration: none;
            font-weight: 600;
        }


        /* =========================================================
           PROFILE WIDGET
        ========================================================= */

        .profile-container {
            position: relative;
        }

        .profile-widget {
            min-width: 185px;
            height: 44px;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 4px 9px;
            background: #f5f5f5;
            border: 1px solid #e5e7eb;
            border-radius: 22px;
            cursor: pointer;
            user-select: none;
            transition: .2s ease;
        }

        .profile-widget:hover {
            background: #eeeeee;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #ffb347;
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .profile-info {
            line-height: 1.15;
            flex: 1;
        }

        .profile-name {
            display: block;
            font-size: 11px;
            font-weight: 700;
            color: #1f2937;
        }

        .profile-email {
            display: block;
            font-size: 8px;
            color: #64748b;
        }

        .profile-arrow {
            font-size: 11px;
            color: #334155;
            transition: .3s ease;
        }

        .profile-container.open .profile-arrow {
            transform: rotate(180deg);
        }


        /* =========================================================
           PROFILE DROPDOWN
        ========================================================= */

        .profile-dropdown-custom {
            position: absolute;
            top: 50px;
            right: 0;
            width: 210px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(0,0,0,.12);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: .25s ease;
            z-index: 1200;
        }

        .profile-container.open .profile-dropdown-custom {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-dropdown-custom a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 15px;
            color: #475569;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
            transition: .2s ease;
        }

        .profile-dropdown-custom a:hover {
            background: var(--light-red);
            color: var(--primary-red);
        }


        /* =========================================================
           SIDEBAR
        ========================================================= */

        .sidebar-menu-wrapper {
            position: fixed;
            top: 62px;
            left: 0;
            bottom: 0;
            width: 181px;
            background: var(--sidebar-black);
            border-right: 1px solid #39434a;
            padding: 18px 8px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1020;
            transition: all .3s ease;
        }

        .sidebar-links {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .sidebar-link-item {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 11px;
            padding: 12px 11px;
            border-radius: 6px;
            color: #ffffff;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            text-decoration: none;
            transition: all .2s ease;
        }

        .sidebar-link-item i {
            width: 18px;
            min-width: 18px;
            font-size: 15px;
            display: inline-flex;
            justify-content: center;
        }

        .sidebar-link-item:hover {
            color: var(--primary-red);
            background: rgba(237,28,36,.08);
        }

        .sidebar-link-item:hover i {
            color: var(--primary-red);
        }


        /* =========================================================
           SETTINGS
        ========================================================= */

        .sidebar-settings {
            list-style: none;
        }

        .settings-toggle {
            justify-content: space-between;
            cursor: pointer;
        }

        .settings-toggle > a {
            color: #ffffff !important;
        }

        .settings-toggle.active {
            background: rgba(237,28,36,.12);
            color: var(--primary-red);
            font-weight: 600;
        }

        .settings-toggle.active > a {
            color: var(--primary-red) !important;
        }

        .settings-toggle.active > a i {
            color: var(--primary-red) !important;
        }

        .settings-arrow {
            color: #ffffff;
            font-size: 11px;
            transition: .3s ease;
        }

        .settings-toggle.active .settings-arrow {
            color: var(--primary-red);
        }

        .settings-toggle:hover .settings-arrow {
            color: var(--primary-red);
        }

        .settings-submenu {
            list-style: none;
            padding: 0 0 0 13px;
            margin: 3px 0 0 0;
            max-height: 0;
            overflow: hidden;
            transition: max-height .3s ease;
        }

        .settings-submenu li {
            margin: 2px 0;
        }

        .settings-submenu a {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 9px 10px;
            border-radius: 6px;
            color: #ffffff !important;
            font-size: 12px;
            font-weight: 500;
            text-decoration: none;
            transition: .2s ease;
        }

        .settings-submenu a:hover {
            background: rgba(237,28,36,.10);
            color: var(--primary-red) !important;
        }

        .settings-submenu a i {
            color: #ffffff;
            font-size: 13px;
        }

        .settings-submenu a:hover i {
            color: var(--primary-red);
        }

        .settings-submenu a.active {
            color: var(--primary-red) !important;
            background: rgba(237,28,36,.10);
            font-weight: 600;
        }

        .settings-submenu a.active i {
            color: var(--primary-red);
        }

        .sidebar-settings.open .settings-submenu {
            max-height: 150px;
        }

        .sidebar-settings.open .settings-arrow {
            transform: rotate(90deg);
        }


        /* =========================================================
           LOGOUT
        ========================================================= */

        .logout-wrapper {
            position: absolute;
            bottom: 17px;
            left: 8px;
            right: 8px;
        }

        .logout-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            color: #ffffff;
            font-size: 13px;
            font-weight: 500;
            border-radius: 5px;
            text-decoration: none;
            transition: .2s ease;
        }

        .logout-link:hover {
            color: var(--primary-red);
            background: rgba(237,28,36,.08);
        }

        .logout-link i {
            font-size: 17px;
        }


        /* =========================================================
           MAIN
        ========================================================= */

        .page-container {
            margin-left: 181px;
            padding: 88px 21px 40px;
            min-height: 100vh;
            transition: margin-left .3s ease;
        }

        .heading-section {
            margin-bottom: 22px;
        }

        .breadcrumb-text {
            font-size: 11px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 3px;
        }

        .page-title {
            font-size: 28px;
            color: #263238;
            font-weight: 700;
            margin-bottom: 2px;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 13px;
            font-weight: 500;
            margin: 0;
        }


        /* =========================================================
           TABS
        ========================================================= */

        .account-tabs {
            border-bottom: 1px solid #d9dee3;
            margin-bottom: 24px;
        }

        .account-tab {
            display: inline-flex;
            align-items: center;
            padding: 8px 0 11px;
            margin-right: 30px;
            color: #94a3b8;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            border-bottom: 2px solid transparent;
            transition: .2s ease;
            cursor: pointer;
        }

        .account-tab:hover {
            color: var(--primary-red);
        }

        .account-tab.active {
            color: var(--primary-red);
            border-bottom-color: var(--primary-red);
        }


        /* =========================================================
           TAB CONTENT
        ========================================================= */

        .tab-content-area {
            display: none;
        }

        .tab-content-area.active {
            display: block;
            animation: fadeIn .25s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(4px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }


        /* =========================================================
           PROFILE CARD
        ========================================================= */

        .account-card {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 5px 15px rgba(0,0,0,.06);
            margin-bottom: 18px;
        }

        .profile-top {
            display: flex;
            align-items: center;
            gap: 22px;
            margin-bottom: 25px;
        }

        .profile-image-wrapper {
            position: relative;
            width: 90px;
            height: 90px;
        }

        .profile-large-image {
            width: 90px;
            height: 90px;
            object-fit: cover;
            border-radius: 50%;
            border: 5px solid #ffe0a8;
            background: #fff;
        }

        .camera-btn {
            position: absolute;
            right: -2px;
            bottom: -2px;
            width: 28px;
            height: 28px;
            border: 2px solid #ffffff;
            border-radius: 50%;
            background: var(--primary-red);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            cursor: pointer;
            box-shadow: 0 3px 8px rgba(0,0,0,.15);
        }

        .camera-btn:hover {
            background: var(--dark-red);
        }

        .btn-change-photo {
            margin-top: 8px;
            padding: 5px 10px;
            font-size: 9px;
            border-radius: 6px;
            border: 1px solid var(--primary-red);
            color: var(--primary-red);
            background: #ffffff;
            font-weight: 600;
        }

        .btn-change-photo:hover {
            background: var(--light-red);
        }

        .profile-details label {
            display: block;
            color: #64748b;
            font-size: 11px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .applicant-id {
            display: inline-block;
            min-width: 130px;
            padding: 9px 12px;
            background: #f1f3f5;
            border-radius: 7px;
            color: #475569;
            font-size: 11px;
            font-weight: 600;
        }

        .id-note {
            display: block;
            color: #94a3b8;
            font-size: 9px;
            margin-top: 5px;
        }

        .form-label {
            font-size: 11px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .form-control,
        .form-select {
            height: 44px;
            border: 1px solid #e2e8f0;
            border-radius: 7px;
            font-size: 11px;
            color: #334155;
            padding: 8px 12px;
            background: #ffffff;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: var(--primary-red);
            box-shadow: 0 0 0 3px rgba(237,28,36,.10);
            outline: none;
        }

        .date-wrapper {
            position: relative;
        }

        .date-wrapper .form-control {
            padding-right: 35px;
        }

        .calendar-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            font-size: 13px;
            pointer-events: none;
        }

        .btn-action-save {
            background: var(--primary-red);
            border: none;
            color: #ffffff;
            font-size: 11px;
            font-weight: 600;
            padding: 11px 20px;
            border-radius: 6px;
            transition: .2s ease;
        }

        .btn-action-save:hover {
            background: var(--dark-red);
            color: #ffffff;
            transform: translateY(-1px);
        }


        /* =========================================================
           SECURITY
        ========================================================= */

        .security-wrapper {
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0 5px 15px rgba(0,0,0,.06);
        }

        .security-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .security-box {
            background: #ffffff;
            border: 1px solid #edf0f3;
            border-radius: 12px;
            padding: 20px;
            min-height: 190px;
            box-shadow: 0 5px 18px rgba(0,0,0,.05);
        }

        .security-box-header {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 2px;
        }

        .security-box-header i {
            color: var(--primary-red);
            font-size: 18px;
        }

        .security-box-title {
            color: #334155;
            font-size: 17px;
            font-weight: 700;
        }

        .security-description {
            color: #94a3b8;
            font-size: 10px;
            margin-bottom: 17px;
        }

        .security-small-title {
            font-size: 10px;
            color: #64748b;
            font-weight: 600;
        }

        .security-info {
            color: #475569;
            font-size: 11px;
            font-weight: 500;
        }

        .security-button {
            border: 1px solid #cbd5e1;
            background: #ffffff;
            color: #334155;
            padding: 9px 14px;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 600;
            transition: .2s ease;
        }

        .security-button:hover {
            border-color: var(--primary-red);
            color: var(--primary-red);
        }

        .password-box-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
        }

        .session-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid #edf0f3;
        }

        .session-item:last-child {
            border-bottom: none;
        }

        .session-icon {
            width: 36px;
            height: 36px;
            border-radius: 6px;
            background: #f1f5f9;
            color: #64748b;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .session-device {
            font-size: 11px;
            font-weight: 600;
            color: #475569;
        }

        .session-location {
            font-size: 9px;
            color: #64748b;
        }

        .this-device {
            color: #16a34a;
            font-weight: 700;
            margin-left: 5px;
        }

        .logout-session {
            margin-left: auto;
            padding: 6px 11px;
            border: 1px solid var(--primary-red);
            background: #ffffff;
            color: var(--primary-red);
            border-radius: 6px;
            font-size: 10px;
            font-weight: 600;
        }

        .logout-session:hover {
            background: var(--primary-red);
            color: #ffffff;
        }

        .country-select {
            width: 100%;
            height: 50px;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            padding: 10px 12px;
            color: #475569;
            font-size: 11px;
        }

        .two-factor-content {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
        }

        .two-factor-switch {
            position: relative;
            width: 38px;
            height: 21px;
            flex-shrink: 0;
        }

        .two-factor-switch input {
            display: none;
        }

        .switch-slider {
            position: absolute;
            inset: 0;
            background: #cbd5e1;
            border-radius: 20px;
            cursor: pointer;
            transition: .25s ease;
        }

        .switch-slider:before {
            content: "";
            position: absolute;
            width: 17px;
            height: 17px;
            left: 2px;
            top: 2px;
            background: #ffffff;
            border-radius: 50%;
            transition: .25s ease;
        }

        .two-factor-switch input:checked + .switch-slider {
            background: var(--primary-red);
        }

        .two-factor-switch input:checked + .switch-slider:before {
            transform: translateX(17px);
        }

        .security-save {
            display: flex;
            justify-content: flex-end;
            margin-top: 18px;
        }


        /* =========================================================
           CHANGE PASSWORD OVERLAY
        ========================================================= */

        .password-overlay {
            position: fixed;
            inset: 0;
            background: rgba(20, 25, 30, .42);
            backdrop-filter: blur(2px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 3000;
            padding: 25px;
        }

        .password-overlay.show {
            display: flex;
            animation: overlayFade .2s ease;
        }

        @@keyframes overlayFade {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .password-modal {
            width: 100%;
            max-width: 580px;
            background: #ffffff;
            border-radius: 8px;
            padding: 42px;
            position: relative;
            box-shadow: 0 20px 60px rgba(0,0,0,.20);
            animation: modalUp .25s ease;
        }

        @@keyframes modalUp {
            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .password-close {
            position: absolute;
            top: 18px;
            right: 20px;
            width: 34px;
            height: 34px;
            border: none;
            background: transparent;
            color: #94a3b8;
            font-size: 21px;
            cursor: pointer;
            border-radius: 50%;
        }

        .password-close:hover {
            background: #f1f5f9;
            color: var(--primary-red);
        }

        .password-modal-title {
            color: #111827;
            font-size: 23px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .password-modal-subtitle {
            color: #a1a1aa;
            font-size: 15px;
            margin-bottom: 34px;
        }

        .password-field-label {
            display: block;
            color: #111827;
            font-size: 15px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .password-input-wrapper {
            position: relative;
        }

        .new-password-input {
            width: 100%;
            height: 55px;
            border: 1px solid #22c55e;
            border-radius: 6px;
            background: #f1f1f1;
            padding: 10px 45px 10px 43px;
            font-size: 14px;
            color: #8a8a8a;
            outline: none;
        }

        .new-password-input:focus {
            border-color: #22c55e;
            box-shadow: 0 0 0 2px rgba(34,197,94,.12);
        }

        .password-lock-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #b8b8b8;
            font-size: 19px;
        }

        .password-eye-icon {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 17px;
            cursor: pointer;
        }

        .strength-bars {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
            margin-top: 15px;
        }

        .strength-bar {
            height: 7px;
            border-radius: 10px;
            background: var(--success);
        }

        .strength-text {
            color: var(--success);
            font-size: 10px;
            font-weight: 500;
            margin-top: 7px;
        }

        .password-rules {
            list-style: none;
            padding: 0;
            margin: 13px 0 28px;
        }

        .password-rules li {
            color: var(--success);
            font-size: 11px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .password-rules li i {
            font-size: 14px;
        }

        .match-message {
            color: var(--success);
            font-size: 10px;
            margin-top: 7px;
            padding-left: 12px;
        }

        .change-password-submit {
            width: 100%;
            height: 55px;
            border: none;
            background: var(--primary-red);
            color: #ffffff;
            border-radius: 6px;
            font-size: 17px;
            font-weight: 700;
            margin-top: 26px;
            box-shadow: 0 5px 12px rgba(237,28,36,.18);
            transition: .2s ease;
        }

        .change-password-submit:hover {
            background: var(--dark-red);
            transform: translateY(-1px);
        }


        /* =========================================================
           SIDEBAR COLLAPSE
        ========================================================= */

        body.sidebar-collapsed .navbar-left-box {
            width: 65px;
            padding: 0;
            justify-content: center;
        }

        body.sidebar-collapsed .brand-text {
            display: none;
        }

        body.sidebar-collapsed .sidebar-menu-wrapper {
            width: 65px;
            padding-left: 6px;
            padding-right: 6px;
        }

        body.sidebar-collapsed .sidebar-link-item {
            justify-content: center;
            padding-left: 0;
            padding-right: 0;
            gap: 0;
        }

        body.sidebar-collapsed .sidebar-link-text {
            display: none;
        }

        body.sidebar-collapsed .settings-arrow {
            display: none;
        }

        body.sidebar-collapsed .settings-submenu {
