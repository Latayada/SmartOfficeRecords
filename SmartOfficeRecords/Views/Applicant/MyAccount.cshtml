                </div>


                <!-- SETTINGS SUBMENU -->

                <ul class="settings-submenu"
                    id="settingsMenu">

                    <!-- GENERAL SETTINGS NOT ACTIVE -->

                    <li>

                        <a href="@Url.Action("Settings", "Applicant")">

                            <i class="bi bi-shield-lock"></i>

                            <span class="sidebar-link-text">
