@{
    ViewBag.Title = "Profile";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Account - Smart Office Records System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #eaf6ed; /* Light mint background */
            min-height: 100vh;
            color: #334155;
            padding-top: 70px; /* Offset fixed navbar */
        }

        /* --- NAVBAR STYLING --- */
        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 0;
            z-index: 1030;
            height: 70px;
        }

        /* White Logo Brand Box Container */
        .navbar-left-box {
            display: flex;
            align-items: center;
            width: 260px;
            height: 100%;
            padding: 0 24px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            transition: width 0.3s ease, padding 0.3s ease;
        }

        /* Dedicated Light Green Toggle Zone Box from Image */
        .toggle-zone-box {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            width: 70px;
        }

        .sidebar-toggle-btn {
            background: none;
            border: none;
            color: #16a34a; /* Green hamburger menu icon */
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 10px;
        }

            .navbar-brand-custom img {
                width: 42px;
                height: 42px;
                object-fit: contain;
            }

        .brand-text {
            color: #0f6328;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 0.5px;
        }

        /* --- NAVBAR PROFILE AND UTILITY --- */
        .navbar-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-left: auto;
        }

        .notification-btn {
            background: none;
            border: none;
            color: #64748b;
            font-size: 20px;
            position: relative;
            cursor: pointer;
        }

        .profile-widget {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8fafc;
            padding: 6px 12px;
            border-radius: 30px;
            border: 1px solid #e2e8f0;
            cursor: pointer;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #ffb74d;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 13px;
        }

        .profile-info {
            text-align: left;
            line-height: 1.2;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 600;
            color: #1e293b;
            display: block;
        }

        .profile-email {
            font-size: 10px;
            color: #64748b;
            display: block;
        }

        /*==============================
                                    PROFILE DROPDOWN
                                ==============================*/

        .profile-container {
            position: relative;
        }

        .profile-widget {
            cursor: pointer;
            user-select: none;
        }

        .profile-arrow {
            transition: .3s;
        }

        .profile-dropdown-custom {
            position: absolute;
            right: 0;
            top: 115%;
            width: 230px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            box-shadow: 0 12px 30px rgba(0,0,0,.08);
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            visibility: hidden;
            transition: max-height .35s ease, opacity .25s ease, transform .25s ease;
            transform: translateY(-10px);
        }

            .profile-dropdown-custom a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 18px;
                text-decoration: none;
                color: #475569;
                font-weight: 500;
                transition: .25s;
            }

                .profile-dropdown-custom a:hover {
                    background: #f0fdf4;
                    color: #16a34a;
                }

                .profile-dropdown-custom a i {
                    font-size: 18px;
                }

        .profile-container.open .profile-dropdown-custom {
            max-height: 200px;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-container.open .profile-arrow {
            transform: rotate(180deg);
        }

        /* --- VERTICAL SIDEBAR MENU STYLING --- */
        .sidebar-menu-wrapper {
            position: fixed;
            top: 70px;
            left: 0;
            bottom: 0;
            width: 260px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            padding: 24px 16px;
            overflow-y: auto;
            z-index: 1020;
            transition: width 0.3s ease, padding 0.3s ease;
        }

        .sidebar-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-link-item {
            text-decoration: none;
            color: #64748b;
            font-weight: 500;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .sidebar-link-item i {
                font-size: 20px;
                min-width: 24px;
                display: inline-flex;
                justify-content: center;
            }

            .sidebar-link-item:hover,
            .sidebar-submenu a:hover {
                color: #16a34a;
                background-color: #f0fdf4;
            }

            .sidebar-link-item.active,
            .sidebar-submenu a.active {
                color: #16a34a;
                background-color: #f0fdf4;
                font-weight: 600;
            }

        /* --- LAYOUT WORKSPACE CONTAINER --- */
        .page-container {
            margin-left: 260px;
            padding: 40px 30px;
            width: calc(100% - 260px);
            transition: margin-left 0.3s ease;
        }

        /* ==========================================================================
                                            DRIVEN COLLAPSE STYLES
                                           ========================================================================== */

        body.sidebar-collapsed .navbar-left-box {
            width: 76px;
            padding: 0;
            justify-content: center;
        }

        body.sidebar-collapsed .brand-text {
            display: none;
        }

        body.sidebar-collapsed .sidebar-menu-wrapper {
            width: 76px;
            padding: 24px 10px;
        }

        body.sidebar-collapsed .sidebar-link-text {
            display: none;
        }

        body.sidebar-collapsed .sidebar-link-item {
            justify-content: center;
            padding: 12px 0;
            gap: 0;
        }

        body.sidebar-collapsed .page-container {
            margin-left: 76px;
            width: calc(100% - 76px);
        }

        /* --- CONTENT BODY STYLING --- */
        .heading-section {
            margin-bottom: 35px;
        }

        .page-title {
            color: #16a34a;
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 14px;
            font-weight: 500;
            margin: 0;
        }

        .account-card {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
            height: 100%;
        }

        .section-title-custom {
            font-size: 18px;
            font-weight: 700;
            color: #475569;
            margin-bottom: 30px;
            display: flex;
            align-items: center;
            gap: 10px;
            max-width: 1000px;
            margin: 0 auto;
        }

            .section-title-custom i {
                color: #16a34a;
            }

        /* --- LIST DISPLAY --- */
        .profile-info-table {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 35px;
        }

        .profile-info-row {
            display: flex;
            align-items: flex-start;
        }

        .profile-info-label-block {
            display: flex;
            align-items: center;
            gap: 14px;
            width: 200px;
            flex-shrink: 0;
            color: #64748b;
        }

            .profile-info-label-block i {
                font-size: 22px;
                color: #64748b;
                display: flex;
                align-items: center;
                justify-content: center;
                width: 24px;
            }

        .profile-info-label-text {
            font-size: 15px;
            font-weight: 500;
        }

        .profile-info-value {
            font-size: 15px;
            font-weight: 500;
            color: #475569;
            line-height: 1.5;
        }

        .status-pill-active {
            background-color: #6ee7b7;
            color: #000000;
            font-weight: 700;
            font-size: 13px;
            padding: 4px 20px;
            border-radius: 8px;
            display: inline-block;
        }

        .btn-edit-profile-outline {
            background: transparent;
            color: #16a34a;
            font-weight: 700;
            font-size: 18px;
            padding: 12px;
            border-radius: 10px;
            border: 2px solid #16a34a;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            transition: all 0.2s ease;
        }

            .btn-edit-profile-outline:hover {
                background-color: #f0fdf4;
                transform: translateY(-1px);
            }

       

        @@media (max-width: 991px) {
            .profile-info-row

        {
            flex-direction: column;
            gap: 4px;
        }

        .profile-info-label-block {
            width: 100%;
        }

        }

        /* SETTINGS */
        .sidebar-settings {
            list-style: none;
        }

        .settings-toggle {
            justify-content: space-between;
        }
            /* Parent active */
            .settings-toggle.active {
                background: #f0fdf4;
                color: #16a34a;
                font-weight: 600;
            }
        /* Child active */
        .settings-submenu a.active {
            background: #f0fdf4;
            color: #16a34a;
            font-weight: 600;
        }

        .settings-arrow {
            font-size: 14px;
            transition: .3s;
            color: #64748b;
        }

        .settings-submenu {
            list-style: none;
            padding-left: 18px;
            margin-top: 5px;
            max-height: 0;
            overflow: hidden;
            transition: max-height .35s ease;
        }


            .settings-submenu li {
                margin: 5px 0;
            }

            .settings-submenu a {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                color: #64748b;
                padding: 10px 15px;
                border-radius: 8px;
                font-size: 14px;
                transition: .3s;
            }

                .settings-submenu a:hover {
                    background: #f0fdf4;
                    color: #16a34a;
                }

        .sidebar-settings.open .settings-submenu {
            max-height: 200px;
        }

        .sidebar-settings.open .settings-arrow {
            transform: rotate(90deg);
        }

        /* Hide submenu text when sidebar collapses */
        body.sidebar-collapsed .settings-submenu {
            display: none !important;
        }

        body.sidebar-collapsed .settings-arrow {
            display: none;
        }

       

             /* --- NOTIFICATION DROPDOWN MENU --- */
        .notification-dropdown-custom {
            position: absolute;
            right: 0;
            top: 115%;
            width: 340px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            visibility: hidden;
            transition: max-height 0.35s ease, opacity 0.25s ease, transform 0.25s ease;
            transform: translateY(-10px);
            z-index: 1050;
        }

        .notification-container.open .notification-dropdown-custom {
            max-height: 480px;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* Header */
        .notif-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            border-bottom: 1px solid #f1f5f9;
            background-color: #ffffff;
        }

        .notif-header-title {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
        }

        .notif-mark-read {
            font-size: 11px;
            color: #16a34a;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s;
        }

            .notif-mark-read:hover {
                color: #15803d;
                text-decoration: underline;
            }

        /* List Body */
        .notif-body {
            max-height: 320px;
            overflow-y: auto;
        }

        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 12px 18px;
            text-decoration: none;
            border-bottom: 1px solid #f8fafc;
            transition: background-color 0.2s;
        }

            .notif-item:hover {
                background-color: #f0fdf4;
            }

            .notif-item.unread {
                background-color: #f7fee7;
            }

        .notif-icon-box {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 15px;
        }

        .notif-icon-success {
            background-color: #dcfce7;
            color: #16a34a;
        }

        .notif-icon-warning {
            background-color: #fef3c7;
            color: #d97706;
        }

        .notif-content {
            flex: 1;
        }

        .notif-text {
            font-size: 12px;
            color: #334155;
            font-weight: 500;
            line-height: 1.4;
            margin-bottom: 2px;
        }

        .notif-time {
            font-size: 10px;
            color: #94a3b8;
        }

        /* Footer */
        .notif-footer {
            padding: 10px;
            text-align: center;
            background-color: #fafafa;
            border-top: 1px solid #f1f5f9;
        }

        .notif-footer-btn {
            font-size: 12px;
            font-weight: 600;
            color: #16a34a;
            text-decoration: none;
        }

            .notif-footer-btn:hover {
                text-decoration: underline;
            }

        /*==============================
            ACCOUNT PAGE NEW DESIGN
        ==============================*/

        .heading-section {
            margin-bottom: 30px;
        }

        .page-title {
            font-size: 30px;
            font-weight: 700;
            color: #16a34a;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 15px;
        }

        .account-card {
            background: #fff;
            border-radius: 16px;
            padding: 30px;
            border: 1px solid #e5e7eb;
            box-shadow: 0 8px 25px rgba(0,0,0,.05);
        }

        .section-title-green {
            color: #16a34a;
            font-size: 22px;
            font-weight: 700;
        }

        /*==============================
            PROFILE IMAGE
        ==============================*/

        .profile-image-wrapper {
            position: relative;
            width: 170px;
            margin: auto;
        }

        .profile-large-image {
            width: 170px;
            height: 170px;
            object-fit: cover;
            border-radius: 50%;
            border: 6px solid #dcfce7;
        }

        .camera-btn {
            position: absolute;
            right: 5px;
            bottom: 5px;
            width: 45px;
            height: 45px;
            border: none;
            border-radius: 50%;
            background: #16a34a;
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 18px;
            box-shadow: 0 5px 15px rgba(0,0,0,.2);
        }

            .camera-btn:hover {
                background: #15803d;
            }

        .btn-change-photo {
            font-weight: 600;
            border-radius: 10px;
            height: 48px;
        }

        /*==============================
        STATUS
        ==============================*/

        .status-review {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: #FEF3C7;
            color: #B45309;
            padding: 10px 18px;
            border-radius: 30px;
            font-weight: 600;
        }

        .status-text {
            font-size: 14px;
            color: #64748b;
            line-height: 1.7;
        }

        /*==============================
        FORM
        ==============================*/

        .form-label {
            font-weight: 600;
            color: #374151;
        }

        .form-control,
        .form-select {
            height: 50px;
            border-radius: 10px;
            border: 1px solid #d1d5db;
        }

            .form-control:focus,
            .form-select:focus {
                border-color: #16a34a;
                box-shadow: 0 0 0 .2rem rgba(22,163,74,.15);
            }

        /*==============================
        CALENDAR
        ==============================*/

        .position-relative {
            position: relative;
        }

        .calendar-icon {
            position: absolute;
            right: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #64748b;
            pointer-events: none;
        }

        /*==============================
        PASSWORD
        ==============================*/

        .password-wrapper {
            position: relative;
        }

        .password-toggle {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);
            color: #6b7280;
            cursor: pointer;
            font-size: 18px;
        }

        /*==============================
        BUTTONS
        ==============================*/

        .btn-action-save {
            background: #16a34a;
            border: none;
            padding: 12px 35px;
            border-radius: 10px;
            font-weight: 600;
        }

            .btn-action-save:hover {
                background: #15803d;
            }

        .btn-action-cancel {
            border-radius: 10px;
            padding: 12px 35px;
            font-weight: 600;
        }

        /*=======================
                RESPONSIVE
        =========================*/

        @@media (max-width:991px) {
            .profile-image-wrapper

        {
            width: 140px;
        }

        .profile-large-image {
            width: 140px;
            height: 140px;
        }

        }
    </style>
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top d-flex flex-row align-items-center justify-content-start">

        <div class="navbar-left-box" id="navLeftBox">
            <a class="navbar-brand-custom" href="#">
                <img src="~/Images/logo.png" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <div class="brand-text" id="brandText">SORS</div>
            </a>
        </div>

        <div class="toggle-zone-box">
            <button class="sidebar-toggle-btn" id="toggleSidebar" title="Toggle Menu">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <div class="navbar-profile pe-4">
            <!-- NOTIFICATION CONTAINER -->
            <div class="notification-container">
                <button class="notification-btn" id="notificationToggle" title="Notifications">
                    <i class="bi bi-bell"></i>
                    <!-- Unread Badge Indicator -->
                    <span class="notification-badge-dot"></span>
                </button>

                <!-- DROPDOWN POPUP -->
                <div class="notification-dropdown-custom" id="notificationMenu">
                    <div class="notif-header">
                        <span class="notif-header-title">Notifications</span>
                        <a href="#" class="notif-mark-read">Mark all as read</a>
                    </div>

                    <div class="notif-body">
                        <!-- Approved Notification Item -->
                        <a href="#" class="notif-item unread">
                            <div class="notif-icon-box notif-icon-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="notif-content">
                                <div class="notif-text">Your interview request <strong>#RI01</strong> was approved.</div>
                                <div class="notif-time">10 mins ago</div>
                            </div>
                        </a>

                        <!-- Pending Notification Item -->
                        <a href="#" class="notif-item">
                            <div class="notif-icon-box notif-icon-warning">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div class="notif-content">
                                <div class="notif-text">Reminder: Upload missing requirements for <strong>RI02</strong>.</div>
                                <div class="notif-time">2 hours ago</div>
                            </div>
                        </a>
                    </div>

                    <div class="notif-footer">
                        <a href="#" class="notif-footer-btn">View All Notifications</a>
                    </div>
                </div>
            </div>

            <div class="profile-container">

                <div class="profile-widget" id="profileToggle">

                    <div class="profile-avatar">
                        MG
                    </div>

                    <div class="profile-info">
                        <span class="profile-name">Mary Grace</span>
                        <span class="profile-email">smartoffice@gmail.com</span>
                    </div>

                    <i class="bi bi-chevron-down profile-arrow ms-2"></i>

                </div>

                <div class="profile-dropdown-custom" id="profileMenu">

                    <a href="@Url.Action("MyAccount", "Applicant")">
                        <i class="bi bi-person-circle"></i>
                        My Account
                    </a>

                    <a href="@Url.Action("ApplicantLogin", "Applicant")" class="text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        Sign Out
                    </a>

                </div>

            </div>
        </div>
    </nav>

    <!-- LEFT SIDEBAR NAV MENU -->
    <aside class="sidebar-menu-wrapper" id="sidebarMenu">
        <ul class="sidebar-links">
            <li>
                <a href="@Url.Action("ApplicantDash", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-house-door-fill"></i>
                    <span class="sidebar-link-text">Dashboard</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("BookInterview", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                    <span class="sidebar-link-text">Book Interview</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("MyAppointment", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-person-bounding-box"></i>
                    <span class="sidebar-link-text">My Appointment</span>
                </a>
            </li>

            <!-- Open by default on Settings page -->
            <li class="sidebar-settings">
                <div class="sidebar-link-item settings-toggle">

                    <a href="@Url.Action("Settings", "Applicant")"
                       class="d-flex align-items-center flex-grow-1 text-decoration-none text-reset">

                        <i class="bi bi-gear-fill"></i>
                        <span class="sidebar-link-text ms-2">
                            Settings & Account
                        </span>

                    </a>

                    <i class="bi bi-chevron-right settings-arrow"
                       id="settingsToggle"></i>

                </div>

                <ul class="settings-submenu" id="settingsMenu">
                    <li>
                        <a href="@Url.Action("Settings", "Applicant")" id="settingsLink">
                            <i class="bi bi-shield-lock"></i>
                            <span class="sidebar-link-text">Settings</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("MyAccount", "Applicant")" class="sidebar-link-item active">
                            <i class="bi bi-person-circle"></i>
                            <span class="sidebar-link-text">My Account</span>
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
    </aside>

    <!-- CONTENT BODY -->
    <div class="page-container">

        <!-- Page Title -->
        <div class="heading-section mb-4">
            <h2 class="page-title">Account</h2>
            <p class="page-subtitle">
                Edit and secure your account.
            </p>
        </div>

        <div class="row">

            <!-- LEFT PROFILE -->
            <div class="col-lg-4 mb-4">

                <div class="account-card text-center h-100">

                    <div class="profile-image-wrapper mb-4">

                        <img src="https://cdn-icons-png.flaticon.com/512/847/847969.png"
                             class="profile-large-image"
                             id="profilePreview">

                        <button class="camera-btn" id="changePhotoBtn">
                            <i class="bi bi-camera-fill"></i>
                        </button>

                        <input type="file"
                               id="profilePhotoInput"
                               accept="image/*"
                               hidden>

                    </div>

                    <button class="btn btn-outline-success btn-change-photo w-100 mb-4">
                        <i class="bi bi-camera"></i>
                        Change Photo
                    </button>

                    <div class="text-start">

                        <label class="small text-secondary">
                            Applicant ID
                        </label>

                        <h4 class="fw-bold">
                            APP-000123
                        </h4>

                    </div>

                </div>

            </div>

            <!-- RIGHT -->
            <div class="col-lg-8">

                <div class="account-card">

                    <h4 class="section-title-green mb-4">
                        Personal Information
                    </h4>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label class="form-label">First Name</label>
                            <input type="text" class="form-control" value="John">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Last Name</label>
                            <input type="text" class="form-control" value="Cruz">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email Address</label>
                            <input type="email"
                                   class="form-control"
                                   value="johncruz@gmail.com">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Mobile Number</label>
                            <input type="text"
                                   class="form-control"
                                   value="0912 345 6789">
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Birthdate</label>

                            <div class="position-relative">

                                <input type="date"
                                       class="form-control pe-5"
                                       value="2004-01-01">

                                <i class="bi bi-calendar3 calendar-icon"></i>

                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-4">

                <div class="col-12">

                    <div class="account-card">

                        <h4 class="section-title-green mb-4">
                            Account Security
                        </h4>

                        <div class="row">

                            <!-- Current Password -->
                            <div class="col-lg-4 mb-3">

                                <label class="form-label">
                                    Current Password
                                </label>

                                <div class="password-wrapper">

                                    <input type="password"
                                           class="form-control password-input"
                                           placeholder="Enter current password">

                                    <i class="bi bi-eye password-toggle"></i>

                                </div>

                            </div>

                            <!-- New Password -->
                            <div class="col-lg-4 mb-3">

                                <label class="form-label">
                                    New Password
                                </label>

                                <div class="password-wrapper">

                                    <input type="password"
                                           class="form-control password-input"
                                           placeholder="Enter new password">

                                    <i class="bi bi-eye password-toggle"></i>

                                </div>

                            </div>

                            <!-- Confirm Password -->
                            <div class="col-lg-4 mb-3">

                                <label class="form-label">
                                    Confirm Password
                                </label>

                                <div class="password-wrapper">

                                    <input type="password"
                                           class="form-control password-input"
                                           placeholder="Confirm new password">

                                    <i class="bi bi-eye password-toggle"></i>

                                </div>

                            </div>

                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-end gap-3">

                            <button class="btn btn-outline-secondary btn-action-cancel">

                                Cancel

                            </button>

                            <button class="btn btn-success btn-action-save">

                                Save Changes

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    <script>
        // Toggle Sidebar
        document.getElementById('toggleSidebar').addEventListener('click', function () {
            document.body.classList.toggle('sidebar-collapsed');
        });

        // Settings expand/collapse
                   const settingsToggle = document.getElementById("settingsToggle");
        const settingsParent = document.querySelector(".settings-toggle");
        const settingsGroup = document.querySelector(".sidebar-settings");
        const settingsLink = document.getElementById("settingsLink");

        // Open Settings menu
        settingsToggle.addEventListener("click", function (e) {

            e.preventDefault();
            e.stopPropagation();

            settingsGroup.classList.toggle("open");

            // Make Settings & Account active
            settingsParent.classList.add("active");
        });

        // Click Settings
        settingsLink.addEventListener("click", function () {

            // Parent remains active
            settingsParent.classList.add("active");

            // Child becomes active
            settingsLink.classList.add("active");

        });

        // Profile dropdown
        const profileContainer = document.querySelector(".profile-container");
        const profileToggle = document.getElementById("profileToggle");

        profileToggle.addEventListener("click", function (e) {
            e.stopPropagation();
            profileContainer.classList.toggle("open");
        });

        document.addEventListener("click", function (e) {
            if (!profileContainer.contains(e.target)) {
                profileContainer.classList.remove("open");
            }
        });

        // Notification dropdown toggle
        const notificationContainer = document.querySelector(".notification-container");
        const notificationToggle = document.getElementById("notificationToggle");

        notificationToggle.addEventListener("click", function (e) {
            e.stopPropagation();
            // Close profile menu if it's open
            profileContainer.classList.remove("open");
            // Toggle notification menu
            notificationContainer.classList.toggle("open");
        });

        // Close when clicking anywhere outside
        document.addEventListener("click", function (e) {
            if (!notificationContainer.contains(e.target)) {
                notificationContainer.classList.remove("open");
            }
        });

            // ================================
            // CHANGE PROFILE PHOTO
            // ================================
            const cameraBtn = document.getElementById("changePhotoBtn");
            const photoInput = document.getElementById("profilePhotoInput");
            const preview = document.getElementById("profilePreview");
            if (cameraBtn) {

                cameraBtn.addEventListener("click", function () {

                    photoInput.click();

                });

            }
            if (photoInput) {

                photoInput.addEventListener("change", function () {

                    if (this.files.length > 0) {

                        const reader = new FileReader();

                        reader.onload = function (e) {

                            preview.src = e.target.result;

                        };

                        reader.readAsDataURL(this.files[0]);
                    }
                });
            }

            // ================================
            // SHOW / HIDE PASSWORD
            // ================================

            const passwordIcons = document.querySelectorAll(".password-toggle");

            passwordIcons.forEach(function (icon) {

                icon.addEventListener("click", function () {

                    const input = this.previousElementSibling;

                    if (input.type === "password") {

                        input.type = "text";

                        this.classList.remove("bi-eye");
                        this.classList.add("bi-eye-slash");

                    }

                    else {

                        input.type = "password";

                        this.classList.remove("bi-eye-slash");
                        this.classList.add("bi-eye");

                    }

                });

            });

            // ================================
            // SAVE CHANGES
            // ================================

            const saveButton = document.querySelector(".btn-action-save");

            if (saveButton) {

                saveButton.addEventListener("click", function () {

                    alert("Profile updated successfully!");

                });

            }

            // ================================
            // CANCEL
            // ================================

            const cancelButton = document.querySelector(".btn-action-cancel");

            if (cancelButton) {

                cancelButton.addEventListener("click", function () {

                    if (confirm("Discard all changes?")) {

                        location.reload();

                    }

                });

            }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>