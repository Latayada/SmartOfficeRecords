@{
    ViewBag.Title = "My Appointments";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Appointments</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #eaf6ed; /* Light mint background */
            min-height: 100vh;
            color: #334155;
            padding-top: 70px; /* Add this line to offset the fixed navbar height */
        }

        /* --- NAVBAR STYLING --- */
        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 12px 24px;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 10px;
        }

            .navbar-brand-custom img {
                width: 40px;
                height: 40px;
                object-fit: contain;
            }

        .brand-text {
            color: #0f6328;
            font-weight: 700;
            line-height: 1.1;
            font-size: 14px;
            letter-spacing: 0.5px;
        }

            .brand-text span {
                color: #1e293b;
                font-weight: 500;
                font-size: 12px;
            }

        .nav-links-custom {
            display: flex;
            gap: 30px;
            list-style: none;
            margin: 0;
            padding: 0;
            align-items: center;
        }

        .nav-link-custom {
            text-decoration: none;
            color: #64748b;
            font-weight: 500;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }

            .nav-link-custom:hover {
                color: #16a34a;
            }

            .nav-link-custom.active {
                color: #16a34a;
                border-bottom: 2px solid #16a34a;
                padding-bottom: 4px;
                font-weight: 600;
            }

        .navbar-profile {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .notification-btn {
            background: none;
            border: none;
            color: #64748b;
            font-size: 20px;
            position: relative;
            cursor: pointer;
        }

        .profile-widget {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8fafc;
            padding: 6px 12px;
            border-radius: 30px;
            border: 1px solid #e2e8f0;
            cursor: pointer;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #ffb74d; /* Yellow/Orange avatar placeholder */
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 13px;
        }

        .profile-info {
            text-align: left;
            line-height: 1.2;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 600;
            color: #1e293b;
            display: block;
        }

        .profile-email {
            font-size: 10px;
            color: #64748b;
            display: block;
        }

        .profile-dropdown {
            min-width: 220px;
            border-radius: 16px;
            border: 1px solid #dbe4dc;
            padding: 10px 0;
            margin-top: 12px;
        }

            .profile-dropdown .dropdown-item {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 12px 18px;
                font-size: 15px;
                font-weight: 500;
                color: #374151;
            }

                .profile-dropdown .dropdown-item i {
                    font-size: 18px;
                    width: 20px;
                }

                .profile-dropdown .dropdown-item:hover {
                    background: #f0fdf4;
                    color: #16a34a;
                }

        .profile-widget::after {
            display: none;
        }

        /* --- CONTENT BODY STYLING --- */
        .page-container {
            max-width: 1300px;
            margin: 0 auto;
            padding: 40px 20px;
        }

        .heading-section {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 35px;
        }

        .page-title {
            color: #16a34a;
            font-size: 26px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .page-subtitle {
            color: #64748b;
            font-size: 14px;
            font-weight: 500;
            margin: 0;
        }

       
        /* Main Container Box */
        .schedules-card {
            background: white;
            border-radius: 8px;
            border: none;
            padding: 40px;
            min-height: 500px;
        }

        .card-header-flex {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .card-title-custom {
            font-size: 16px;
            font-weight: 700;
            color: #475569;
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0;
        }

            .card-title-custom i {
                color: #16a34a;
                font-size: 20px;
            }

        /* Search input styling */
        .search-wrapper {
            position: relative;
            width: 300px;
        }

            .search-wrapper i {
                position: absolute;
                left: 12px;
                top: 50%;
                transform: translateY(-50%);
                color: #16a34a;
            }

        .search-input {
            width: 100%;
            padding: 8px 12px 8px 36px;
            font-size: 12px;
            border: 1px solid #16a34a;
            border-radius: 6px;
            outline: none;
        }

            .search-input::placeholder {
                color: #94a3b8;
            }

        .section-table-title {
            font-size: 15px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 12px;
        }

        /* --- CUSTOM TABLE STYLING --- */
        .custom-table-container {
            border: 1px solid #16a34a;
            border-radius: 8px;
            overflow: hidden;
        }

        .custom-table {
            width: 100%;
            border-collapse: collapse;
            margin: 0;
        }

            .custom-table th {
                background-color: #eaf6ed;
                color: #000000;
                font-weight: 700;
                font-size: 14px;
                padding: 14px 20px;
                text-align: left;
                border-bottom: 1px solid #16a34a;
            }

            .custom-table td {
                padding: 20px;
                vertical-align: middle;
                font-size: 12px;
                color: #334155;
                background-color: #ffffff;
            }

        /* Table Columns Content styling */
        .datetime-flex {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .datetime-item {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #334155;
            font-weight: 500;
        }

            .datetime-item i {
                color: #64748b;
            }

        /* Status Pill and Context Subtext */
        .status-wrapper {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .status-pill-pending {
            background-color: #ffe0b2;
            color: #e65100;
            font-weight: 600;
            font-size: 10px;
            padding: 4px 12px;
            border-radius: 4px;
            width: fit-content;
        }

        .status-subtext {
            font-size: 10px;
            color: #64748b;
        }

        .status-confirmed {
            font-weight: 600;
            color: #334155;
        }

        /* Action Row Buttons */
        .action-wrapper {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .btn-row {
            display: flex;
            gap: 8px;
        }

        .btn-action-edit {
            background: white;
            color: #16a34a;
            border: 1px solid #16a34a;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
            padding: 4px 12px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-action-edit:hover {
                background-color: #f0fdf4;
                color: #16a34a;
            }

        .btn-action-cancel {
            background: white;
            color: #dc3545;
            border: 1px solid #dc3545;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 500;
            padding: 4px 12px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            transition: all 0.2s;
        }

            .btn-action-cancel:hover {
                background-color: #fff5f5;
                color: #dc3545;
            }

        .action-subtext {
            font-size: 10px;
            color: #64748b;
            line-height: 1.3;
        }

        /* Responsive UI Breakpoints */
        @@media (max-width: 991px) {
            .heading-section

        {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .date-pill-container {
            align-self: flex-start;
        }

        .nav-links-custom {
            display: none;
        }

        .card-header-flex {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .search-wrapper {
            width: 100%;
        }

        .custom-table th, .custom-table td {
            padding: 12px;
        }

        }
    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top">
        <div class="container-fluid d-flex justify-content-between align-items-center">

            <!-- Left: Brand Logo -->
            <a class="navbar-brand-custom" href="#">
                <img src="~/Images/logo.png" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <div class="brand-text">
                    SMART OFFICE<br />
                    <span>RECORDS SYSTEM</span>
                </div>
            </a>

            <!-- Center: Navigation Links -->
            <ul class="nav-links-custom">
                <li>
                    <a href="@Url.Action("ApplicantDash", "Applicant")" class="nav-link-custom">
                        <i class="bi bi-house-door-fill"></i> Home
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("BookInterview", "Applicant")" class="nav-link-custom">
                        <i class="bi bi-file-earmark-spreadsheet-fill"></i> Book Interview
                    </a>
                </li>
                <li>
                    <a href="@Url.Action("MyAppointment", "Applicant")" class="nav-link-custom active">
                        <i class="bi bi-person-bounding-box"></i> My Appointment
                    </a>
                </li>
            </ul>

            <!-- Right: Notifications & Profile -->
            <div class="navbar-profile">

                <button class="notification-btn" title="Notifications">
                    <i class="bi bi-bell"></i>
                </button>

                <div class="dropdown">

                    <div class="profile-widget"
                         data-bs-toggle="dropdown"
                         aria-expanded="false">

                        <div class="profile-avatar">MG</div>

                        <div class="profile-info">
                            <span class="profile-name">Mary Grace</span>
                            <span class="profile-email">smartoffice@gmail.com</span>
                        </div>

                        <i class="bi bi-chevron-down text-muted ms-2"></i>
                    </div>

                    <ul class="dropdown-menu dropdown-menu-end profile-dropdown shadow">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("MyAccount", "Applicant")">
                                <i class="bi bi-person-circle"></i>
                                My Account
                            </a>
                        </li>

                        <li><hr class="dropdown-divider"></li>

                        <li>
                            <a class="dropdown-item text-danger"
                               href="@Url.Action("ApplicantLogin", "Applicant")">
                                <i class="bi bi-box-arrow-right"></i>
                                Sign out
                            </a>
                        </li>
                    </ul>

                </div>

            </div>

        </div>
    </nav>

    <!-- CONTENT BODY -->
    <div class="page-container">

        <!-- Top Heading Layout -->
        <div class="heading-section">
            <div>
                <h1 class="page-title">My Appointments</h1>
                <p class="page-subtitle">View your schedule interview details below.</p>
            </div>

        </div>

        <!-- Main Display Panel Container -->
        <div class="schedules-card">

            <!-- Card Header with Title and Search Input -->
            <div class="card-header-flex">
                <h2 class="card-title-custom">
                    <i class="bi bi-calendar-event-fill"></i> Schedules Interviews
                </h2>
                <div class="search-wrapper">
                    <i class="bi bi-search"></i>
                    <input type="text" class="search-input" placeholder="Search here...">
                </div>
            </div>

            <!-- SECTION 1: Upcoming Appointment -->
            <div class="mb-5">
                <h3 class="section-table-title">Upcoming appointment</h3>
                <div class="custom-table-container">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th style="width: 25%;">Purpose</th>
                                <th style="width: 25%;">Date</th>
                                <th style="width: 15%;">Time</th>
                                <th style="width: 20%;">Office</th>
                                <th style="width: 15%;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Document Verification</td>
                                <td>
                                    <div class="datetime-item">
                                        <i class="bi bi-calendar3"></i> July 15, 2026 (Wednesday)
                                    </div>
                                </td>
                                <td>
                                    <div class="datetime-item">
                                        <i class="bi bi-clock"></i> 09:00 AM
                                    </div>
                                </td>
                                <td>Work Avenue and Business Solutions Inc.</td>
                                <td class="status-confirmed">CONFIRMED</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- SECTION 2: Appointment History -->
            <div>
                <h3 class="section-table-title">Appointment History</h3>
                <div class="custom-table-container">
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th style="width: 30%;">Interview Details</th>
                                <th style="width: 30%;">Date & Time</th>
                                <th style="width: 20%;">Status</th>
                                <th style="width: 20%;">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>July 15, 2026 (Wednesday)</td>
                                <td>
                                    <div class="datetime-flex">
                                        <div class="datetime-item">
                                            <i class="bi bi-calendar3"></i> July 15, 2026 (Wednesday)
                                        </div>
                                        <div class="datetime-item">
                                            <i class="bi bi-clock"></i> 09:00 AM
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="status-wrapper">
                                        <span class="status-pill-pending">Pending</span>
                                        <span class="status-subtext">Waiting for an admin review</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-wrapper">
                                        <div class="btn-row">
                                            <a href="#" class="btn-action-edit"><i class="bi bi-pencil"></i> Edit</a>
                                            <a href="#" class="btn-action-cancel"><i class="bi bi-trash"></i> Cancel</a>
                                        </div>
                                        <span class="action-subtext">Edit or Cancel is available only while pending.</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>