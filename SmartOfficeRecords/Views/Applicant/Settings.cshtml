@{
    ViewBag.Title = "Settings";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Settings - SORS</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #f5f6f7;
            min-height: 100vh;
            color: #1f2937;
        }

        /* =========================================================
                   TOP NAVBAR
                ========================================================= */

        .navbar-custom {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: 78px;
            background: #ffffff;
            border-bottom: 1px solid #e5e7eb;
            display: flex;
            align-items: center;
            z-index: 1030;
        }

        /* Logo area */
        .navbar-left-box {
            width: 175px;
            height: 78px;
            background: #222c33;
            display: flex;
            align-items: center;
            padding: 0 20px;
            border-bottom: 1px solid rgba(255,255,255,.15);
            transition: .3s ease;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
        }

            .navbar-brand-custom img {
                width: 38px;
                height: 38px;
                object-fit: contain;
                border-radius: 50%;
            }

        .brand-text {
            color: #ffffff;
            font-size: 15px;
            font-weight: 700;
            letter-spacing: .3px;
        }

        /* Hamburger */
        .toggle-zone-box {
            width: 65px;
            height: 78px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sidebar-toggle-btn {
            border: none;
            background: transparent;
            color: #ed1c24;
            font-size: 20px;
            cursor: pointer;
            width: 40px;
            height: 40px;
        }

            .sidebar-toggle-btn:hover {
                color: #c9151c;
            }

        /* Right navbar */
        .navbar-profile {
            margin-left: auto;
            height: 100%;
            display: flex;
            align-items: center;
            gap: 15px;
            padding-right: 20px;
        }

        /* Notification */
        .notification-container {
            position: relative;
        }

        .notification-btn {
            width: 40px;
            height: 40px;
            border: none;
            background: transparent;
            color: #333b42;
            font-size: 21px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            .notification-btn:hover {
                color: #ed1c24;
            }

        .notification-badge-dot {
            position: absolute;
            width: 7px;
            height: 7px;
            background: #ed1c24;
            border-radius: 50%;
            top: 6px;
            right: 7px;
        }

        /* Profile */
        .profile-container {
            position: relative;
        }

        .profile-widget {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #f7f7f7;
            border: 1px solid #e5e7eb;
            border-radius: 25px;
            padding: 5px 10px 5px 6px;
            cursor: pointer;
            min-width: 135px;
        }

            .profile-widget:hover {
                background: #f3f4f6;
            }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #ffb52e;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 12px;
            font-weight: 700;
        }

        .profile-info {
            line-height: 1.1;
            flex: 1;
        }

        .profile-name {
            display: block;
            color: #20252a;
            font-size: 11px;
            font-weight: 700;
        }

        .profile-email {
            display: block;
            color: #6b7280;
            font-size: 8px;
            margin-top: 2px;
        }

        .profile-arrow {
            color: #555;
            font-size: 11px;
            transition: .3s;
        }

        .profile-container.open .profile-arrow {
            transform: rotate(180deg);
        }

        /* =========================================================
                   PROFILE DROPDOWN
                ========================================================= */

        .profile-dropdown-custom {
            position: absolute;
            right: 0;
            top: 48px;
            width: 210px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 12px 30px rgba(0,0,0,.12);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: .25s ease;
            z-index: 1100;
        }

        .profile-container.open .profile-dropdown-custom {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-dropdown-custom a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 12px 15px;
            color: #374151;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
        }

            .profile-dropdown-custom a:hover {
                background: #fff1f2;
                color: #ed1c24;
            }

            .profile-dropdown-custom a i {
                font-size: 17px;
            }

        /* =========================================================
                   SIDEBAR
                ========================================================= */

        .sidebar-menu-wrapper {
            position: fixed;
            left: 0;
            top: 78px;
            bottom: 0;
            width: 175px;
            background: #222c33;
            padding: 22px 10px 18px;
            overflow-y: auto;
            overflow-x: hidden;
            z-index: 1020;
            transition: width .3s ease;
        }

        .sidebar-links {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .sidebar-links > li {
                margin-bottom: 5px;
            }

        .sidebar-link-item {
            width: 100%;
            min-height: 40px;
            padding: 10px 12px;
            display: flex;
            align-items: center;
            gap: 12px;
            border-radius: 7px;
            text-decoration: none;
            color: #ffffff;
            font-size: 13px;
            font-weight: 500;
            transition: all .2s ease;
            white-space: nowrap;
        }

            .sidebar-link-item i {
                width: 18px;
                min-width: 18px;
                text-align: center;
                font-size: 15px;
                color: #ffffff;
            }

            .sidebar-link-item:hover {
                background: #303b43;
                color: #ffffff;
            }

                .sidebar-link-item:hover i {
                    color: #ffffff;
                }

            /* Active */
            .sidebar-link-item.active {
                background: transparent;
                color: #ed1c24;
                font-weight: 600;
            }

                .sidebar-link-item.active i {
                    color: #ed1c24;
                }

        /* =========================================================
                   SETTINGS SIDEBAR
                ========================================================= */

        .sidebar-settings {
            list-style: none;
        }

        .settings-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0;
            border-radius: 7px;
        }

            .settings-toggle > a {
                flex: 1;
                color: #ffffff !important;
                padding: 10px 12px;
                font-size: 13px;
                font-weight: 500;
            }

                .settings-toggle > a i {
                    color: #ffffff;
                    font-size: 15px;
                }

            .settings-toggle:hover {
                background: #303b43;
            }

            .settings-toggle.active {
                background: transparent;
            }

                .settings-toggle.active > a {
                    color: #ed1c24 !important;
                    font-weight: 600;
                }

                    .settings-toggle.active > a i {
                        color: #ed1c24;
                    }

        .settings-arrow {
            color: #ffffff;
            font-size: 11px;
            margin-right: 12px;
            cursor: pointer;
            transition: transform .3s ease;
        }

        .sidebar-settings.open .settings-arrow {
            transform: rotate(90deg);
        }

        .settings-submenu {
            list-style: none;
            padding: 4px 0 2px 18px;
            margin: 0;
            display: none;
        }

        .sidebar-settings.open .settings-submenu {
            display: block;
        }

        .settings-submenu li {
            margin-bottom: 2px;
        }

        .settings-submenu a {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border-radius: 6px;
            color: #ffffff;
            text-decoration: none;
            font-size: 11px;
            font-weight: 500;
            transition: .2s ease;
        }

            .settings-submenu a i {
                color: #ffffff;
                font-size: 13px;
            }

            .settings-submenu a:hover {
                background: #303b43;
                color: #ffffff;
            }

            .settings-submenu a.active {
                background: transparent;
                color: #ed1c24;
                font-weight: 600;
            }

                .settings-submenu a.active i {
                    color: #ed1c24;
                }

        /* =========================================================
                   LOGOUT
                ========================================================= */

        .sidebar-logout {
            position: absolute;
            bottom: 18px;
            left: 10px;
            right: 10px;
        }

        .logout-link {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 12px;
            color: #ffffff;
            text-decoration: none;
            font-size: 12px;
            font-weight: 500;
            border-radius: 7px;
            transition: .2s ease;
        }

            .logout-link i {
                font-size: 16px;
            }

            .logout-link:hover {
                background: #303b43;
                color: #ffffff;
            }

        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .page-container {
            margin-left: 175px;
            padding: 105px 25px 40px;
            min-height: 100vh;
            transition: margin-left .3s ease;
        }

        .content-wrapper {
            max-width: 1150px;
            margin: 0 auto;
        }

        /* Header */
        .settings-breadcrumb {
            font-size: 10px;
            font-weight: 600;
            color: #64748b;
            margin-bottom: 4px;
        }

        .settings-header h1 {
            font-size: 24px;
            line-height: 1.2;
            color: #26323a;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .settings-header p {
            color: #64748b;
            font-size: 11px;
            margin-bottom: 25px;
        }

        /* =========================================================
                   SETTINGS GRID
                ========================================================= */

        .settings-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px;
        }

        .settings-card {
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 7px;
            padding: 17px 18px;
            min-height: 185px;
            box-shadow: 0 2px 8px rgba(0,0,0,.025);
        }

        .card-title {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #27323a;
            font-size: 13px;
            font-weight: 700;
            margin-bottom: 16px;
        }

            .card-title i {
                color: #27323a;
                font-size: 13px;
            }

        /* Fields */
        .field-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 14px;
        }

        .setting-field label {
            display: block;
            font-size: 10px;
            color: #475569;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .setting-field select {
            width: 100%;
            height: 34px;
            padding: 5px 10px;
            border: 1px solid #d7dce0;
            border-radius: 6px;
            background: #ffffff;
            color: #374151;
            font-size: 10px;
            outline: none;
            cursor: pointer;
        }

            .setting-field select:focus {
                border-color: #ed1c24;
                box-shadow: 0 0 0 2px rgba(237,28,36,.08);
            }

        /* =========================================================
                   ACCENT COLORS
                ========================================================= */

        .accent-label {
            display: block;
            font-size: 10px;
            color: #475569;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .accent-colors {
            display: flex;
            align-items: center;
            gap: 9px;
        }

        .accent-option {
            width: 21px;
            height: 21px;
            border-radius: 50%;
            border: 1px solid #9ca3af;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: .2s;
        }

            .accent-option.red {
                background: #ed1c24;
                border-color: #ed1c24;
            }

            .accent-option.black {
                background: #20272d;
                border-color: #20272d;
            }

            .accent-option.blue {
                background: #9aa9bd;
                border-color: #9aa9bd;
            }

            .accent-option.white {
                background: #ffffff;
            }

            .accent-option.active::after {
                content: "✓";
                color: #ffffff;
                font-size: 12px;
                font-weight: 700;
            }

            .accent-option.white.active::after {
                color: #333333;
            }

        /* =========================================================
                   NOTIFICATIONS
                ========================================================= */

        .notification-setting {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 12px;
        }

        .notification-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .notification-left i {
                font-size: 11px;
                color: #64748b;
            }

            .notification-left span {
                font-size: 10px;
                color: #475569;
                font-weight: 500;
            }

        /* Toggle */
        .custom-switch {
            position: relative;
            width: 33px;
            height: 18px;
        }

            .custom-switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .switch-slider {
            position: absolute;
            inset: 0;
            background: #d9dee2;
            border-radius: 20px;
            cursor: pointer;
            transition: .3s;
        }

            .switch-slider::before {
                content: "";
                position: absolute;
                width: 14px;
                height: 14px;
                left: 2px;
                top: 2px;
                background: #ffffff;
                border-radius: 50%;
                transition: .3s;
                box-shadow: 0 1px 2px rgba(0,0,0,.15);
            }

        .custom-switch input:checked + .switch-slider {
            background: #ed1c24;
        }

            .custom-switch input:checked + .switch-slider::before {
                transform: translateX(15px);
            }

        /* Reminder */
        .reminder-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-top: 5px;
            padding-left: 19px;
        }

        .reminder-label {
            color: #475569;
            font-size: 10px;
            font-weight: 500;
        }

        .reminder-select {
            height: 27px;
            min-width: 72px;
            border: 1px solid #e2e8f0;
            border-radius: 6px;
            padding: 3px 8px;
            font-size: 9px;
            color: #475569;
            background: #ffffff;
        }

        /* =========================================================
                   SAVE BUTTON
                ========================================================= */

        .save-container {
            margin-top: 25px;
        }

        .btn-save {
            border: none;
            background: #ed1c24;
            color: #ffffff;
            padding: 9px 18px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
            transition: .2s ease;
        }

            .btn-save:hover {
                background: #c9151c;
                box-shadow: 0 4px 10px rgba(237,28,36,.20);
                transform: translateY(-1px);
            }

        /* =========================================================
                   NOTIFICATION DROPDOWN
                ========================================================= */

        .notification-dropdown-custom {
            position: absolute;
            right: 0;
            top: 45px;
            width: 320px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
            box-shadow: 0 12px 30px rgba(0,0,0,.12);
            overflow: hidden;
            opacity: 0;
            visibility: hidden;
            transform: translateY(-8px);
            transition: .25s ease;
            z-index: 1100;
        }

        .notification-container.open .notification-dropdown-custom {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .notif-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 13px 15px;
            border-bottom: 1px solid #edf0f2;
        }

        .notif-header-title {
            font-size: 12px;
            font-weight: 700;
            color: #26323a;
        }

        .notif-mark-read {
            font-size: 9px;
            color: #ed1c24;
            text-decoration: none;
            font-weight: 600;
        }

        .notif-body {
            max-height: 260px;
            overflow-y: auto;
        }

        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 11px 15px;
            text-decoration: none;
            border-bottom: 1px solid #f1f5f9;
        }

            .notif-item:hover {
                background: #fff5f5;
            }

        .notif-icon-box {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .notif-icon-success {
            background: #dcfce7;
            color: #16a34a;
        }

        .notif-icon-warning {
            background: #fef3c7;
            color: #d97706;
        }

        .notif-text {
            font-size: 10px;
            color: #374151;
            line-height: 1.4;
        }

        .notif-time {
            font-size: 8px;
            color: #94a3b8;
            margin-top: 2px;
        }

        .notif-footer {
            text-align: center;
            padding: 10px;
            background: #fafafa;
        }

        .notif-footer-btn {
            color: #ed1c24;
            font-size: 10px;
            text-decoration: none;
            font-weight: 600;
        }

       

    </style>
</head>

<body>

    <!-- =========================================================
         TOP NAVBAR
    ========================================================== -->

    <nav class="navbar-custom">

        <!-- Logo -->
        <div class="navbar-left-box" id="navLeftBox">

            <a href="#" class="navbar-brand-custom">

                <img src="~/Images/logo.png"
                     alt="SORS Logo"
                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />

                <span class="brand-text">SORS</span>

            </a>

        </div>

        <!-- Toggle -->
        <div class="toggle-zone-box">

            <button class="sidebar-toggle-btn"
                    id="toggleSidebar"
                    title="Toggle Sidebar">

                <i class="bi bi-list"></i>

            </button>

        </div>

        <!-- Right Side -->
        <div class="navbar-profile">

            <!-- Notification -->
            <div class="notification-container">

                <button class="notification-btn"
                        id="notificationToggle"
                        title="Notifications">

                    <i class="bi bi-bell"></i>
                    <span class="notification-badge-dot"></span>

                </button>

                <!-- Notification Dropdown -->
                <div class="notification-dropdown-custom"
                     id="notificationMenu">

                    <div class="notif-header">

                        <span class="notif-header-title">
                            Notifications
                        </span>

                        <a href="#" class="notif-mark-read">
                            Mark all as read
                        </a>

                    </div>

                    <div class="notif-body">

                        <a href="#" class="notif-item">

                            <div class="notif-icon-box notif-icon-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>

                            <div>
                                <div class="notif-text">
                                    Your interview request
                                    <strong>#RI01</strong>
                                    was approved.
                                </div>

                                <div class="notif-time">
                                    10 mins ago
                                </div>
                            </div>

                        </a>

                        <a href="#" class="notif-item">

                            <div class="notif-icon-box notif-icon-warning">
                                <i class="bi bi-clock-history"></i>
                            </div>

                            <div>
                                <div class="notif-text">
                                    Reminder: Upload missing requirements for
                                    <strong>#RI02</strong>.
                                </div>

                                <div class="notif-time">
                                    2 hours ago
                                </div>
                            </div>

                        </a>

                    </div>

                    <div class="notif-footer">

                        <a href="#" class="notif-footer-btn">
                            View All Notifications
                        </a>

                    </div>

                </div>

            </div>

            <!-- Profile -->
            <div class="profile-container">

                <div class="profile-widget"
                     id="profileToggle">

                    <div class="profile-avatar">
                        JC
                    </div>

                    <div class="profile-info">

                        <span class="profile-name">
                            John Cruz
                        </span>

                        <span class="profile-email">
                            johncruz@gmail.com
                        </span>

                    </div>

                    <i class="bi bi-chevron-down profile-arrow"></i>

                </div>

                <!-- Profile Dropdown -->
                <div class="profile-dropdown-custom"
                     id="profileMenu">

                    <a href="@Url.Action("MyAccount", "Applicant")">

                        <i class="bi bi-person-circle"></i>

                        My Account

                    </a>

                    <a href="@Url.Action("ApplicantLogin", "Applicant")">

                        <i class="bi bi-box-arrow-right"></i>

                        Sign Out

                    </a>

                </div>

            </div>

        </div>

    </nav>


    <!-- =========================================================
         SIDEBAR
    ========================================================== -->

    <aside class="sidebar-menu-wrapper"
           id="sidebarMenu">

        <ul class="sidebar-links">

            <!-- Dashboard -->
            <li>

                <a href="@Url.Action("ApplicantDash", "Applicant")"
                   class="sidebar-link-item">

                    <i class="bi bi-house-door-fill"></i>

                    <span class="sidebar-link-text">
                        Dashboard
                    </span>

                </a>

            </li>


            <!-- Book Interview -->
            <li>

                <a href="@Url.Action("BookInterview", "Applicant")"
                   class="sidebar-link-item">

                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>

                    <span class="sidebar-link-text">
                        Book Interview
                    </span>

                </a>

            </li>


            <!-- My Appointment -->
            <li>

                <a href="@Url.Action("MyAppointment", "Applicant")"
                   class="sidebar-link-item">

                    <i class="bi bi-person-bounding-box"></i>

                    <span class="sidebar-link-text">
                        My Appointment
                    </span>

                </a>

            </li>


            <!-- Settings -->
            <li class="sidebar-settings open">

                <div class="settings-toggle active">

                    <a href="@Url.Action("Settings", "Applicant")"
                       class="d-flex align-items-center text-decoration-none">

                        <i class="bi bi-gear-fill"></i>

                        <span class="sidebar-link-text ms-2">
                            Settings
                        </span>

                    </a>

                    <i class="bi bi-chevron-right settings-arrow"
                       id="settingsToggle"></i>

                </div>


                <!-- Settings Submenu -->
                <ul class="settings-submenu"
                    id="settingsMenu">

                    <li>

                        <a href="@Url.Action("Settings", "Applicant")"
                           class="active">

                            <i class="bi bi-sliders"></i>

                            <span class="sidebar-link-text">
                                General Settings
