@{
    ViewBag.Title = "Settings";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Settings - SORS</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Google Fonts (Poppins) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background-color: #eaf6ed; /* Light mint background */
            min-height: 100vh;
            color: #334155;
            padding-top: 70px;
        }

        /* --- NAVBAR STYLING --- */
        .navbar-custom {
            background-color: #ffffff;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 0;
            z-index: 1030;
            height: 70px;
        }

        /* White Logo Brand Box Container */
        .navbar-left-box {
            display: flex;
            align-items: center;
            width: 260px;
            height: 100%;
            padding: 0 24px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            transition: width 0.3s ease, padding 0.3s ease;
        }

        /* Dedicated Light Green Toggle Zone Box */
        .toggle-zone-box {
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100%;
            width: 70px;
        }

        .sidebar-toggle-btn {
            background: none;
            border: none;
            color: #16a34a; /* Green hamburger menu icon */
            font-size: 24px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
        }

        .navbar-brand-custom {
            display: flex;
            align-items: center;
            text-decoration: none;
            gap: 10px;
        }

            .navbar-brand-custom img {
                width: 42px;
                height: 42px;
                object-fit: contain;
            }

        .brand-text {
            color: #0f6328;
            font-weight: 700;
            font-size: 18px;
            letter-spacing: 0.5px;
        }

        /* --- NAVBAR PROFILE AND UTILITY --- */
        .navbar-profile {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-left: auto;
        }

        .notification-btn {
            background: none;
            border: none;
            color: #64748b;
            font-size: 20px;
            position: relative;
            cursor: pointer;
        }

        .profile-widget {
            display: flex;
            align-items: center;
            gap: 10px;
            background: #f8fafc;
            padding: 6px 12px;
            border-radius: 30px;
            border: 1px solid #e2e8f0;
            cursor: pointer;
        }

        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background-color: #ffb74d;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 600;
            font-size: 13px;
        }

        .profile-info {
            text-align: left;
            line-height: 1.2;
        }

        .profile-name {
            font-size: 12px;
            font-weight: 600;
            color: #1e293b;
            display: block;
        }

        .profile-email {
            font-size: 10px;
            color: #64748b;
            display: block;
        }

        /*==============================
                            PROFILE DROPDOWN
                ==============================*/
        .profile-container {
            position: relative;
        }

        .profile-widget {
            cursor: pointer;
            user-select: none;
        }

        .profile-arrow {
            transition: .3s;
        }

        .profile-dropdown-custom {
            position: absolute;
            right: 0;
            top: 115%;
            width: 230px;
            background: #fff;
            border: 1px solid #e2e8f0;
            border-radius: 15px;
            box-shadow: 0 12px 30px rgba(0,0,0,.08);
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            visibility: hidden;
            transition: max-height .35s ease, opacity .25s ease, transform .25s ease;
            transform: translateY(-10px);
        }

            .profile-dropdown-custom a {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 14px 18px;
                text-decoration: none;
                color: #475569;
                font-weight: 500;
                transition: .25s;
            }

                .profile-dropdown-custom a:hover {
                    background: #f0fdf4;
                    color: #16a34a;
                }

                .profile-dropdown-custom a i {
                    font-size: 18px;
                }

        .profile-container.open .profile-dropdown-custom {
            max-height: 200px;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        .profile-container.open .profile-arrow {
            transform: rotate(180deg);
        }

        /* --- VERTICAL SIDEBAR MENU STYLING --- */
        .sidebar-menu-wrapper {
            position: fixed;
            top: 70px;
            left: 0;
            bottom: 0;
            width: 260px;
            background-color: #ffffff;
            border-right: 1px solid rgba(0, 0, 0, 0.05);
            padding: 24px 16px;
            overflow-y: auto;
            z-index: 1020;
            transition: width 0.3s ease, padding 0.3s ease;
        }

        .sidebar-links {
            display: flex;
            flex-direction: column;
            gap: 8px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .sidebar-link-item {
            text-decoration: none;
            color: #64748b;
            font-weight: 500;
            font-size: 15px;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            border-radius: 8px;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

            .sidebar-link-item i {
                font-size: 20px;
                min-width: 24px;
                display: inline-flex;
                justify-content: center;
            }

            .sidebar-link-item:hover {
                color: #16a34a;
                background-color: #f0fdf4;
            }

            .sidebar-link-item.active {
                color: #16a34a;
                background-color: #f0fdf4;
                font-weight: 600;
            }

        /* --- LAYOUT WORKSPACE CONTAINER --- */
        .page-container {
            margin-left: 260px;
            max-width: 1300px;
            padding: 40px 30px;
            transition: margin-left 0.3s ease;
        }

        /* --- SETTINGS CARD STYLING --- */
        .settings-card {
            background-color: #ffffff;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.02);
        }

        .form-label {
            font-weight: 600;
            font-size: 14px;
            color: #334155;
            margin-bottom: 8px;
        }

        .form-select, .form-control {
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            padding: 10px 14px;
            font-size: 14px;
            color: #334155;
        }

            .form-select:focus, .form-control:focus {
                border-color: #16a34a;
                box-shadow: 0 0 0 0.25rem rgba(22, 163, 74, 0.15);
            }

        .form-check-input:checked {
            background-color: #16a34a;
            border-color: #16a34a;
        }

        .btn-save {
            background-color: #16a34a;
            color: #ffffff;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 15px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

            .btn-save:hover {
                background-color: #15803d;
                box-shadow: 0 4px 12px rgba(22, 163, 74, 0.25);
            }

        /* --- SIDEBAR COLLAPSE STYLES --- */
        body.sidebar-collapsed .navbar-left-box {
            width: 76px;
            padding: 0;
            justify-content: center;
        }

        body.sidebar-collapsed .brand-text {
            display: none;
        }

        body.sidebar-collapsed .sidebar-menu-wrapper {
            width: 76px;
            padding: 24px 10px;
        }

        body.sidebar-collapsed .sidebar-link-text {
            display: none;
        }

        body.sidebar-collapsed .sidebar-link-item {
            justify-content: center;
            padding: 12px 0;
            gap: 0;
        }

        body.sidebar-collapsed .page-container {
            margin-left: 76px;
        }

        /* Responsive UI adjustments */
        @@media (max-width: 991px) {
            .toggle-zone-box

        {
            display: none !important;
        }

        .navbar-left-box {
            width: auto !important;
            padding: 0 15px !important;
            border-right: none !important;
        }

        .brand-text {
            display: inline !important;
        }

        .sidebar-menu-wrapper {
            position: static;
            width: 100% !important;
            height: auto;
            border-right: none;
            border-bottom: 1px solid rgba(0, 0, 0, 0.05);
            padding: 15px 20px !important;
        }

        .sidebar-links {
            flex-direction: row;
            flex-wrap: wrap;
            gap: 10px;
        }

        .sidebar-link-text {
            display: inline !important;
        }

        .sidebar-link-item {
            padding: 8px 14px !important;
            font-size: 14px;
            justify-content: flex-start !important;
            gap: 12px !important;
        }

        .page-container {
            margin-left: 0 !important;
            padding: 20px;
        }

        }

        /* SETTINGS SUBMENU */
        .sidebar-settings {
            list-style: none;
        }

        .settings-toggle {
            justify-content: space-between;
        }
            /* Parent active */
            .settings-toggle.active {
                background: #f0fdf4;
                color: #16a34a;
                font-weight: 600;
            }
        /* Child active */
        .settings-submenu a.active {
            background: #f0fdf4;
            color: #16a34a;
            font-weight: 600;
        }

        .settings-arrow {
            font-size: 14px;
            transition: .3s;
            color: #64748b;
        }

        .settings-submenu {
            list-style: none;
            padding-left: 18px;
            margin-top: 5px;
            display: none;
        }

            .settings-submenu li {
                margin: 5px 0;
            }

            .settings-submenu a {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                color: #64748b;
                padding: 10px 15px;
                border-radius: 8px;
                font-size: 14px;
                transition: .3s;
            }

                .settings-submenu a:hover {
                    background: #f0fdf4;
                    color: #16a34a;
                }

        .sidebar-settings.open .settings-submenu {
            display: block;
        }
        .sidebar-settings.open .settings-arrow {
            transform: rotate(90deg);
        }
        body.sidebar-collapsed .settings-submenu {
            display: none !important;
        }
        body.sidebar-collapsed .settings-arrow {
            display: none;
        }

        /* --- NOTIFICATION DROPDOWN MENU --- */
        .notification-dropdown-custom {
            position: absolute;
            right: 0;
            top: 115%;
            width: 340px;
            background: #ffffff;
            border: 1px solid #e2e8f0;
            border-radius: 16px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);
            overflow: hidden;
            max-height: 0;
            opacity: 0;
            visibility: hidden;
            transition: max-height 0.35s ease, opacity 0.25s ease, transform 0.25s ease;
            transform: translateY(-10px);
            z-index: 1050;
        }

        .notification-container.open .notification-dropdown-custom {
            max-height: 480px;
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* Header */
        .notif-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            border-bottom: 1px solid #f1f5f9;
            background-color: #ffffff;
        }

        .notif-header-title {
            font-size: 14px;
            font-weight: 700;
            color: #1e293b;
        }

        .notif-mark-read {
            font-size: 11px;
            color: #16a34a;
            font-weight: 600;
            text-decoration: none;
            transition: color 0.2s;
        }

            .notif-mark-read:hover {
                color: #15803d;
                text-decoration: underline;
            }

        /* List Body */
        .notif-body {
            max-height: 320px;
            overflow-y: auto;
        }

        .notif-item {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 12px 18px;
            text-decoration: none;
            border-bottom: 1px solid #f8fafc;
            transition: background-color 0.2s;
        }

            .notif-item:hover {
                background-color: #f0fdf4;
            }

            .notif-item.unread {
                background-color: #f7fee7;
            }

        .notif-icon-box {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            font-size: 15px;
        }

        .notif-icon-success {
            background-color: #dcfce7;
            color: #16a34a;
        }

        .notif-icon-warning {
            background-color: #fef3c7;
            color: #d97706;
        }

        .notif-content {
            flex: 1;
        }

        .notif-text {
            font-size: 12px;
            color: #334155;
            font-weight: 500;
            line-height: 1.4;
            margin-bottom: 2px;
        }

        .notif-time {
            font-size: 10px;
            color: #94a3b8;
        }

        /* Footer */
        .notif-footer {
            padding: 10px;
            text-align: center;
            background-color: #fafafa;
            border-top: 1px solid #f1f5f9;
        }

        .notif-footer-btn {
            font-size: 12px;
            font-weight: 600;
            color: #16a34a;
            text-decoration: none;
        }

            .notif-footer-btn:hover {
                text-decoration: underline;
            }

    </style>
</head>
<body>

    <!-- TOP NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-custom fixed-top d-flex flex-row align-items-center justify-content-start">

        <!-- Left Brand Logo Panel -->
        <div class="navbar-left-box" id="navLeftBox">
            <a class="navbar-brand-custom" href="#">
                <img src="~/Images/logo.png" alt="Logo" onerror="this.src='https://cdn-icons-png.flaticon.com/512/3061/3061341.png'" />
                <div class="brand-text" id="brandText">SORS</div>
            </a>
        </div>

        <!-- Menu Toggle Area Container -->
        <div class="toggle-zone-box">
            <button class="sidebar-toggle-btn" id="toggleSidebar" title="Toggle Menu">
                <i class="bi bi-list"></i>
            </button>
        </div>

        <!-- Right Profile/Notification Actions -->
        <div class="navbar-profile pe-4">

            <!-- NOTIFICATION CONTAINER -->
            <div class="notification-container">
                <button class="notification-btn" id="notificationToggle" title="Notifications">
                    <i class="bi bi-bell"></i>
                    <!-- Unread Badge Indicator -->
                    <span class="notification-badge-dot"></span>
                </button>

                <!-- DROPDOWN POPUP -->
                <div class="notification-dropdown-custom" id="notificationMenu">
                    <div class="notif-header">
                        <span class="notif-header-title">Notifications</span>
                        <a href="#" class="notif-mark-read">Mark all as read</a>
                    </div>

                    <div class="notif-body">
                        <!-- Approved Notification Item -->
                        <a href="#" class="notif-item unread">
                            <div class="notif-icon-box notif-icon-success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                            <div class="notif-content">
                                <div class="notif-text">Your interview request <strong>#RI01</strong> was approved.</div>
                                <div class="notif-time">10 mins ago</div>
                            </div>
                        </a>

                        <!-- Pending Notification Item -->
                        <a href="#" class="notif-item">
                            <div class="notif-icon-box notif-icon-warning">
                                <i class="bi bi-clock-history"></i>
                            </div>
                            <div class="notif-content">
                                <div class="notif-text">Reminder: Upload missing requirements for <strong>RI02</strong>.</div>
                                <div class="notif-time">2 hours ago</div>
                            </div>
                        </a>
                    </div>

                    <div class="notif-footer">
                        <a href="#" class="notif-footer-btn">View All Notifications</a>
                    </div>
                </div>
            </div>

            <div class="profile-container">
                <div class="profile-widget" id="profileToggle">
                    <div class="profile-avatar">
                        MG
                    </div>
                    <div class="profile-info">
                        <span class="profile-name">Mary Grace</span>
                        <span class="profile-email">smartoffice@gmail.com</span>
                    </div>
                    <i class="bi bi-chevron-down profile-arrow ms-2"></i>
                </div>

                <div class="profile-dropdown-custom" id="profileMenu">
                    <a href="@Url.Action("MyAccount", "Applicant")">
                        <i class="bi bi-person-circle"></i>
                        My Account
                    </a>
                    <a href="@Url.Action("ApplicantLogin", "Applicant")" class="text-danger">
                        <i class="bi bi-box-arrow-right"></i>
                        Sign Out
                    </a>
                </div>
            </div>
        </div>
    </nav>

    <!-- LEFT SIDEBAR NAV MENU -->
    <aside class="sidebar-menu-wrapper" id="sidebarMenu">
        <ul class="sidebar-links">
            <li>
                <a href="@Url.Action("ApplicantDash", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-house-door-fill"></i>
                    <span class="sidebar-link-text">Home</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("BookInterview", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-file-earmark-spreadsheet-fill"></i>
                    <span class="sidebar-link-text">Book Interview</span>
                </a>
            </li>
            <li>
                <a href="@Url.Action("MyAppointment", "Applicant")" class="sidebar-link-item">
                    <i class="bi bi-person-bounding-box"></i>
                    <span class="sidebar-link-text">My Appointment</span>
                </a>
            </li>

            <!-- Open by default on Settings page -->
            <li class="sidebar-settings">
                <div class="sidebar-link-item settings-toggle">

                    <a href="@Url.Action("Settings", "Applicant")"
                       class="d-flex align-items-center flex-grow-1 text-decoration-none text-reset">

                        <i class="bi bi-gear-fill"></i>
                        <span class="sidebar-link-text ms-2">
                            Settings & Account
                        </span>

                    </a>

                    <i class="bi bi-chevron-right settings-arrow"
                       id="settingsToggle"></i>

                </div>

                <ul class="settings-submenu" id="settingsMenu">
                    <li>
                        <a href="@Url.Action("Settings", "Applicant")" class="sidebar-link-item active">
                            <i class="bi bi-shield-lock"></i>
                            <span class="sidebar-link-text">Settings</span>
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("MyAccount", "Applicant")">
                            <i class="bi bi-person-circle"></i>
                            <span class="sidebar-link-text">My Account</span>
                        </a>
                    </li>
                </ul>
            </li>
        </ul>
    </aside>

    <!-- WORKSPACE MAIN CONTENT AREA -->
    <main class="page-container" id="mainContent">
        <div class="settings-card">
            <h4 class="mb-4 fw-bold">
                <i class="bi bi-sliders me-2 text-success"></i>
                General Settings
            </h4>



            <div class="row">
                <!-- Appearance -->
                <div class="col-md-6 mb-4">
                    <label class="form-label">Appearance</label>
                    <select class="form-select form-control">
                        <option>Light Mode</option>
                        <option>Dark Mode</option>
                        <option selected>System Default</option>
                    </select>
                </div>

                <!-- Font Size -->
                <div class="col-md-6 mb-4">
                    <label class="form-label">Font Size</label>
                    <select class="form-select form-control">
                        <option>Small</option>
                        <option selected>Medium</option>
                        <option>Large</option>
                    </select>
                </div>

                <!-- Font Style -->
                <div class="col-md-6 mb-4">
                    <label class="form-label">Font Style</label>
                    <select class="form-select form-control">
                        <option selected>Poppins</option>
                        <option>Arial</option>
                        <option>Roboto</option>
                        <option>Segoe UI</option>
                    </select>
                </div>

                <!-- Sidebar Style -->
                <div class="col-md-6 mb-4">
                    <label class="form-label">Sidebar Style</label>
                    <select class="form-select form-control">
                        <option selected>Expanded</option>
                        <option>Collapsed</option>
                        <option>Auto Hide</option>
                    </select>
                </div>

                <!-- Language -->
                <div class="col-md-6 mb-4">
                    <label class="form-label">Language</label>
                    <select class="form-select form-control">
                        <option selected>English</option>
                        <option>Filipino</option>
                    </select>
                </div>

                <!-- Date Format -->
                <div class="col-md-6 mb-4">
                    <label class="form-label">Date Format</label>
                    <select class="form-select form-control">
                        <option selected>MM/DD/YYYY</option>
                        <option>DD/MM/YYYY</option>
                        <option>YYYY-MM-DD</option>
                    </select>
                </div>

                <!-- Time Format -->
                <div class="col-md-6 mb-4">
                    <label class="form-label">Time Format</label>
                    <select class="form-select form-control">
                        <option selected>12-Hour (AM/PM)</option>
                        <option>24-Hour</option>
                    </select>
                </div>


                <!-- Sound -->
                <div class="col-md-6 mb-4">
                    <label class="form-label d-block">System Sound</label>
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" checked>
                        <label class="form-check-label">
                            Play Notification Sounds
                        </label>
                    </div>
                </div>

                <!-- Save -->
                <div class="col-12 mt-3">
                    <button class="btn-save">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        Save Settings
                    </button>
                </div>
            </div>
        </div>
    </main>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Toggle Script Logic -->
    <script>
        // Top menu toggle
        document.getElementById('toggleSidebar').addEventListener('click', function () {
            document.body.classList.toggle('sidebar-collapsed');
        });

        // Settings expand/collapse
                   const settingsToggle = document.getElementById("settingsToggle");
        const settingsParent = document.querySelector(".settings-toggle");
        const settingsGroup = document.querySelector(".sidebar-settings");
        const settingsLink = document.getElementById("settingsLink");

        // Open Settings menu
        settingsToggle.addEventListener("click", function (e) {

            e.preventDefault();
            e.stopPropagation();

            settingsGroup.classList.toggle("open");

            // Make Settings & Account active
            settingsParent.classList.add("active");
        });

        // Click Settings
        settingsLink.addEventListener("click", function () {

            // Parent remains active
            settingsParent.classList.add("active");

            // Child becomes active
            settingsLink.classList.add("active");

        });

        // Profile dropdown
        const profileContainer = document.querySelector(".profile-container");
        const profileToggle = document.getElementById("profileToggle");

        profileToggle.addEventListener("click", function (e) {
            e.stopPropagation();
            profileContainer.classList.toggle("open");
        });

        document.addEventListener("click", function (e) {
            if (!profileContainer.contains(e.target)) {
                profileContainer.classList.remove("open");
            }
        });

        // Notification dropdown toggle
         const notificationContainer = document.querySelector(".notification-container");
         const notificationToggle = document.getElementById("notificationToggle");

         notificationToggle.addEventListener("click", function (e) {
             e.stopPropagation();
             // Close profile menu if it's open
             profileContainer.classList.remove("open");
             // Toggle notification menu
             notificationContainer.classList.toggle("open");
         });

         // Close when clicking anywhere outside
         document.addEventListener("click", function (e) {
             if (!notificationContainer.contains(e.target)) {
                 notificationContainer.classList.remove("open");
             }
         });
    </script>
</body>
</html>