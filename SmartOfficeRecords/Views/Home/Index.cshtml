@{
    ViewBag.Title = "Landing Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart Office Records System</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Inter - SAME FONT AS DASHBOARD -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        /* =========================================================
                   COLOR PALETTE
                ========================================================= */

        :root {
            --black-gray: #202328;
            --dark-gray: #292d32;
            --gray: #343940;
            --medium-gray: #4a4f56;
            --white: #ffffff;
            --off-white: #f7f7f7;
            --text-dark: #17191c;
            --text-gray: #555b62;
            --red: #e5222a;
            --red-dark: #c91820;
            --red-soft: #fff0f1;
            --border: #dedfe1;
        }


        /* =========================================================
                   GLOBAL
                ========================================================= */

        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        body {
            background: var(--black-gray);
            color: var(--white);
        }


        /* =========================================================
                   MAIN
                ========================================================= */

        .landing-page {
            width: 100%;
            height: 100vh;
            overflow: hidden;
            background: radial-gradient( circle at 50% 30%, rgba(229, 34, 42, 0.08) 0%, rgba(229, 34, 42, 0.025) 28%, transparent 55% ), linear-gradient( 135deg, #202328 0%, #292d32 50%, #202328 100% );
        }


        /* =========================================================
                   HEADER
                ========================================================= */

        .top-header {
            width: 100%;
            height: 78px;
            display: flex;
            align-items: center;
            padding: 0 30px;
            background: #202328;
            border-bottom: 3px solid var(--red);
            box-shadow: 0 3px 12px rgba(0, 0, 0, 0.18);
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .brand-logo {
            width: 31px;
            height: 31px;
            object-fit: contain;
            display: block;
            flex-shrink: 0;
        }

        .brand-name {
            margin: 0;
            color: #ffffff;
            font-size: 21px;
            font-weight: 700;
            letter-spacing: 0.1px;
            line-height: 1.2;
        }


        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .main-content {
            width: 100%;
            height: calc(100vh - 78px);
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 43px 30px 30px;
            overflow: hidden;
        }


        /* =========================================================
                   INTRO
                ========================================================= */

        .intro-section {
            width: 100%;
            max-width: 850px;
            text-align: center;
            margin-bottom: 36px;
        }

        .section-label {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 11px;
            margin-bottom: 15px;
        }

            .section-label::before,
            .section-label::after {
                content: "";
                width: 34px;
                height: 1px;
                background: var(--red);
            }

            .section-label span {
                color: #ff4b52;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 0.4px;
            }

        .intro-title {
            margin: 0 0 7px;
            color: #ffffff;
            font-size: 22px;
            font-weight: 700;
            line-height: 1.35;
        }

        .intro-subtitle {
            margin: 0;
            color: #d0d3d6;
            font-size: 14px;
            font-weight: 400;
            line-height: 1.6;
        }


        /* =========================================================
                   LOGIN CONTAINER
                ========================================================= */

        .login-container {
            width: 100%;
            max-width: 930px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            align-items: stretch;
        }


        /* =========================================================
                   LOGIN CARD
                ========================================================= */

        .login-card {
            position: relative;
            width: 100%;
            height: 437px;
            background: #ffffff;
            border: 1px solid var(--border);
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.18), 0 12px 30px rgba(0, 0, 0, 0.12);
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }

            .login-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.22), 0 18px 35px rgba(0, 0, 0, 0.15);
            }


        /* =========================================================
                   CARD TOP ACCENT
                ========================================================= */

        .admin-card::before,
        .applicant-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            z-index: 2;
        }

        .admin-card::before {
            background: #343940;
        }

        .applicant-card::before {
            background: var(--red);
        }


        /* =========================================================
                   CARD CONTENT
                ========================================================= */

        .card-content {
            width: 100%;
            height: 100%;
            padding: 28px 27px 23px;
            display: flex;
            flex-direction: column;
        }


        /* =========================================================
                   CARD TOP
                ========================================================= */

        .card-top {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .card-category {
            color: #292d32;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.25px;
        }

        .access-badge {
            min-width: 84px;
            height: 22px;
            padding: 0 12px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #d6d8db;
            border-radius: 7px;
            background: #f7f7f7;
            color: #555b62;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
        }


        /* =========================================================
                   ICON CIRCLE
                ========================================================= */

        .card-icon {
            width: 48px;
            height: 48px;
            min-width: 48px;
            min-height: 48px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 14px;
            flex-shrink: 0;
            line-height: 1;
        }


        /* ADMIN ICON */

        .admin-card .card-icon {
            background: #343940;
            color: #ffffff;
        }


        /* APPLICANT ICON */

        .applicant-card .card-icon {
            background: var(--red-soft);
            color: var(--red);
        }


        /* ICON ITSELF */

        .card-icon i {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            font-size: 20px;
            line-height: 1;
        }


        /* =========================================================
                   CARD TITLE
                ========================================================= */

        .card-title {
            width: 100%;
            margin: 0 0 7px;
            color: var(--text-dark);
            font-size: 20px;
            font-weight: 700;
            line-height: 1.35;
            text-align: center;
        }


        /* =========================================================
                   DESCRIPTION
                ========================================================= */

        .card-description {
            margin: 0;
            max-width: 410px;
            color: #50565d;
            font-size: 13px;
            font-weight: 400;
            line-height: 1.65;
        }


        /* =========================================================
                   FEATURE LIST
                ========================================================= */

        .feature-list {
            list-style: none;
            padding: 0;
            margin: 21px 0 0;
        }

            .feature-list li {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 9px;
                color: #454b52;
                font-size: 13px;
                font-weight: 400;
                line-height: 1.5;
            }

                .feature-list li:last-child {
                    margin-bottom: 0;
                }

                .feature-list li i {
                    color: var(--red);
                    font-size: 13px;
                    font-weight: 700;
                    flex-shrink: 0;
                    width: 16px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }


        /* =========================================================
                   ACTION AREA
                ========================================================= */

        .card-action {
            margin-top: auto;
            padding-top: 20px;
        }

        .signing-label {
            display: block;
            margin-bottom: 8px;
            color: #3e4349;
            font-size: 12px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.2px;
        }


        /* =========================================================
                   ADMIN / STAFF SELECT
                ========================================================= */

        .role-select {
            width: 100%;
            height: 39px;
            padding: 0 35px 0 13px;
            border: 1px solid #d5d8db;
            border-radius: 6px;
            background-color: #f5f6f7;
            color: #25282c;
            font-size: 13px;
            font-weight: 400;
            outline: none;
            cursor: pointer;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .role-select:hover {
                border-color: #bfc3c7;
            }

            .role-select:focus {
                border-color: var(--red);
                box-shadow: 0 0 0 2px rgba(229, 34, 42, 0.10);
                outline: none;
            }

            .role-select option {
                background: #ffffff;
                color: #252525;
                font-size: 13px;
                font-family: 'Inter', sans-serif;
            }


        /* =========================================================
                   BUTTONS
                ========================================================= */

        .login-button {
            width: 100%;
            height: 40px;
            margin-top: 15px;
            border: none;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            font-size: 13px;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

            .login-button i {
                font-size: 14px;
            }


        /* =========================================================
                   ADMIN / STAFF BUTTON
                ========================================================= */

        .admin-button {
            background: #343940;
            color: #ffffff;
            border: 1px solid #343940;
        }

            .admin-button:hover {
                background: #292d32;
                color: #ffffff;
                box-shadow: 0 5px 12px rgba(0, 0, 0, 0.18);
            }


        /* =========================================================
                   APPLICANT BUTTON
                ========================================================= */

        .applicant-button {
            background: var(--red);
            color: #ffffff;
            border: 1px solid var(--red);
        }

            .applicant-button:hover {
                background: var(--red-dark);
                color: #ffffff;
                box-shadow: 0 5px 12px rgba(229, 34, 42, 0.20);
            }

        .button-arrow {
            font-size: 14px;
            margin-left: 1px;
        }


        /* =========================================================
                   RESPONSIVE - TABLET
                ========================================================= */

        @@media (max-width: 900px) {

            .top-header {
                height: 76px;
                padding: 0 24px;
            }

            .brand-logo {
                width: 29px;
                height: 29px;
            }

            .brand-name {
                font-size: 19px;
            }

            .main-content {
                height: calc(100vh - 76px);
                padding: 36px 24px 25px;
            }

            .intro-section {
                margin-bottom: 30px;
            }

            .intro-title {
                font-size: 20px;
            }

            .login-container {
                max-width: 760px;
                gap: 15px;
            }

            .login-card {
                height: 430px;
                border-radius: 15px;
            }
        }


        /* =========================================================
                   RESPONSIVE - MOBILE
                ========================================================= */

        @@media (max-width: 700px) {

            html,
            body {
                overflow-y: auto;
            }

            .landing-page {
                min-height: 100vh;
                height: auto;
                overflow: visible;
            }

            .top-header {
                height: auto;
                min-height: 75px;
                padding: 16px 20px;
            }

            .brand {
                gap: 10px;
            }

            .brand-logo {
                width: 30px;
                height: 30px;
            }

            .brand-name {
                font-size: 16px;
                line-height: 1.3;
            }

            .main-content {
                height: auto;
                padding: 38px 18px 35px;
            }

            .intro-section {
                margin-bottom: 30px;
            }

            .intro-title {
                font-size: 20px;
            }

            .intro-subtitle {
                font-size: 14px;
            }

            .login-container {
                grid-template-columns: 1fr;
                max-width: 450px;
            }

            .login-card {
                height: 425px;
                border-radius: 15px;
            }

            .card-title {
                font-size: 19px;
            }

            .card-description,
            .feature-list li {
                font-size: 13px;
            }
        }


        /* =========================================================
                   RESPONSIVE - SMALL MOBILE
                ========================================================= */

        @@media (max-width: 400px) {

            .brand-name {
                font-size: 14px;
            }

            .main-content {
                padding-left: 14px;
                padding-right: 14px;
            }

            .card-content {
                padding-left: 21px;
                padding-right: 21px;
            }

            .login-card {
                height: 425px;
                border-radius: 14px;
            }
        }

    </style>

</head>

<body>

    <div class="landing-page">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <header class="top-header">

            <div class="brand">

                <img src="~/Images/newlogo.png"
                     class="brand-logo"
                     alt="SORS Logo"
                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/3652/3652191.png';">

                <h1 class="brand-name">
                    SMART OFFICE RECORDS SYSTEM
                </h1>

            </div>

        </header>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="main-content">

            <!-- =================================================
                 INTRO
            ================================================== -->

            <section class="intro-section">

                <div class="section-label">
                    <span>GET STARTED</span>
                </div>

                <h2 class="intro-title">
                    Choose your login type
                </h2>

                <p class="intro-subtitle">
                    Select the portal that matches how you'll use the system.
                </p>

            </section>


            <!-- =================================================
                 LOGIN CARDS
            ================================================== -->

            <section class="login-container">


                <!-- =============================================
                     ADMIN / STAFF CARD
                ============================================== -->

                <div class="login-card admin-card">

                    <div class="card-content">

                        <div class="card-top">

                            <span class="card-category">
                                STAFF &amp; ADMIN
                            </span>

                            <span class="access-badge">
                                INTERNAL
                            </span>

                        </div>


                        <!-- ADMIN ICON CIRCLE -->

                        <div class="card-icon">

                            <i class="bi bi-file-earmark-text"></i>

                        </div>


                        <!-- TITLE -->

                        <h3 class="card-title">
                            Admin &amp; Staff
                        </h3>


                        <p class="card-description">
                            Open dashboard to manage users, records and system settings.
                        </p>


                        <ul class="feature-list">

                            <li>
                                <i class="bi bi-check-lg"></i>

                                <span>
                                    User and role management
                                </span>
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>

                                <span>
                                    Full records database access
                                </span>
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>

                                <span>
                                    Audit logs and reporting
                                </span>
                            </li>

                        </ul>


                        <div class="card-action">

                            <label for="loginRole"
                                   class="signing-label">
                                SIGNING IN AS
                            </label>


                            <!-- ADMIN / STAFF SELECT -->

                            <select id="loginRole"
                                    class="role-select">

                                <option value="admin" selected>
                                    Admin
                                </option>

                                <option value="staff">
                                    Staff
                                </option>

                            </select>


                            <!-- LOGIN BUTTON -->

                            <a href="@Url.Action("Login", "Admin")"
                               id="roleLoginButton"
                               class="login-button admin-button">

                                <span id="roleLoginText">
                                    Log in as Admin
                                </span>

                                <i class="bi bi-arrow-right button-arrow"></i>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     APPLICANT CARD
                ============================================== -->

                <div class="login-card applicant-card">

                    <div class="card-content">

                        <div class="card-top">

                            <span class="card-category">
                                APPLICANT
                            </span>

                            <span class="access-badge">
                                PUBLIC
                            </span>

                        </div>


                        <!-- APPLICANT ICON CIRCLE -->

                        <div class="card-icon">

                            <i class="bi bi-person"></i>

                        </div>


                        <!-- TITLE -->

                        <h3 class="card-title">
                            Applicant
                        </h3>


                        <p class="card-description">
                            Submit request, track their status and manage your own records.
                        </p>


                        <ul class="feature-list">

                            <li>
                                <i class="bi bi-check-lg"></i>

                                <span>
                                    Submit new document request
                                </span>
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>

                                <span>
                                    Track Application status
                                </span>
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>

                                <span>
                                    Download issued records
                                </span>
                            </li>

                        </ul>


                        <div class="card-action">

                            <a href="@Url.Action("ApplicantLand", "Applicant")"
                               class="login-button applicant-button">

                                <span>
                                    Continue as Applicant
                                </span>

                                <i class="bi bi-arrow-right button-arrow"></i>

                            </a>

                        </div>

                    </div>

                </div>


            </section>

        </main>

    </div>


    <!-- =========================================================
         ROLE SELECTION SCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const roleSelect =
                document.getElementById("loginRole");

            const roleLoginButton =
                document.getElementById("roleLoginButton");

            const roleLoginText =
                document.getElementById("roleLoginText");


            roleSelect.addEventListener("change", function () {

                if (this.value === "staff") {

                    roleLoginButton.href =
                        '@Url.Action("StaffLogin", "Staff")';

                    roleLoginText.textContent =
                        "Log in as Staff";

                }
                else {

                    roleLoginButton.href =
                        '@Url.Action("Login", "Admin")';

                    roleLoginText.textContent =
                        "Log in as Admin";

                }

            });

        });

    </script>

</body>
</html>