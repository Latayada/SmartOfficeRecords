@{
    ViewBag.Title = "Landing Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smart Office Records System</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Inter Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', sans-serif;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background: #ffffff;
            position: relative;
        }

            /* =========================
                   BACKGROUND
                ========================== */

            body::before {
                content: "";
                position: fixed;
                bottom: 0;
                left: 0;
                width: 50vw;
                height: 40vh;
                background: radial-gradient( circle at bottom left, rgba(35, 38, 45, 0.10) 0%, rgba(35, 38, 45, 0.03) 50%, transparent 70% );
                z-index: 0;
                pointer-events: none;
            }

            body::after {
                content: "";
                position: fixed;
                bottom: 0;
                right: 0;
                width: 50vw;
                height: 40vh;
                background: radial-gradient( circle at bottom right, rgba(229, 34, 42, 0.10) 0%, rgba(229, 34, 42, 0.03) 50%, transparent 70% );
                z-index: 0;
                pointer-events: none;
            }

        .bg-glow-top-left {
            position: fixed;
            top: 0;
            left: 0;
            width: 50vw;
            height: 45vh;
            background: radial-gradient( circle at top left, rgba(35, 38, 45, 0.04) 0%, transparent 60% );
            z-index: 0;
            pointer-events: none;
        }

        .bg-glow-top-right {
            position: fixed;
            top: 0;
            right: 0;
            width: 40vw;
            height: 40vh;
            background: radial-gradient( circle at top right, rgba(229, 34, 42, 0.04) 0%, transparent 60% );
            z-index: 0;
            pointer-events: none;
        }

        .center-gradient-circle {
            position: fixed;
            width: 500px;
            height: 500px;
            background: radial-gradient( circle, rgba(35, 38, 45, 0.05) 0%, rgba(229, 34, 42, 0.04) 45%, transparent 70% );
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 0;
            pointer-events: none;
            border-radius: 50%;
            filter: blur(20px);
        }

        /* =========================
                   MAIN WRAPPER
                ========================== */

        .landing-wrapper {
            width: 100%;
            height: 100vh;
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }

        /* =========================
                   HEADER
                ========================== */

        .top-header {
            height: 62px;
            min-height: 62px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 55px;
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid rgba(220, 220, 220, 0.7);
            flex-shrink: 0;
        }

        .logo-section {
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .logo-section img {
                width: 36px;
                height: 36px;
                object-fit: contain;
            }

            .logo-section h4 {
                color: #202328;
                font-size: 16px;
                font-weight: 700;
                margin: 0;
                letter-spacing: 0.3px;
            }

        .top-secure-badge {
            display: flex;
            align-items: center;
            gap: 9px;
            background: #f7f7f7;
            padding: 6px 14px;
            border-radius: 9px;
            border: 1px solid #e2e2e2;
        }

            .top-secure-badge i {
                color: #e5222a;
                font-size: 16px;
            }

            .top-secure-badge div {
                font-size: 10px;
                color: #555;
                line-height: 1.35;
            }

            .top-secure-badge strong {
                color: #202328;
                display: block;
                font-weight: 600;
            }

        /* =========================
                   CONTENT AREA
                ========================== */

        .content-area {
            flex: 1;
            min-height: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            padding: 14px 20px 18px;
            position: relative;
            overflow: hidden;
        }

        /* =========================
                   HEADER TEXT
                ========================== */

        .header-text {
            text-align: center;
            position: relative;
            z-index: 2;
            flex-shrink: 0;
        }

            .header-text p {
                font-size: 14px;
                color: #555;
                font-weight: 500;
                margin-bottom: 2px;
            }

            .header-text h1 {
                font-size: 34px;
                font-weight: 800;
                margin-bottom: 3px;
            }

                .header-text h1 span {
                    background: linear-gradient( to right, #202328 40%, #e5222a 100% );
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                }

            .header-text .sub-txt {
                font-size: 13px;
                color: #777;
                font-weight: 400;
            }

        /* =========================
                   CARDS CONTAINER
                ========================== */

        .cards-container {
            display: flex;
            justify-content: center;
            align-items: stretch;
            gap: 32px;
            width: 100%;
            position: relative;
            z-index: 5;
            flex-shrink: 1;
        }

        /* =========================
                   LOGIN CARD
                ========================== */

        .login-card {
            width: 450px;
            height: 455px;
            background: #ffffff;
            border: 1px solid #e5e7eb;
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.04);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

            .login-card:hover {
                transform: translateY(-5px);
            }

        .admin-card:hover {
            box-shadow: 0 20px 35px rgba(32, 35, 40, 0.16);
        }

        .applicant-card:hover {
            box-shadow: 0 20px 35px rgba(229, 34, 42, 0.16);
        }

        /* =========================
                   CARD ILLUSTRATION
                ========================== */

        .card-illustration-box {
            height: 145px;
            min-height: 145px;
            position: relative;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .admin-card .card-illustration-box {
            background: linear-gradient( 135deg, #16191f 0%, #3b4049 100% );
        }

        .applicant-card .card-illustration-box {
            background: linear-gradient( 135deg, #8f1118 0%, #e5222a 100% );
        }

        .mock-overlay-graphic {
            position: absolute;
            bottom: -20px;
            width: 110%;
            height: 55px;
            background: #ffffff;
            border-top-left-radius: 50% 40px;
            border-top-right-radius: 50% 40px;
        }

        .card-user-avatar {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            background: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            bottom: 9px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 3;
            box-shadow: 0 4px 10px rgba(0,0,0,0.08);
        }

        .admin-card .card-user-avatar i {
            color: #202328;
            font-size: 22px;
        }

        .applicant-card .card-user-avatar i {
            color: #e5222a;
            font-size: 22px;
        }

        .mock-laptop-vector {
            width: 130px;
            height: 76px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-radius: 8px;
            padding: 8px;
            display: flex;
            flex-direction: column;
            gap: 5px;
            margin-bottom: 20px;
        }

        .mock-screen-row {
            height: 5px;
            background: rgba(255, 255, 255, 0.4);
            border-radius: 3px;
        }

        /* =========================
                   CARD BODY
                ========================== */

        .card-body-custom {
            padding: 15px 28px 22px;
            text-align: left;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        /* CENTER ONLY THE TITLES */

        .admin-title,
        .applicant-title {
            color: #252525;
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 5px;
            text-align: center;
        }

        .card-body-custom p.desc {
            font-size: 12.5px;
            color: #555;
            line-height: 1.5;
            margin-bottom: 12px;
        }

        /* =========================
                   CARD FEATURE LIST
                ========================== */

        .card-feature-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .card-feature-list li {
                display: flex;
                align-items: center;
                gap: 9px;
                font-size: 12px;
                color: #555;
                margin-bottom: 6px;
            }

            .card-feature-list i {
                color: #202328;
                font-size: 13px;
            }

        .applicant-card .card-feature-list i {
            color: #e5222a;
        }

        /* =========================
                   LOGIN AREA
                ========================== */

        .login-area {
            margin-top: auto;
        }

        .applicant-card .login-area {
            padding-top: 50px;
        }

        .signing-label {
            display: block;
            font-size: 10px;
            font-weight: 600;
            color: #555;
            margin-bottom: 6px;
            text-transform: uppercase;
        }

        .login-select {
            width: 100%;
            height: 38px;
            border: 1px solid #d7d7d7;
            border-radius: 7px;
            padding: 0 12px;
            color: #444;
            font-size: 12px;
            background: #fafafa;
            outline: none;
        }

            .login-select:focus {
                border-color: #202328;
                box-shadow: 0 0 0 3px rgba(32, 35, 40, 0.07);
            }

        /* =========================
                   BUTTONS
                ========================== */

        .btn-admin,
        .btn-applicant {
            width: 100%;
            height: 44px;
            min-height: 44px;
            padding: 10px;
            border-radius: 7px;
            font-weight: 600;
            font-size: 13px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            transition: background 0.2s ease;
            margin-top: 10px;
        }

        .btn-admin {
            background: #202633;
            color: #ffffff;
            border: none;
        }

            .btn-admin:hover {
                background: #101319;
                color: #ffffff;
            }

        .btn-applicant {
            background: #e5222a;
            color: #ffffff;
            border: none;
            text-decoration: none;
        }

            .btn-applicant:hover {
                background: #c91820;
                color: #ffffff;
            }

        /* =========================
                   BOTTOM FEATURES
                ========================== */

        .bottom-features {
            background: #ffffff;
            border: 1px solid rgba(229, 231, 235, 0.8);
            border-radius: 16px;
            display: flex;
            justify-content: space-around;
            padding: 12px 15px;
            width: 100%;
            max-width: 1100px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
            position: relative;
            z-index: 5;
            flex-shrink: 0;
        }

        .feature-box {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 16px;
            flex: 1;
        }

            .feature-box:not(:last-child) {
                border-right: 1px solid #e5e7eb;
            }

        .feature-icon-wrapper {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 15px;
            flex-shrink: 0;
        }

        .f-blue,
        .f-orange {
            background: #f0f0f0;
            color: #202328;
        }

        .f-green,
        .f-purple {
            background: #fce8e9;
            color: #e5222a;
        }

        .feature-details h6 {
            margin: 0 0 2px 0;
            font-size: 12px;
            font-weight: 700;
            color: #202328;
        }

        .feature-details p {
            margin: 0;
            font-size: 10px;
            color: #777;
            line-height: 1.35;
        }

        /* =========================
                   RESPONSIVE
                ========================== */

        @@media (max-width: 1100px) {

            html,
            body {
                overflow-y: auto;
            }

            .landing-wrapper {
                height: auto;
                min-height: 100vh;
                overflow: visible;
            }

            .content-area {
                overflow: visible;
                gap: 20px;
            }

            .login-card {
                width: 420px;
            }

            .cards-container {
                gap: 20px;
            }
        }

        @@media (max-width: 900px) {

            .top-header {
                padding: 0 30px;
            }

            .cards-container {
                flex-direction: column;
                align-items: center;
            }

            .login-card {
                width: 100%;
                max-width: 450px;
            }

            .bottom-features {
                flex-direction: column;
                gap: 12px;
            }

            .feature-box:not(:last-child) {
                border-right: none;
                border-bottom: 1px solid #e5e7eb;
                padding-bottom: 10px;
            }
        }

        @@media (max-width: 600px) {

            .top-header {
                padding: 0 20px;
            }

            .top-secure-badge {
                display: none;
            }

            .logo-section h4 {
                font-size: 13px;
            }

            .header-text h1 {
                font-size: 30px;
            }

            .content-area {
                padding: 20px 15px 30px;
            }

            .card-body-custom {
                padding: 18px 20px;
            }

            .applicant-card .login-area {
                padding-top: 50px;
            }
        }

    </style>
</head>

<body>

    <div class="bg-glow-top-left"></div>
    <div class="bg-glow-top-right"></div>
    <div class="center-gradient-circle"></div>

    <div class="landing-wrapper">

        <!-- HEADER -->
        <div class="top-header">

            <div class="logo-section">

                <img src="~/Images/newlogo.png"
                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/3652/3652191.png'"
                     alt="Logo">

                <h4>SMART OFFICE RECORDS SYSTEM</h4>

            </div>

            <div class="top-secure-badge">

                <i class="bi bi-shield-check"></i>

                <div>
                    <strong>Secure. Reliable. Efficient.</strong>
                    Your records, our priority.
                </div>

            </div>

        </div>

        <!-- MAIN CONTENT -->
        <div class="content-area">

            <div class="header-text">

                <p>Welcome! 👋</p>

                <h1>
                    <span>Get Started</span>
                </h1>

                <p class="sub-txt">
                    Select the portal that matches how you'll use the system.
                </p>

            </div>

            <!-- LOGIN CARDS -->
            <div class="cards-container">

                <!-- ADMIN & STAFF CARD -->
                <div class="login-card admin-card">

                    <div class="card-illustration-box">

                        <div class="mock-laptop-vector">

                            <div class="mock-screen-row"
                                 style="width: 40%; background: #ffffff;">
                            </div>

                            <div class="mock-screen-row"
                                 style="width: 85%;">
                            </div>

                            <div class="mock-screen-row"
                                 style="width: 60%;">
                            </div>

                        </div>

                        <div class="mock-overlay-graphic"></div>

                        <div class="card-user-avatar">
                            <i class="bi bi-building"></i>
                        </div>

                    </div>

                    <div class="card-body-custom">

                        <h5 class="admin-title">
                            Admin & Staff
                        </h5>

                        <p class="desc">
                            Open dashboard to manage users, records and system settings.
                        </p>

                        <ul class="card-feature-list">

                            <li>
                                <i class="bi bi-check-lg"></i>
                                User and role management
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>
                                Full records database access
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>
                                Audit logs and reporting
                            </li>

                        </ul>

                        <!-- LOGIN AREA -->
                        <div class="login-area">

                            <label class="signing-label">
                                SIGNING IN AS
                            </label>

                            <select class="login-select" id="loginType">

                                <option value="admin" selected>
                                    Admin
                                </option>

                                <option value="staff">
                                    Staff
                                </option>

                            </select>

                            <button type="button"
                                    class="btn btn-admin"
                                    id="loginButton">

                                <span id="loginButtonText">
                                    Log in as Admin
                                </span>

                                <i class="bi bi-arrow-right"></i>

                            </button>

                        </div>

                    </div>

                </div>

                <!-- APPLICANT CARD -->
                <div class="login-card applicant-card">

                    <div class="card-illustration-box">

                        <div class="mock-laptop-vector"
                             style="align-items: center; justify-content: center;">

                            <i class="bi bi-file-person"
                               style="font-size: 32px; color: rgba(255,255,255,0.7);">
                            </i>

                        </div>

                        <div class="mock-overlay-graphic"></div>

                        <div class="card-user-avatar">
                            <i class="bi bi-person"></i>
                        </div>

                    </div>

                    <div class="card-body-custom">

                        <h5 class="applicant-title">
                            Applicant
                        </h5>

                        <p class="desc">
                            Submit request, track their status and manage your own records.
                        </p>

                        <ul class="card-feature-list">

                            <li>
                                <i class="bi bi-check-lg"></i>
                                Submit new document request
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>
                                Track Application Status
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>
                                Download issued records
                            </li>

                        </ul>

                        <!-- LOGIN AREA -->
                        <div class="login-area">

                            <a href="@Url.Action("ApplicantLand", "Applicant")"
                               class="btn btn-applicant">

                                Continue as Applicant

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

            <!-- BOTTOM FEATURES -->
            <div class="bottom-features">

                <div class="feature-box">

                    <div class="feature-icon-wrapper f-blue">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>

                    <div class="feature-details">
                        <h6>Secure Access</h6>
                        <p>Role-based authentication keeps data safe.</p>
                    </div>

                </div>

                <div class="feature-box">

                    <div class="feature-icon-wrapper f-green">
                        <i class="bi bi-arrow-repeat"></i>
                    </div>

                    <div class="feature-details">
                        <h6>Real-time Updates</h6>
                        <p>Get instant updates on your requests.</p>
                    </div>

                </div>

                <div class="feature-box">

                    <div class="feature-icon-wrapper f-orange">
                        <i class="bi bi-lightning-charge-fill"></i>
                    </div>

                    <div class="feature-details">
                        <h6>Efficient Workflow</h6>
                        <p>Streamlined processes for productivity.</p>
                    </div>

                </div>

                <div class="feature-box">

                    <div class="feature-icon-wrapper f-purple">
                        <i class="bi bi-heart-pulse-fill"></i>
                    </div>

                    <div class="feature-details">
                        <h6>Dedicated Support</h6>
                        <p>We're here to help you every step.</p>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>

        const loginType = document.getElementById("loginType");
        const loginButton = document.getElementById("loginButton");
        const loginButtonText = document.getElementById("loginButtonText");

        loginType.addEventListener("change", function () {

            if (this.value === "admin") {
                loginButtonText.textContent = "Log in as Admin";
            }
            else {
                loginButtonText.textContent = "Log in as Staff";
            }

        });

        loginButton.addEventListener("click", function () {

            if (loginType.value === "admin") {
                window.location.href = '@Url.Action("Login", "Admin")';
            }
            else {
                window.location.href = '@Url.Action("StaffLogin", "Staff")';
            }

        });

    </script>

</body>
</html>