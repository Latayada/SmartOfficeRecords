@{
    ViewBag.Title = "Landing Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart Office Records System</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            background: #ffffff;
            color: #111827;
        }

        body {
            overflow-x: hidden;
        }

        /* =========================================================
                   MAIN
                ========================================================= */

        .landing-page {
            width: 100%;
            min-height: 100vh;
            background: #ffffff;
        }


        /* =========================================================
                   HEADER
                ========================================================= */

        .top-header {
            width: 100%;
            height: 78px;
            display: flex;
            align-items: center;
            padding: 0 27px;
            background: #ffffff;
            border-bottom: 4px solid #ed2028;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .brand-logo {
            width: 29px;
            height: 29px;
            object-fit: contain;
            display: block;
        }

        .brand-name {
            margin: 0;
            color: #2864d7;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 0;
            line-height: 1;
        }


        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .main-content {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 56px 30px 50px;
        }


        /* =========================================================
                   INTRO
                ========================================================= */

        .intro-section {
            width: 100%;
            max-width: 850px;
            text-align: center;
            margin-bottom: 48px;
        }

        .section-label {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 17px;
        }

            .section-label::before,
            .section-label::after {
                content: "";
                width: 31px;
                height: 1px;
                background: #ef3340;
            }

            .section-label span {
                color: #e5222a;
                font-size: 12px;
                font-weight: 700;
                letter-spacing: 0.2px;
            }

        .intro-title {
            margin: 0 0 3px;
            color: #172033;
            font-size: 17px;
            font-weight: 700;
            line-height: 1.4;
        }

        .intro-subtitle {
            margin: 0;
            color: #929292;
            font-size: 14px;
            font-weight: 400;
            line-height: 1.6;
        }


        /* =========================================================
                   LOGIN CONTAINER
                ========================================================= */

        .login-container {
            width: 100%;
            max-width: 930px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            align-items: stretch;
        }


        /* =========================================================
                   LOGIN CARD
                ========================================================= */

        .login-card {
            position: relative;
            width: 100%;
            height: 437px;
            background: #ffffff;
            border: 1px solid #dedede;
            border-radius: 3px;
            overflow: hidden;
            box-shadow: 0 3px 5px rgba(0, 0, 0, 0.05), 0 8px 12px rgba(0, 0, 0, 0.025);
        }


        /* =========================================================
                   CARD TOP ACCENT
                ========================================================= */

        .admin-card::before,
        .applicant-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            z-index: 2;
        }

        .admin-card::before {
            background: #050505;
        }

        .applicant-card::before {
            background: #e5222a;
        }


        /* =========================================================
                   CARD CONTENT
                ========================================================= */

        .card-content {
            width: 100%;
            height: 100%;
            padding: 27px 26px 22px;
            display: flex;
            flex-direction: column;
        }


        /* =========================================================
                   CARD TOP
                ========================================================= */

        .card-top {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 19px;
        }

        .card-category {
            color: #202020;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.15px;
        }

        .access-badge {
            min-width: 82px;
            height: 20px;
            padding: 0 11px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border: 1px solid #dedede;
            border-radius: 7px;
            background: #ffffff;
            color: #4b4b4b;
            font-size: 9px;
            font-weight: 500;
            text-transform: uppercase;
        }


        /* =========================================================
                   ICON
                ========================================================= */

        .card-icon {
            width: 43px;
            height: 43px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
        }

        .admin-card .card-icon {
            background: #0b0b0b;
            color: #ffffff;
        }

        .applicant-card .card-icon {
            background: #fde0e2;
            color: #e5222a;
        }

        .card-icon i {
            font-size: 19px;
        }


        /* =========================================================
                   CARD TITLE
                ========================================================= */

        .card-title {
            margin: 0 0 5px;
            color: #171717;
            font-size: 17px;
            font-weight: 700;
            line-height: 1.4;
        }


        /* =========================================================
                   DESCRIPTION
                ========================================================= */

        .card-description {
            margin: 0;
            max-width: 410px;
            color: #222222;
            font-size: 12px;
            font-weight: 400;
            line-height: 1.6;
        }


        /* =========================================================
                   FEATURE LIST
                ========================================================= */

        .feature-list {
            list-style: none;
            padding: 0;
            margin: 20px 0 0;
        }

            .feature-list li {
                position: relative;
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 7px;
                color: #2b2b2b;
                font-size: 12px;
                font-weight: 400;
                line-height: 1.5;
            }

                .feature-list li:last-child {
                    margin-bottom: 0;
                }

                .feature-list li i {
                    color: #171717;
                    font-size: 11px;
                    font-weight: 700;
                    flex-shrink: 0;
                }


        /* =========================================================
                   ACTION AREA
                ========================================================= */

        .card-action {
            margin-top: auto;
            padding-top: 20px;
        }

        .signing-label {
            display: block;
            margin-bottom: 7px;
            color: #303030;
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
        }


        /* =========================================================
                   ADMIN SELECT
                ========================================================= */

        .admin-select {
            width: 100%;
            height: 37px;
            padding: 0 13px;
            border: 1px solid #dddddd;
            border-radius: 4px;
            background: #f9f9f9;
            color: #252525;
            font-size: 12px;
            font-weight: 400;
            outline: none;
        }

            .admin-select:focus {
                border-color: #aaaaaa;
                box-shadow: none;
            }


        /* =========================================================
                   DROPDOWN
                ========================================================= */

        .admin-dropdown {
            width: 100%;
        }

            .admin-dropdown .dropdown-toggle {
                width: 100%;
                height: 37px;
                padding: 0 13px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                border: 1px solid #dddddd;
                border-radius: 4px;
                background: #f9f9f9;
                color: #252525;
                font-size: 12px;
                font-weight: 400;
                text-align: left;
                box-shadow: none;
            }

                .admin-dropdown .dropdown-toggle::after {
                    margin-left: auto;
                }

                .admin-dropdown .dropdown-toggle:hover,
                .admin-dropdown .dropdown-toggle:focus,
                .admin-dropdown .dropdown-toggle:active {
                    background: #f9f9f9;
                    color: #252525;
                    border-color: #cccccc;
                    box-shadow: none;
                }

        .dropdown-menu {
            width: 100%;
            margin-top: 4px !important;
            padding: 4px;
            border: 1px solid #dedede;
            border-radius: 4px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            background: #ffffff;
        }

        .dropdown-item {
            padding: 8px 10px;
            border-radius: 3px;
            color: #303030;
            font-size: 11px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .dropdown-item:hover {
                background: #f5f5f5;
                color: #111111;
            }

            .dropdown-item i {
                font-size: 13px;
            }


        /* =========================================================
                   BUTTONS
                ========================================================= */

        .login-button {
            width: 100%;
            height: 36px;
            margin-top: 15px;
            border: none;
            border-radius: 2px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
        }

            .login-button i {
                font-size: 13px;
            }

        .admin-button {
            background: #101725;
            color: #ffffff;
        }

            .admin-button:hover {
                background: #060a12;
                color: #ffffff;
            }

        .applicant-button {
            background: #ed2028;
            color: #ffffff;
        }

            .applicant-button:hover {
                background: #d71921;
                color: #ffffff;
            }

        .button-arrow {
            font-size: 13px;
            margin-left: 1px;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 900px) {

            .top-header {
                height: 76px;
                padding: 0 24px;
            }

            .brand-logo {
                width: 29px;
                height: 29px;
            }

            .brand-name {
                font-size: 19px;
            }

            .main-content {
                padding: 48px 24px 45px;
            }

            .login-container {
                max-width: 760px;
                gap: 15px;
            }

            .login-card {
                height: 430px;
            }
        }


        @@media (max-width: 700px) {

            .top-header {
                height: auto;
                min-height: 75px;
                padding: 16px 20px;
            }

            .brand {
                gap: 10px;
            }

            .brand-logo {
                width: 30px;
                height: 30px;
            }

            .brand-name {
                font-size: 16px;
                line-height: 1.3;
            }

            .main-content {
                padding: 40px 18px 35px;
            }

            .intro-section {
                margin-bottom: 35px;
            }

            .intro-title {
                font-size: 17px;
            }

            .intro-subtitle {
                font-size: 13px;
            }

            .login-container {
                grid-template-columns: 1fr;
                max-width: 450px;
            }

            .login-card {
                height: 425px;
            }
        }


        @@media (max-width: 400px) {

            .brand-name {
                font-size: 14px;
            }

            .main-content {
                padding-left: 14px;
                padding-right: 14px;
            }

            .card-content {
                padding-left: 21px;
                padding-right: 21px;
            }

            .login-card {
                height: 425px;
            }
        }

    </style>

</head>

<body>

    <div class="landing-page">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <header class="top-header">

            <div class="brand">

                <img src="~/Images/logo.png"
                     class="brand-logo"
                     alt="SORS Logo"
                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/3652/3652191.png';">

                <h1 class="brand-name">
                    SMART OFFICE RECORDS SYSTEM
                </h1>

            </div>

        </header>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="main-content">

            <!-- =================================================
                 INTRO
            ================================================== -->

            <section class="intro-section">

                <div class="section-label">
                    <span>GET STARTED</span>
                </div>

                <h2 class="intro-title">
                    Choose your login type
                </h2>

                <p class="intro-subtitle">
                    Select the portal that matches how you'll use the system.
                </p>

            </section>


            <!-- =================================================
                 LOGIN CARDS
            ================================================== -->

            <section class="login-container">

                <!-- =============================================
                     ADMIN / STAFF CARD
                ============================================== -->

                <div class="login-card admin-card">

                    <div class="card-content">

                        <div class="card-top">

                            <span class="card-category">
                                STAFF &amp; ADMIN FILE
                            </span>

                            <span class="access-badge">
                                INTERNAL
                            </span>

                        </div>


                        <div class="card-icon">
                            <i class="bi bi-file-earmark-text"></i>
                        </div>


                        <h3 class="card-title">
                            Admin &amp; Staff
                        </h3>


                        <p class="card-description">
                            Open dashboard to manage users, records and system settings.
                        </p>


                        <ul class="feature-list">

                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>User and role management</span>
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>Full records database access</span>
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>Audit logs and reporting</span>
                            </li>

                        </ul>


                        <div class="card-action">

                            <label class="signing-label">
                                SIGNING IN AS
                            </label>

                            <div class="dropdown admin-dropdown">

                                <button class="dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span id="selectedLogin">
                                        Admin
                                    </span>

                                </button>

                                <ul class="dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           href="@Url.Action("Login", "Admin")">

                                            <i class="bi bi-shield-lock-fill"></i>

                                            Admin

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           href="@Url.Action("StaffLogin", "Staff")">

                                            <i class="bi bi-person-badge-fill"></i>

                                            Staff

                                        </a>
                                    </li>

                                </ul>

                            </div>


                            <a href="@Url.Action("Login", "Admin")"
                               id="adminLoginButton"
                               class="login-button admin-button">

                                <span>
                                    Log in as Admin
                                </span>

                                <i class="bi bi-arrow-right button-arrow"></i>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     APPLICANT CARD
                ============================================== -->

                <div class="login-card applicant-card">

                    <div class="card-content">

                        <div class="card-top">

                            <span class="card-category">
                                APPLICANT FILE
                            </span>

                            <span class="access-badge">
                                PUBLIC
                            </span>

                        </div>


                        <div class="card-icon">

                            <i class="bi bi-person"></i>

                        </div>


                        <h3 class="card-title">
                            Applicant
                        </h3>


                        <p class="card-description">
                            Submit request, track their status and manage your own records.
                        </p>


                        <ul class="feature-list">

                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>Submit new document request</span>
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>Track Application status</span>
                            </li>

                            <li>
                                <i class="bi bi-check-lg"></i>
                                <span>Download issued records</span>
                            </li>

                        </ul>


                        <div class="card-action">

                            <a href="@Url.Action("ApplicantLand", "Applicant")"
                               class="login-button applicant-button">

                                <span>
                                    Continue as Applicant
                                </span>

                                <i class="bi bi-arrow-right button-arrow"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </section>

        </main>

    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =========================================================
         LOGIN ROLE SCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const dropdownItems =
                document.querySelectorAll(".dropdown-item");

            const selectedLogin =
                document.getElementById("selectedLogin");

            const adminLoginButton =
                document.getElementById("adminLoginButton");


            dropdownItems.forEach(function (item) {

                item.addEventListener("click", function () {

                    const selectedText =
                        this.textContent.trim();

                    const isAdmin =
                        selectedText.toLowerCase().includes("admin");


                    if (selectedLogin) {

                        selectedLogin.textContent =
                            isAdmin ? "Admin" : "Staff";

                    }


                    if (adminLoginButton) {

                        if (isAdmin) {

                            adminLoginButton.href =
                                '@Url.Action("Login", "Admin")';

                            adminLoginButton.querySelector("span").textContent =
                                "Log in as Admin";

                        }
                        else {

                            adminLoginButton.href =
                                '@Url.Action("StaffLogin", "Staff")';

                            adminLoginButton.querySelector("span").textContent =
                                "Log in as Staff";

                        }

                    }

                });

            });

        });

    </script>

</body>
</html>