@{
    ViewBag.Title = "Landing Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Smart Office Records System</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Poppins -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>

        /* =========================================================
                   GLOBAL
                ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        html,
        body {
            width: 100%;
            min-height: 100%;
            margin: 0;
            padding: 0;
            background: #ffffff;
            color: #111827;
        }

        body {
            overflow-x: hidden;
        }


        /* =========================================================
                   MAIN WRAPPER
                ========================================================= */

        .landing-page {
            min-height: 100vh;
            background: #ffffff;
            display: flex;
            flex-direction: column;
        }


        /* =========================================================
                   TOP HEADER
                ========================================================= */

        .top-header {
            height: 82px;
            width: 100%;
            display: flex;
            align-items: center;
            padding: 0 34px;
            background: #ffffff;
            border-bottom: 4px solid #e5222a;
            flex-shrink: 0;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .brand-logo {
            width: 48px;
            height: 48px;
            object-fit: contain;
            display: block;
        }

        .brand-name {
            margin: 0;
            color: #2864d7;
            font-size: 23px;
            font-weight: 700;
            letter-spacing: 0.1px;
            line-height: 1;
        }


        /* =========================================================
                   MAIN CONTENT
                ========================================================= */

        .main-content {
            flex: 1;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 56px 30px 60px;
        }


        /* =========================================================
                   INTRO / HEADER
                ========================================================= */

        .intro-section {
            width: 100%;
            max-width: 850px;
            text-align: center;
            margin-bottom: 48px;
        }

        .section-label {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 17px;
        }

            .section-label::before,
            .section-label::after {
                content: "";
                width: 31px;
                height: 1px;
                background: #ef3340;
            }

            .section-label span {
                color: #e5222a;
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 0.3px;
            }

        .intro-title {
            margin: 0 0 4px;
            color: #172033;
            font-size: 21px;
            font-weight: 700;
            line-height: 1.35;
        }

        .intro-subtitle {
            margin: 0;
            color: #929292;
            font-size: 15px;
            font-weight: 400;
            line-height: 1.6;
        }


        /* =========================================================
                   LOGIN CARDS CONTAINER
                ========================================================= */

        .login-container {
            width: 100%;
            max-width: 930px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            align-items: stretch;
        }


        /* =========================================================
                   LOGIN CARD
                ========================================================= */

        .login-card {
            position: relative;
            background: #ffffff;
            border: 1px solid #dedede;
            border-radius: 3px;
            overflow: hidden;
            min-height: 365px;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05), 0 10px 20px rgba(0, 0, 0, 0.025);
            transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        }

            .login-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 7px 15px rgba(0, 0, 0, 0.08), 0 18px 30px rgba(0, 0, 0, 0.035);
            }


        /* =========================================================
                   CARD TOP ACCENT
                ========================================================= */

        .admin-card::before,
        .applicant-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            z-index: 2;
        }

        .admin-card::before {
            background: #050505;
        }

        .applicant-card::before {
            background: #e5222a;
        }


        /* =========================================================
                   CARD CONTENT
                ========================================================= */

        .card-content {
            height: 100%;
            min-height: 365px;
            padding: 30px 26px 20px;
            display: flex;
            flex-direction: column;
        }


        /* =========================================================
                   CARD TOP ROW
                ========================================================= */

        .card-top {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
        }

        .card-category {
            color: #202020;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.2px;
        }

        .access-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 83px;
            height: 24px;
            padding: 0 12px;
            border: 1px solid #e1e1e1;
            border-radius: 7px;
            color: #4b4b4b;
            background: #ffffff;
            font-size: 10px;
            font-weight: 500;
            text-transform: uppercase;
        }


        /* =========================================================
                   ICON
                ========================================================= */

        .card-icon {
            width: 44px;
            height: 44px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 13px;
        }

        .admin-card .card-icon {
            background: #0c0c0c;
            color: #ffffff;
        }

        .applicant-card .card-icon {
            background: #fde1e3;
            color: #e5222a;
        }

        .card-icon i {
            font-size: 20px;
        }


        /* =========================================================
                   CARD TITLE
                ========================================================= */

        .card-title {
            margin: 0 0 6px;
            color: #171717;
            font-size: 15px;
            font-weight: 600;
            line-height: 1.4;
        }


        /* =========================================================
                   CARD DESCRIPTION
                ========================================================= */

        .card-description {
            margin: 0;
            max-width: 410px;
            color: #222222;
            font-size: 13px;
            font-weight: 400;
            line-height: 1.65;
        }


        /* =========================================================
                   CARD FORM / ACTION AREA
                ========================================================= */

        .card-action {
            margin-top: auto;
            padding-top: 25px;
        }

        .signing-label {
            display: block;
            margin-bottom: 7px;
            color: #303030;
            font-size: 12px;
            font-weight: 500;
            text-transform: uppercase;
        }


        /* =========================================================
                   ADMIN DROPDOWN
                ========================================================= */

        .admin-select {
            width: 100%;
            height: 38px;
            padding: 0 13px;
            border: 1px solid #dddddd;
            border-radius: 4px;
            background-color: #f9f9f9;
            color: #252525;
            font-size: 13px;
            font-weight: 400;
            outline: none;
            cursor: pointer;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .admin-select:focus {
                border-color: #9d9d9d;
                box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.05);
            }


        /* =========================================================
                   BUTTONS
                ========================================================= */

        .login-button {
            width: 100%;
            height: 37px;
            margin-top: 25px;
            border: none;
            border-radius: 3px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
        }

            .login-button i {
                font-size: 14px;
            }

        .admin-button {
            background: #101725;
            color: #ffffff;
        }

            .admin-button:hover {
                background: #060a12;
                color: #ffffff;
                box-shadow: 0 4px 10px rgba(16, 23, 37, 0.18);
            }

        .applicant-button {
            background: #ed2028;
            color: #ffffff;
            text-decoration: none;
        }

            .applicant-button:hover {
                background: #d71921;
                color: #ffffff;
                box-shadow: 0 4px 10px rgba(237, 32, 40, 0.20);
            }

        .button-arrow {
            font-size: 14px;
            margin-left: 1px;
        }


        /* =========================================================
                   DROPDOWN
                ========================================================= */

        .dropdown-menu {
            width: 100%;
            margin-top: 5px !important;
            padding: 5px;
            border: 1px solid #dedede;
            border-radius: 5px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
            background: #ffffff;
        }

        .dropdown-item {
            padding: 9px 11px;
            border-radius: 3px;
            color: #303030;
            font-size: 12px;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
        }

            .dropdown-item:hover {
                background: #f5f5f5;
                color: #111111;
            }

            .dropdown-item i {
                font-size: 14px;
            }


        /* =========================================================
                   BOTTOM INFO
                ========================================================= */

        .bottom-info {
            width: 100%;
            max-width: 930px;
            margin-top: 25px;
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 0;
            color: #8b8b8b;
        }

        .info-item {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 0 22px;
            font-size: 11px;
            font-weight: 400;
        }

            .info-item:not(:last-child) {
                border-right: 1px solid #dedede;
            }

            .info-item i {
                color: #e5222a;
                font-size: 13px;
            }


        /* =========================================================
                   FOOTER
                ========================================================= */

        .page-footer {
            width: 100%;
            text-align: center;
            padding: 0 20px 20px;
            color: #a0a0a0;
            font-size: 10px;
            font-weight: 400;
        }


        /* =========================================================
                   RESPONSIVE
                ========================================================= */

        @@media (max-width: 900px) {

            .top-header {
                height: 76px;
                padding: 0 25px;
            }

            .brand-logo {
                width: 43px;
                height: 43px;
            }

            .brand-name {
                font-size: 19px;
            }

            .main-content {
                padding: 45px 25px 40px;
            }

            .login-container {
                max-width: 760px;
                gap: 15px;
            }
        }


        @@media (max-width: 700px) {

            .top-header {
                height: auto;
                min-height: 75px;
                padding: 16px 20px;
            }

            .brand {
                gap: 10px;
            }

            .brand-logo {
                width: 38px;
                height: 38px;
            }

            .brand-name {
                font-size: 16px;
                line-height: 1.3;
            }

            .main-content {
                padding: 38px 18px 35px;
            }

            .intro-section {
                margin-bottom: 35px;
            }

            .intro-title {
                font-size: 19px;
            }

            .intro-subtitle {
                font-size: 13px;
            }

            .login-container {
                grid-template-columns: 1fr;
                max-width: 450px;
            }

            .login-card,
            .card-content {
                min-height: 350px;
            }

            .bottom-info {
                flex-direction: column;
                gap: 10px;
                margin-top: 22px;
            }

            .info-item {
                padding: 0;
            }

                .info-item:not(:last-child) {
                    border-right: none;
                }

            .page-footer {
                padding-bottom: 15px;
            }
        }


        @@media (max-width: 400px) {

            .brand-name {
                font-size: 14px;
            }

            .main-content {
                padding-left: 14px;
                padding-right: 14px;
            }

            .card-content {
                padding-left: 21px;
                padding-right: 21px;
            }
        }

    </style>

</head>

<body>

    <div class="landing-page">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <header class="top-header">

            <div class="brand">

                <img src="~/Images/logo.png"
                     class="brand-logo"
                     alt="SORS Logo"
                     onerror="this.src='https://cdn-icons-png.flaticon.com/512/3652/3652191.png';">

                <h1 class="brand-name">
                    SMART OFFICE RECORDS SYSTEM
                </h1>

            </div>

        </header>


        <!-- =====================================================
             MAIN CONTENT
        ====================================================== -->

        <main class="main-content">


            <!-- =================================================
                 INTRO
            ================================================== -->

            <section class="intro-section">

                <div class="section-label">
                    <span>GET STARTED</span>
                </div>

                <h2 class="intro-title">
                    Choose your login type
                </h2>

                <p class="intro-subtitle">
                    Select the portal that matches how you'll use the system.
                </p>

            </section>


            <!-- =================================================
                 LOGIN CARDS
            ================================================== -->

            <section class="login-container">


                <!-- =============================================
                     ADMIN / STAFF CARD
                ============================================== -->

                <div class="login-card admin-card">

                    <div class="card-content">

                        <div class="card-top">

                            <span class="card-category">
                                Staff &amp; Admin File
                            </span>

                            <span class="access-badge">
                                Internal
                            </span>

                        </div>


                        <div class="card-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>


                        <h3 class="card-title">
                            Admin &amp; Staff
                        </h3>


                        <p class="card-description">
                            Open dashboard to manage users, records and system settings.
                        </p>


                        <div class="card-action">

                            <label class="signing-label">
                                Signing in as
                            </label>

                            <div class="dropdown">

                                <button class="login-button admin-button dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">

                                    <span id="selectedLogin">
                                        Admin
                                    </span>

                                </button>

                                <ul class="dropdown-menu">

                                    <li>
                                        <a class="dropdown-item"
                                           href="@Url.Action("Login", "Admin")">

                                            <i class="bi bi-shield-lock-fill"></i>

                                            Admin

                                        </a>
                                    </li>

                                    <li>
                                        <a class="dropdown-item"
                                           href="@Url.Action("StaffLogin", "Staff")">

                                            <i class="bi bi-person-badge-fill"></i>

                                            Staff

                                        </a>
                                    </li>

                                </ul>

                            </div>


                            <a href="@Url.Action("Login", "Admin")"
                               id="adminLoginButton"
                               class="login-button admin-button text-decoration-none">

                                <span>
                                    Log in as Admin
                                </span>

                                <i class="bi bi-arrow-right button-arrow"></i>

                            </a>

                        </div>

                    </div>

                </div>


                <!-- =============================================
                     APPLICANT CARD
                ============================================== -->

                <div class="login-card applicant-card">

                    <div class="card-content">

                        <div class="card-top">

                            <span class="card-category">
                                Applicant File
                            </span>

                            <span class="access-badge">
                                Public
                            </span>

                        </div>


                        <div class="card-icon">

                            <i class="bi bi-person"></i>

                        </div>


                        <h3 class="card-title">
                            Applicant
                        </h3>


                        <p class="card-description">
                            Submit request, track their status and manage your own records.
                        </p>


                        <div class="card-action">

                            <a href="@Url.Action("ApplicantLand", "Applicant")"
                               class="login-button applicant-button">

                                <span>
                                    Continue as Applicant
                                </span>

                                <i class="bi bi-arrow-right button-arrow"></i>

                            </a>

                        </div>

                    </div>

                </div>

            </section>


            <!-- =================================================
                 INFORMATION
            ================================================== -->

            <div class="bottom-info">

                <div class="info-item">

                    <i class="bi bi-shield-check"></i>

                    <span>
                        Secure Access
                    </span>

                </div>


                <div class="info-item">

                    <i class="bi bi-file-earmark-check"></i>

                    <span>
                        Centralized Records
                    </span>

                </div>


                <div class="info-item">

                    <i class="bi bi-clock-history"></i>

                    <span>
                        Efficient Workflow
                    </span>

                </div>


                <div class="info-item">

                    <i class="bi bi-graph-up-arrow"></i>

                    <span>
                        Reliable Management
                    </span>

                </div>

            </div>

        </main>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <footer class="page-footer">

            Smart Office Records System &nbsp;•&nbsp; Secure Records Management

        </footer>

    </div>


    <!-- Bootstrap JS -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =========================================================
         LOGIN ROLE SCRIPT
    ========================================================== -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const dropdownItems =
                document.querySelectorAll(".dropdown-item");

            const selectedLogin =
                document.getElementById("selectedLogin");

            const adminLoginButton =
                document.getElementById("adminLoginButton");


            dropdownItems.forEach(function (item) {

                item.addEventListener("click", function (event) {

                    const selectedText =
                        this.textContent.trim();

                    const isAdmin =
                        selectedText.toLowerCase().includes("admin");


                    if (selectedLogin) {

                        selectedLogin.textContent =
                            isAdmin ? "Admin" : "Staff";

                    }


                    if (adminLoginButton) {

                        if (isAdmin) {

                            adminLoginButton.href =
                                '@Url.Action("Login", "Admin")';

                            adminLoginButton.querySelector("span").textContent =
                                "Log in as Admin";

                        }
                        else {

                            adminLoginButton.href =
                                '@Url.Action("StaffLogin", "Staff")';

                            adminLoginButton.querySelector("span").textContent =
                                "Log in as Staff";

                        }

                    }

                });

            });

        });

    </script>

</body>
</html>